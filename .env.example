# ============================================
# TecnoDespegue — Environment Variables
# ============================================
# Copia este archivo a `.env` y completá los valores.
# En Vercel, las variables se configuran en:
# Dashboard → Project → Settings → Environment Variables
#
# IMPORTANTE: Las variables públicas (accesibles desde el cliente)
# deben tener el prefijo PUBLIC_.
# Las privadas solo se usan en el build.
# ============================================

# ============================================
# SITIO — Dominio y branding
# ============================================
# URL principal del sitio (sin trailing slash, con https://)
PUBLIC_SITE_URL=https://www.tecnodespegue.com

# Hostname para OG tags, sitemap, structured data
PUBLIC_SITE_HOSTNAME=www.tecnodespegue.com

# ============================================
# CONTACTO
# ============================================
PUBLIC_CONTACT_EMAIL=renekuhm2@gmail.com
PUBLIC_CONTACT_PHONE=+54-9-2334-409838

# Número de WhatsApp sin + ni espacios (formato internacional para wa.me)
# Ejemplo: 5491123456789
PUBLIC_WHATSAPP_NUMBER=5492334409838

# ============================================
# FORMSPREE — Formularios (contacto, newsletter, notify)
# ============================================
# Crear cuenta en https://formspree.io, obtener tu endpoint
# Formato: https://formspree.io/f/TU_ID_AQUI
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mojpnepv

# ============================================
# TIKTOK PIXEL — Tracking de conversiones
# ============================================
# Dejar PUBLIC_TIKTOK_PIXEL_ENABLED=false para deshabilitar
PUBLIC_TIKTOK_PIXEL_ENABLED=true
# Tu TikTok Pixel ID (lo encontrás en TikTok Ads Manager → Events → Web Events)
PUBLIC_TIKTOK_PIXEL_ID=D8AARK3C77U6KT5BPNHG

# ============================================
# PLAUSIBLE — Analytics privacy-friendly
# ============================================
# Plausible es opcional. Si no lo usás, set PUBLIC_PLAUSIBLE_ENABLED=false
# Crear cuenta en https://plausible.io (gratis para sites < 10k visitas/mes)
PUBLIC_PLAUSIBLE_ENABLED=true
PUBLIC_PLAUSIBLE_DOMAIN=www.tecnodespegue.com

# ============================================
# OG IMAGES DINÁMICAS (opcional, para mejorar CTR en redes)
# ============================================
# Si usás @vercel/og para OG images dinámicas, set esto
# La API route se monta en /api/og
PUBLIC_OG_API_ENABLED=false

# ============================================
# BUILD (Vercel)
# ============================================
# Habilitar build comments (útil para debuggear bundle size)
PUBLIC_SHOW_BUNDLE_STATS=false
