---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import CustomCursor from '../../components/CustomCursor.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';
import PageTransition from '../../components/PageTransition.astro';
import Hero from '../../components/Hero.astro';
import HeroMobile from '../../components/HeroMobile.astro';
import TrustSignals from '../../components/TrustSignals.astro';
import Services from '../../components/Services.astro';
import Portfolio from '../../components/Portfolio.astro';
import Refactor from '../../components/Refactor.astro';
import Why from '../../components/Why.astro';
import Tech from '../../components/Tech.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="TecnoDespegue | Fullstack Development & AI Automation"
  description="Custom software engineering, AI automation, and scalable solutions. We build high-performance web apps, cross-platform mobile apps, and intelligent workflows."
  path="/en/"
  locale="en"
>
  <LoadingScreen locale="en" />
  <PageTransition />
  <ProgressBar />
  <CustomCursor />
  <Nav locale="en" />

  <main id="contenido">
    <HeroMobile locale="en" />
    <div class="hero-desktop-wrap">
      <Hero locale="en" />
    </div>

    <TrustSignals locale="en" />
    <Services locale="en" />
    <Portfolio locale="en" />
    <Refactor locale="en" />
    <Why locale="en" />
    <Tech locale="en" />
    <CTA locale="en" />
  </main>

  <Footer locale="en" />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  .hero-desktop-wrap {
    display: none;
    background: radial-gradient(ellipse 90% 100% at 50% 50%, #0a0508 0%, #1a0a14 45%, #0a0508 100%);
  }
  @media (min-width: 768px) {
    .hero-desktop-wrap {
      display: block;
    }
  }
</style>
