---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import CustomCursor from '../../components/CustomCursor.astro';
import LoadingScreen from '../../components/LoadingScreen.astro';
import PageTransition from '../../components/PageTransition.astro';
import Hero from '../../components/Hero.astro';
import HeroMobile from '../../components/HeroMobile.astro';
import TrustSignals from '../../components/TrustSignals.astro';
import Services from '../../components/Services.astro';
import Portfolio from '../../components/Portfolio.astro';
import Refactor from '../../components/Refactor.astro';
import Why from '../../components/Why.astro';
import Tech from '../../components/Tech.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';
import CompileReveal from '../../components/CompileReveal.astro';
---

<Layout
  title="TecnoDespegue | Fullstack Development & AI Automation"
  description="Custom software engineering, AI automation, and scalable solutions. We build high-performance web apps, cross-platform mobile apps, and intelligent workflows."
  path="/"
  locale="en"
>
  <LoadingScreen locale="en" />
  <PageTransition />
  <ProgressBar />
  <CustomCursor />
  <Nav locale="en" />

  <main id="contenido">
    <HeroMobile locale="en" />
    <div class="hero-desktop-wrap">
      <Hero locale="en" />
    </div>

    <ScrollReveal>
      <TrustSignals locale="en" />
    </ScrollReveal>

    <CompileReveal sectionName="Services" importPath="@components/Services.astro" locale="en">
      <Services locale="en" />
    </CompileReveal>

    <CompileReveal sectionName="Portfolio" importPath="@components/Portfolio.astro" locale="en">
      <Portfolio locale="en" />
    </CompileReveal>

    <CompileReveal sectionName="Optimization" importPath="@components/Refactor.astro" locale="en">
      <Refactor locale="en" />
    </CompileReveal>

    <CompileReveal sectionName="Process" importPath="@components/Why.astro" locale="en">
      <Why locale="en" />
    </CompileReveal>

    <CompileReveal sectionName="Technologies" importPath="@components/Tech.astro" locale="en">
      <Tech locale="en" />
    </CompileReveal>

    <CompileReveal sectionName="Contact" importPath="@components/CTA.astro" locale="en">
      <CTA locale="en" />
    </CompileReveal>
  </main>

  <Footer locale="en" />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  .hero-desktop-wrap {
    display: none;
  }
  @media (min-width: 768px) {
    .hero-desktop-wrap {
      display: block;
    }
  }
</style>
