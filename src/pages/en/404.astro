---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, localizedPath, type Locale } from '../../i18n';

const locale: Locale = 'en';
const t = useTranslations(locale);
---

<Layout
  title="404 — Page Not Found | TecnoDespegue"
  description="The page you're looking for doesn't exist or was moved. Head back to TecnoDespegue's homepage or reach out."
  noindex={true}
  path="/en/404"
  locale={locale}
>
  <Nav locale={locale} />

  <main id="contenido" class="error-page" data-error>
    <div class="error-bg" aria-hidden="true">
      <div class="error-grid"></div>
      <div class="error-glow error-glow-1"></div>
      <div class="error-glow error-glow-2"></div>
    </div>

    <div class="error-content">
      <div class="error-badge">
        <span class="error-badge-dot"></span>
        <span class="font-mono">Error 404 · Lost Path</span>
      </div>

      <div class="error-404-wrap">
        <h1 class="error-404 font-display text-shine">404</h1>
        <div class="error-burst" aria-hidden="true">
          <span class="onomatopeya error-burst-text">OOPS!</span>
          <div class="error-burst-stars">★ ★ ★</div>
        </div>
      </div>

      <h2 class="error-headline font-display">
        <span class="error-headline-line">This page</span>
        <span class="error-headline-line">
          <span class="error-underline-wrap">
            <span>{t.notFound.titleHighlight}</span>
            <span class="error-underline-bar" aria-hidden="true"></span>
          </span>
        </span>
        <span class="error-headline-line">without notice.</span>
      </h2>

      <p class="error-lead">
        {t.notFound.desc}
      </p>

      <div class="error-ctas">
        <a href="/en" class="btn-primary magnetic" data-magnetic>
          <Icon name="arrow_forward" class="w-4 h-4" />
          <span>{t.notFound.ctaHome}</span>
        </a>
        <a
          href="https://wa.me/5492334409838?text=Hi,%20I%20hit%20a%20404%20on%20www.tecnodespegue.com%20and%20want%20to%20inquire"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary magnetic"
          data-magnetic
        >
          <Icon name="chat" class="w-4 h-4" />
          <span>{t.notFound.ctaWhatsapp}</span>
        </a>
      </div>

      <div class="error-quick">
        <p class="error-quick-label font-mono">OR EXPLORE THESE SECTIONS</p>
        <div class="error-quick-chips">
          <a href={localizedPath('/#soluciones', locale)} class="tech-badge">{t.nav.solutions}</a>
          <a href={localizedPath('/#portfolio', locale)} class="tech-badge">{t.nav.portfolio}</a>
          <a href={localizedPath('/#stack', locale)} class="tech-badge">{t.nav.stack}</a>
          <a href={localizedPath('/#proceso', locale)} class="tech-badge">{t.nav.process}</a>
          <a href={localizedPath('/#contacto', locale)} class="tech-badge">{t.nav.contact}</a>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</Layout>

<style>
  .error-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 1.5rem 4rem;
    overflow: hidden;
  }

  .error-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .error-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(237, 29, 36, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(237, 29, 36, 0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
  }
  .error-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
  }
  .error-glow-1 {
    width: 500px;
    height: 500px;
    background: var(--color-marvel-red);
    top: 20%;
    left: 10%;
  }
  .error-glow-2 {
    width: 400px;
    height: 400px;
    background: var(--color-marvel-gold);
    bottom: 20%;
    right: 10%;
    opacity: 0.25;
  }

  .error-content {
    position: relative;
    z-index: 2;
    max-width: 56rem;
    text-align: center;
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--color-surface-1);
    border: 1px solid rgba(237, 29, 36, 0.3);
    border-radius: 999px;
    color: var(--color-marvel-gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }
  .error-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-red);
    box-shadow: 0 0 12px var(--color-marvel-red-glow);
    animation: energy-pulse 1.4s ease-in-out infinite;
  }

  .error-404-wrap {
    position: relative;
    margin: 0 auto 2rem;
    display: inline-block;
  }

  .error-404 {
    font-weight: 900;
    font-size: clamp(8rem, 22vw, 16rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    margin: 0;
    text-shadow:
      0 4px 0 rgba(0, 0, 0, 0.4),
      0 0 60px rgba(237, 29, 36, 0.4);
  }

  .error-burst {
    position: absolute;
    top: 0.5em;
    right: -1em;
    transform: rotate(15deg);
    pointer-events: none;
  }
  .error-burst-text {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.85;
  }
  .error-burst-stars {
    color: var(--color-marvel-gold);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-align: center;
    text-shadow: 0 0 8px rgba(248, 180, 0, 0.6);
  }

  .error-headline {
    font-weight: 900;
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }
  .error-headline-line { display: block; }

  .error-underline-wrap { position: relative; display: inline-block; }
  .error-underline-bar {
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    bottom: 0.05em;
    height: 0.15em;
    background: linear-gradient(90deg, var(--color-marvel-red) 0%, var(--color-marvel-gold) 100%);
    box-shadow: 0 0 24px rgba(237, 29, 36, 0.4);
  }

  .error-lead {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    max-width: 36rem;
    margin: 0 auto 2.5rem;
  }

  .error-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .error-quick {
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .error-quick-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--color-on-surface-variant);
    margin: 0 0 1rem;
  }
  .error-quick-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
</style>