---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import BlogHero from '../../../components/BlogHero.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import Footer from '../../../components/Footer.astro';
import { getCategories, getTopTags } from '../../../utils/blog.ts';
import type { Locale } from '../../../i18n';

const locale: Locale = 'en';
const allPosts = await getCollection('posts', ({ data }) => data.locale === locale);
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = getCategories(posts);
const topTags = getTopTags(posts, 12);
const latestPublication = posts[0]?.data.date;

const title = 'Engineering Blog | Fullstack, AI & Architecture | TecnoDespegue';
const description = 'Articles on fullstack development, AI automation, software architecture, and tech strategy for startups. Real production experience, no fluff.';
---

<Layout title={title} description={description} path="/en/blog" locale={locale} alternatePaths={{ es: '/blog', en: '/en/blog' }}>
  <Nav locale={locale} />
  <BlogHero
    featuredCount={posts.length}
    postCount={posts.length}
    categoryCount={categories.length}
    locale={locale}
    latestPublication={latestPublication}
  />
  <BlogIndex posts={posts} categories={categories} topTags={topTags} locale={locale} />
  <Footer locale={locale} />
</Layout>
