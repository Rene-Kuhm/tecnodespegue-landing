---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import BlogHero from '../../../components/BlogHero.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/Newsletter.astro';
import { formatDate, calculateReadTime, getCategories, getTopTags } from '../../../utils/blog.ts';
import { useTranslations, localizedPath, localeConfig, type Locale } from '../../../i18n';

const locale: Locale = 'en';
const t = useTranslations(locale);
const cfg = localeConfig[locale];

const allPosts = await getCollection('posts', ({ data }) => data.locale === locale);
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = getCategories(posts);
const topTags = getTopTags(posts, 12);

const title = 'Engineering Blog — TecnoDespegue';
const description = 'Articles on fullstack development, AI automation, software architecture, and tech strategy. No fluff — just real production experience.';
---

<Layout title={title} description={description} path="/en/blog" locale={locale}>
  <Nav locale={locale} />

  <BlogHero
    featuredCount={posts.length}
    postCount={posts.length}
    categoryCount={categories.length}
    locale={locale}
  />

  <main id="contenido" class="blog-main min-h-screen">
    <div class="blog-layout">

    <!-- Toolbar: search + filters -->
    <aside class="blog-toolbar" data-toolbar>
      <div class="search-wrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          id="blog-search"
          class="search-input font-mono"
          placeholder="Search the blog..."
          aria-label="Search articles"
        />
        <span class="search-count font-mono" data-search-count>{posts.length} articles</span>
      </div>

      <div class="filter-row">
        <button class="filter-btn filter-btn-active font-mono" data-filter-cat="all">
          All
          <span class="filter-count">{posts.length}</span>
        </button>
        {categories.map(cat => {
          const count = posts.filter(p => p.data.category === cat).length;
          return (
            <button class="filter-btn font-mono" data-filter-cat={cat}>
              {cat}
              <span class="filter-count">{count}</span>
            </button>
          );
        })}
      </div>

      {topTags.length > 0 && (
        <div class="tag-row">
          <span class="tag-label font-mono">Tags:</span>
          {topTags.map(tag => (
            <button class="tag-chip font-mono" data-filter-tag={tag}>#{tag}</button>
          ))}
        </div>
      )}
    </section>

    </aside>

    <!-- Posts grid -->
    <section class="blog-grid" data-blog-grid>
      {posts.length === 0 && (
        <div class="empty-state">
          <p class="empty-text">No articles published yet.</p>
        </div>
      )}

      {posts.map((post, idx) => {
        const date = formatDate(post.data.date, cfg.dateLocale);
        const readTime = post.data.readTime ?? calculateReadTime(post.body, 200);
        const isFirst = idx === 0;
        return (
          <article
            class={`blog-card ${isFirst ? 'blog-card-lg' : ''}`}
            data-blog-card
            data-categories={JSON.stringify([post.data.category])}
            data-tags={JSON.stringify(post.data.tags || [])}
            data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
            data-card-idx={idx}
          >
            <a href={localizedPath(`/blog/${post.id.replace(/^en\//, '')}/`, locale)} class="blog-link">
              <div class="blog-link-inner">
                <div class="blog-meta font-mono">
                  <time datetime={post.data.date.toISOString()}>{date}</time>
                  <span class="blog-meta-sep">·</span>
                  <span>{readTime} min</span>
                  <span class="blog-meta-sep">·</span>
                  <span class="blog-meta-cat">{post.data.category}</span>
                </div>

                <h2 class="blog-title font-display">
                  {post.data.title}
                </h2>

                <p class="blog-desc">{post.data.description}</p>

                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="blog-tags">
                    {post.data.tags.slice(0, 4).map(tag => (
                      <span class="blog-tag font-mono">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>

              <div class="blog-corner blog-corner-tl" aria-hidden="true"></div>
              <div class="blog-corner blog-corner-tr" aria-hidden="true"></div>
              <div class="blog-corner blog-corner-bl" aria-hidden="true"></div>
              <div class="blog-corner blog-corner-br" aria-hidden="true"></div>
            </a>
          </article>
        );
      })}

      <div class="no-results" data-no-results>
        <p class="no-results-text">No articles found with those filters.</p>
        <button class="no-results-btn" data-clear-filters>Clear filters</button>
      </div>
    </section>

    </div><!-- /blog-layout -->

    <Newsletter locale={locale} />
  </main>

  <Footer locale={locale} />
</Layout>

<style>
  .blog-main {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }

  @media (min-width: 768px) {
    .blog-main { padding: 0 2rem 6rem; }
  }

  .blog-toolbar {
    margin-bottom: 3rem;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  .search-input {
    flex: 1;
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.625rem;
    color: #FFFFFF;
    font-size: 0.875rem;
    transition: border-color 0.2s, background 0.2s;
  }

  .search-input::placeholder { color: rgba(255, 255, 255, 0.3); }
  .search-input:focus { outline: none; border-color: rgba(248, 180, 0, 0.4); background: rgba(0, 0, 0, 0.7); }

  .search-count {
    position: absolute;
    right: 1rem;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  .filter-row, .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  @media (min-width: 768px) {
    .filter-row, .tag-row { gap: 0.5rem; margin-bottom: 0.75rem; }
  }

  .tag-row { margin-bottom: 0; }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }
  @media (min-width: 768px) {
    .filter-btn { padding: 0.5rem 0.875rem; font-size: 0.7rem; gap: 0.4rem; }
  }

  .filter-btn:hover { background: rgba(255, 255, 255, 0.08); color: #FFFFFF; border-color: rgba(255, 255, 255, 0.15); }
  .filter-btn-active { background: rgba(237, 29, 36, 0.15); border-color: rgba(237, 29, 36, 0.4); color: #FFFFFF; }
  .filter-count { font-size: 0.6rem; color: rgba(255, 255, 255, 0.4); font-weight: 400; }
  .filter-btn-active .filter-count { color: rgba(255, 255, 255, 0.6); }

  .tag-label { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em; color: rgba(255, 255, 255, 0.4); text-transform: uppercase; margin-right: 0.25rem; align-self: center; }
  @media (min-width: 768px) { .tag-label { font-size: 0.65rem; } }

  .tag-chip {
    padding: 0.3rem 0.6rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.65rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  @media (min-width: 768px) {
    .tag-chip { padding: 0.375rem 0.75rem; font-size: 0.7rem; }
  }

  .tag-chip:hover { background: rgba(248, 180, 0, 0.1); border-color: rgba(248, 180, 0, 0.3); color: var(--color-marvel-gold); }
  .tag-chip-active { background: rgba(248, 180, 0, 0.15); border-color: rgba(248, 180, 0, 0.4); color: var(--color-marvel-gold); }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  }

  .blog-card {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.875rem;
    overflow: hidden;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s, opacity 0.3s;
    opacity: 0;
    transform: translateY(30px);
  }

  .blog-card.is-shown { opacity: 1; transform: translateY(0); }
  .blog-card:hover { transform: translateY(-4px); border-color: rgba(237, 29, 36, 0.3); box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(237, 29, 36, 0.1); }
  .blog-card.is-hidden { display: none; }

  @media (min-width: 768px) {
    .blog-card-lg { grid-column: span 2; }
  }

  .blog-link { display: block; position: relative; text-decoration: none; color: inherit; }
  .blog-link-inner { padding: 1.75rem; display: flex; flex-direction: column; gap: 0.75rem; height: 100%; }

  .blog-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 0.7rem; color: rgba(255, 255, 255, 0.4); }
  .blog-meta-sep { color: rgba(255, 255, 255, 0.2); }
  .blog-meta-cat { color: var(--color-marvel-gold); font-weight: 700; letter-spacing: 0.1em; }

  .blog-title { font-weight: 900; font-size: clamp(1.25rem, 1.8vw, 1.625rem); line-height: 1.05; letter-spacing: -0.015em; color: #FFFFFF; margin: 0; transition: color 0.2s; }
  .blog-card-lg .blog-title { font-size: clamp(1.75rem, 2.5vw, 2.25rem); }
  .blog-card:hover .blog-title { color: var(--color-marvel-gold-bright); }

  .blog-desc { font-size: 0.875rem; line-height: 1.55; color: rgba(255, 255, 255, 0.5); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .blog-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 0.75rem; }
  .blog-tag { padding: 0.25rem 0.5rem; font-size: 0.65rem; color: rgba(255, 255, 255, 0.35); background: rgba(255, 255, 255, 0.03); border-radius: 0.25rem; }

  .blog-corner { position: absolute; width: 16px; height: 16px; border: 2px solid var(--color-marvel-red); opacity: 0; transition: opacity 0.3s, transform 0.3s; }
  .blog-corner-tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .blog-corner-tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .blog-corner-bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .blog-corner-br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
  .blog-card:hover .blog-corner { opacity: 1; }
  .blog-card:hover .blog-corner-tl { top: -6px; left: -6px; }
  .blog-card:hover .blog-corner-tr { top: -6px; right: -6px; }
  .blog-card:hover .blog-corner-bl { bottom: -6px; left: -6px; }
  .blog-card:hover .blog-corner-br { bottom: -6px; right: -6px; }

  .no-results { display: none; grid-column: 1 / -1; padding: 3rem 1.5rem; text-align: center; background: rgba(255, 255, 255, 0.02); border: 1px dashed rgba(255, 255, 255, 0.1); border-radius: 0.75rem; }
  .no-results.is-shown { display: block; }
  .no-results-text { color: rgba(255, 255, 255, 0.5); font-size: 1rem; margin: 0 0 1.25rem; }
  .no-results-btn { padding: 0.625rem 1.25rem; background: rgba(237, 29, 36, 0.15); border: 1px solid rgba(237, 29, 36, 0.4); border-radius: 999px; color: #FFFFFF; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
  .no-results-btn:hover { background: rgba(237, 29, 36, 0.25); }

  .empty-state { grid-column: 1 / -1; padding: 3rem; text-align: center; color: rgba(255, 255, 255, 0.5); }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-blog-card]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion) {
    cards.forEach((c) => c.classList.add('is-shown'));
  } else {
    const cardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target as HTMLElement;
            const idx = parseInt(card.dataset.cardIdx || '0');
            setTimeout(() => card.classList.add('is-shown'), idx * 50);
            cardObserver.unobserve(card);
          }
        });
      },
      { threshold: 0.1 }
    );
    cards.forEach((c) => cardObserver.observe(c));
  }

  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const catButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-cat]');
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear-filters]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const searchCount = document.querySelector<HTMLElement>('[data-search-count]');

  let activeCat = 'all';
  let activeTag: string | null = null;
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;
    cards.forEach((card) => {
      const cats = JSON.parse(card.dataset.categories || '[]');
      const tags = JSON.parse(card.dataset.tags || '[]');
      const text = card.dataset.text || '';
      const matchCat = activeCat === 'all' || cats.includes(activeCat);
      const matchTag = !activeTag || tags.includes(activeTag);
      const matchText = !searchQuery || text.includes(searchQuery);
      const show = matchCat && matchTag && matchText;
      card.classList.toggle('is-hidden', !show);
      if (show) visibleCount++;
    });

    if (searchCount) {
      const label = searchQuery ? 'result' : 'article';
      searchCount.textContent = `${visibleCount} ${label}${visibleCount !== 1 ? 's' : ''}`;
    }

    if (noResults) noResults.classList.toggle('is-shown', visibleCount === 0);
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      catButtons.forEach((b) => b.classList.remove('filter-btn-active'));
      btn.classList.add('filter-btn-active');
      activeCat = btn.dataset.filterCat || 'all';
      applyFilters();
    });
  });

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.filterTag || '';
      if (activeTag === tag) {
        activeTag = null;
        btn.classList.remove('tag-chip-active');
      } else {
        tagButtons.forEach((b) => b.classList.remove('tag-chip-active'));
        activeTag = tag;
        btn.classList.add('tag-chip-active');
      }
      applyFilters();
    });
  });

  if (searchInput) {
    let debounceTimer: number | null = null;
    searchInput.addEventListener('input', () => {
      if (debounceTimer) window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => {
        searchQuery = searchInput.value.trim().toLowerCase();
        applyFilters();
      }, 150);
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      activeCat = 'all';
      activeTag = null;
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      catButtons.forEach((b) => b.classList.toggle('filter-btn-active', b.dataset.filterCat === 'all'));
      tagButtons.forEach((b) => b.classList.remove('tag-chip-active'));
      applyFilters();
    });
  }
</script>
