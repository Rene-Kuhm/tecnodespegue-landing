---
/**
 * /templates/[slug].astro
 * Detalle de un template con gallery, features, tech stack, pricing
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import { formatDate } from '../../utils/blog.ts';

export async function getStaticPaths() {
  const templates = await getCollection('templates');
  return templates
    .filter(t => !t.data.draft)
    .map(template => ({
      params: { slug: template.id },
      props: { template, allTemplates: templates.filter(t => !t.data.draft) },
    }));
}

interface Props {
  template: CollectionEntry<'templates'>;
  allTemplates: CollectionEntry<'templates'>[];
}

const { template, allTemplates } = Astro.props;
const { Content } = await render(template);

const hasDiscount = template.data.compareAtPrice && template.data.compareAtPrice > template.data.price;
const discount = hasDiscount
  ? Math.round(((template.data.compareAtPrice - template.data.price) / template.data.compareAtPrice) * 100)
  : 0;

// Related templates (same category, different slug)
const related = allTemplates
  .filter(t => t.id !== template.id && t.data.category === template.data.category)
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  landing: 'Landing Page',
  ecommerce: 'E-commerce',
  dashboard: 'Dashboard',
  blog: 'Blog',
  componentes: 'Componentes',
  marketing: 'Marketing',
  portfolio: 'Portfolio',
};

const licenseLabels: Record<string, string> = {
  personal: 'Personal',
  commercial: 'Commercial',
  extended: 'Extended',
};

const licenseDescriptions: Record<string, string> = {
  personal: '1 proyecto personal o de un cliente',
  commercial: 'Proyectos ilimitados de tus clientes',
  extended: 'Revender como producto o SaaS',
};

const title = `${template.data.title} — Templates TecnoDespegue`;
const description = template.data.description;
---

<Layout title={title} description={description}>
  <Nav />

  <main id="contenido" class="tpl-detail-page">
    <!-- Back link -->
    <a href="/templates" class="tpl-back" data-tpl-back>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
        <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Volver a templates</span>
    </a>

    <div class="tpl-detail-container">
      <!-- Left: Content -->
      <article class="tpl-detail-article">
        <!-- Cover image -->
        <div class="tpl-detail-cover" data-tpl-cover>
          {template.data.cover ? (
            <img
              src={template.data.cover}
              alt={template.data.title}
              class="tpl-cover-img"
              loading="eager"
              decoding="async"
              width="1200"
              height="800"
            />
          ) : (
            <div class="tpl-cover-placeholder-large">
              <span class="font-mono">{template.data.category.toUpperCase()}</span>
            </div>
          )}

          {hasDiscount && (
            <div class="tpl-cover-badge">
              <span class="tpl-cover-badge-num">-{discount}%</span>
              <span class="tpl-cover-badge-text">OFF</span>
            </div>
          )}
        </div>

        <!-- Image gallery -->
        {template.data.images && template.data.images.length > 0 && (
          <section class="tpl-gallery" data-tpl-gallery>
            <h2 class="tpl-section-title font-display">
              <span class="tpl-section-num font-mono">01</span>
              Previews
            </h2>
            <div class="tpl-gallery-grid">
              {template.data.images.map((img, idx) => (
                <figure class="tpl-gallery-item">
                  <img
                    src={img}
                    alt={`${template.data.title} preview ${idx + 1}`}
                    class="tpl-gallery-img"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="400"
                  />
                </figure>
              ))}
            </div>
          </section>
        )}

        <!-- Features -->
        {template.data.features && template.data.features.length > 0 && (
          <section class="tpl-section" data-tpl-section>
            <h2 class="tpl-section-title font-display">
              <span class="tpl-section-num font-mono">02</span>
              Features
            </h2>
            <ul class="tpl-features">
              {template.data.features.map((feature, idx) => (
                <li class="tpl-feature">
                  <span class="tpl-feature-num font-mono">0{idx + 1}</span>
                  <span class="tpl-feature-text">{feature}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- What's included -->
        {template.data.includes && template.data.includes.length > 0 && (
          <section class="tpl-section" data-tpl-section>
            <h2 class="tpl-section-title font-display">
              <span class="tpl-section-num font-mono">03</span>
              Qué viene incluido
            </h2>
            <ul class="tpl-includes">
              {template.data.includes.map((item) => (
                <li class="tpl-include">
                  <svg class="tpl-include-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M5 13L9 17L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Tech stack -->
        {template.data.stack && template.data.stack.length > 0 && (
          <section class="tpl-section" data-tpl-section>
            <h2 class="tpl-section-title font-display">
              <span class="tpl-section-num font-mono">04</span>
              Stack tecnológico
            </h2>
            <div class="tpl-stack-grid">
              {template.data.stack.map((tech) => (
                <div class="tpl-stack-item">
                  <span class="tpl-stack-name font-mono">{tech}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Requirements -->
        {template.data.requirements && template.data.requirements.length > 0 && (
          <section class="tpl-section" data-tpl-section>
            <h2 class="tpl-section-title font-display">
              <span class="tpl-section-num font-mono">05</span>
              Requisitos
            </h2>
            <ul class="tpl-requirements">
              {template.data.requirements.map((req) => (
                <li class="tpl-requirement font-mono">{req}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- Full description / content -->
        <section class="tpl-content" data-tpl-content>
          <Content />
        </section>
      </article>

      <!-- Right: Sticky purchase card -->
      <aside class="tpl-purchase-wrap">
        <div class="tpl-purchase" data-tpl-purchase>
          <!-- Top tag -->
          <div class="tpl-purchase-tag">
            <span class="tpl-purchase-tag-dot"></span>
            <span class="tpl-purchase-tag-text font-mono">{categoryLabels[template.data.category]}</span>
            {template.data.featured && <span class="tpl-purchase-tag-featured">★ Destacado</span>}
          </div>

          <!-- Title -->
          <h1 class="tpl-purchase-title font-display" data-tpl-purchase-title>{template.data.title}</h1>

          {template.data.subtitle && (
            <p class="tpl-purchase-subtitle">{template.data.subtitle}</p>
          )}

          <!-- Price block -->
          <div class="tpl-purchase-price-block">
            {hasDiscount ? (
              <div class="tpl-purchase-price-row">
                <span class="tpl-purchase-price-old font-mono">${template.data.compareAtPrice}</span>
                <span class="tpl-purchase-price-discount font-mono">-{discount}%</span>
              </div>
            ) : null}
            <div class="tpl-purchase-price-main">
              <span class="tpl-purchase-price-currency">$</span>
              <span class="tpl-purchase-price-num font-display">{template.data.price}</span>
              <span class="tpl-purchase-price-once">pago único</span>
            </div>
            <p class="tpl-purchase-price-note font-mono">Sin suscripciones. Lifetime access.</p>
          </div>

          <!-- CTAs -->
          <div class="tpl-purchase-ctas">
            <a
              href={template.data.downloadUrl || '#'}
              class="tpl-purchase-btn-primary magnetic"
              data-magnetic
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M3 8L10.8906 13.2604C11.5624 13.7083 12.4376 13.7083 13.1094 13.2604L21 8M5 19H19C20.1046 19 21 18.1046 21 17V7C21 5.89543 20.1046 5 19 5H5C3.89543 5 3 5.89543 3 7V17C3 18.1046 3.89543 19 5 19Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
              <span>Comprar y descargar</span>
            </a>
            {template.data.demoUrl && (
              <a
                href={template.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="tpl-purchase-btn-ghost"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M15 3H21V9M21 3L12 12M21 14V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V5C3 3.89543 3.89543 3 5 3H10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Ver demo en vivo</span>
              </a>
            )}
          </div>

          <!-- Trust -->
          <div class="tpl-purchase-trust">
            <div class="tpl-purchase-trust-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Updates gratis de por vida</span>
            </div>
            <div class="tpl-purchase-trust-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Soporte por email 6 meses</span>
            </div>
            <div class="tpl-purchase-trust-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Licencia {licenseLabels[template.data.license]}</span>
            </div>
          </div>

          <!-- License info -->
          <div class="tpl-purchase-license">
            <p class="tpl-purchase-license-title font-mono">Licencia {licenseLabels[template.data.license]}</p>
            <p class="tpl-purchase-license-desc">{licenseDescriptions[template.data.license]}</p>
          </div>

          <!-- Version + published -->
          <div class="tpl-purchase-meta font-mono">
            <span>v{template.data.version}</span>
            <span class="tpl-purchase-meta-sep">·</span>
            <span>Publicado {formatDate(template.data.publishedAt)}</span>
          </div>
        </div>
      </aside>
    </div>

    <!-- Related templates -->
    {related.length > 0 && (
      <section class="tpl-related" data-tpl-related>
        <h2 class="tpl-related-title font-display">
          Más <span class="text-shine">templates {categoryLabels[template.data.category]}</span>
        </h2>
        <div class="tpl-related-grid">
          {related.map((tpl, idx) => (
            <TemplateCard template={tpl} idx={idx} />
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style is:global>
  .tpl-content {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1rem;
    line-height: 1.75;
  }

  .tpl-content h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    color: #FFFFFF;
    margin: 2rem 0 1rem;
    letter-spacing: -0.01em;
  }

  .tpl-content p {
    margin: 0 0 1rem;
  }

  .tpl-content code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    color: var(--color-marvel-gold);
  }

  .tpl-content a {
    color: var(--color-marvel-gold);
    border-bottom: 1px solid rgba(248, 180, 0, 0.3);
  }
</style>

<style>
  .tpl-detail-page {
    max-width: 80rem;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
  }

  @media (min-width: 768px) {
    .tpl-detail-page { padding: 7rem 2rem 4rem; }
  }

  /* Back link */
  .tpl-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.875rem;
    margin-bottom: 2rem;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .tpl-back:hover {
    color: var(--color-marvel-gold);
    border-color: rgba(248, 180, 0, 0.4);
    background: rgba(248, 180, 0, 0.08);
  }

  .tpl-detail-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1280px) {
    .tpl-detail-container {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 4rem;
    }
  }

  /* Article */
  .tpl-detail-article {
    min-width: 0;
  }

  /* Cover */
  .tpl-detail-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, rgba(237, 29, 36, 0.05) 0%, rgba(0, 0, 0, 0.5) 50%, rgba(177, 78, 255, 0.05) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 3rem;
  }

  .tpl-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tpl-cover-placeholder-large {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.15);
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: 0.3em;
  }

  .tpl-cover-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.875rem;
    background: rgba(237, 29, 36, 0.9);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    color: #FFFFFF;
    font-family: var(--font-mono);
  }

  .tpl-cover-badge-num {
    font-size: 0.95rem;
    font-weight: 900;
  }

  .tpl-cover-badge-text {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  /* Sections */
  .tpl-section {
    margin-top: 3rem;
  }

  .tpl-section-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-weight: 900;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  .tpl-section-num {
    font-size: 0.875rem;
    color: var(--color-marvel-gold);
    font-weight: 700;
  }

  /* Gallery */
  .tpl-gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .tpl-gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .tpl-gallery-item {
    margin: 0;
    aspect-ratio: 3 / 2;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.625rem;
    overflow: hidden;
  }

  .tpl-gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-marvel);
  }

  .tpl-gallery-item:hover .tpl-gallery-img {
    transform: scale(1.05);
  }

  /* Features */
  .tpl-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tpl-feature {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.5rem;
  }

  .tpl-feature-num {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-marvel-red);
    flex-shrink: 0;
    line-height: 1.5;
  }

  .tpl-feature-text {
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }

  /* Includes */
  .tpl-includes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.625rem;
  }

  @media (min-width: 768px) {
    .tpl-includes { grid-template-columns: repeat(2, 1fr); }
  }

  .tpl-include {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    background: rgba(0, 255, 136, 0.05);
    border: 1px solid rgba(0, 255, 136, 0.15);
    border-radius: 0.5rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
  }

  .tpl-include-icon {
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  /* Stack */
  .tpl-stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.625rem;
  }

  .tpl-stack-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.5rem;
    transition: all 0.2s;
  }

  .tpl-stack-item:hover {
    background: rgba(248, 180, 0, 0.08);
    border-color: rgba(248, 180, 0, 0.3);
  }

  .tpl-stack-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Requirements */
  .tpl-requirements {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tpl-requirement {
    padding: 0.625rem 1rem;
    background: rgba(248, 180, 0, 0.05);
    border: 1px solid rgba(248, 180, 0, 0.15);
    border-radius: 0.375rem;
    color: var(--color-marvel-gold);
    font-size: 0.8rem;
  }

  /* Content */
  .tpl-content {
    margin-top: 3rem;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.75rem;
  }

  /* Purchase card (sticky) */
  .tpl-purchase-wrap {
    position: relative;
  }

  @media (min-width: 1280px) {
    .tpl-purchase-wrap {
      position: sticky;
      top: 6rem;
      align-self: flex-start;
    }
  }

  .tpl-purchase {
    padding: 2rem;
    background: linear-gradient(135deg, rgba(237, 29, 36, 0.08) 0%, rgba(0, 0, 0, 0.6) 50%, rgba(248, 180, 0, 0.08) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    backdrop-filter: blur(20px);
    box-shadow: 0 32px 64px -16px rgba(0, 0, 0, 0.5);
  }

  .tpl-purchase-tag {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tpl-purchase-tag-dot {
    width: 6px;
    height: 6px;
    background: var(--color-marvel-red);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(237, 29, 36, 0.6);
  }

  .tpl-purchase-tag-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-marvel-gold);
    text-transform: uppercase;
  }

  .tpl-purchase-tag-featured {
    padding: 0.2rem 0.5rem;
    background: rgba(248, 180, 0, 0.15);
    border: 1px solid rgba(248, 180, 0, 0.4);
    border-radius: 999px;
    color: var(--color-marvel-gold);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tpl-purchase-title {
    font-weight: 900;
    font-size: 1.75rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 0.75rem;
  }

  .tpl-purchase-subtitle {
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1.5rem;
  }

  .tpl-purchase-price-block {
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(248, 180, 0, 0.2);
    border-radius: 0.625rem;
    margin-bottom: 1.5rem;
  }

  .tpl-purchase-price-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .tpl-purchase-price-old {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.3);
    text-decoration: line-through;
  }

  .tpl-purchase-price-discount {
    padding: 0.2rem 0.5rem;
    background: rgba(237, 29, 36, 0.2);
    border-radius: 999px;
    color: var(--color-marvel-red);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tpl-purchase-price-main {
    display: flex;
    align-items: baseline;
