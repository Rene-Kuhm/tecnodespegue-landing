---
/**
 * /templates/index.astro
 * Próximamente — sección de templates en preparación
 */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { siteConfig } from '../../config/site.config';
import type { Locale } from '../../i18n';

const locale: Locale = Astro.props.locale ?? 'es';
const copy = {
  es: {
    title: 'Templates — TecnoDespegue',
    description: 'Próximamente: templates premium para landings, e-commerce, dashboards, blogs y componentes. Landings cinemáticas, e-commerce full-stack con Stripe, dashboards con IA, y más.',
    badge: 'Templates · En preparación',
    pill: 'PRÓXIMAMENTE',
    heading: ['Templates', 'premium', 'en camino'],
    lead: 'Estamos preparando una colección de templates copy-paste ready: landings cinemáticas, e-commerce full-stack, dashboards con IA, blogs con MDX y bundles de componentes premium. Todos con TypeScript estricto y la calidad que ya conocés.',
    statusDev: 'En desarrollo',
    interest: '¿Te interesa?',
    notifyLead: 'Dejanos tu email y te avisamos cuando lancemos el primero, con descuento de early-bird del 30%.',
    notifyButton: 'Notificarme',
    success: '¡Listo! Te avisaremos cuando esté disponible.',
    roadmap: [
      ['Aurora — Landing cinemática', 'Landing premium para SaaS con portal 3D, animaciones GSAP, glassmorphism.', 'En desarrollo'],
      ['Forge — Dashboard con IA', 'Admin dashboard con auth, charts, reportes AI, real-time updates.', 'Q3 2025'],
      ['TiendaNube Pro — E-commerce', 'E-commerce headless con Stripe, multi-idioma, multi-moneda.', 'Q3 2025'],
      ['Inkwell — Blog con MDX', 'Blog estático con content collections, search, RSS, i18n.', 'Q4 2025'],
      ['Marvel Bundle — 40+ componentes', 'Botones, cards, modales, navbars premium copy-paste ready.', 'Q4 2025'],
    ],
  },
  en: {
    title: 'Templates — TecnoDespegue',
    description: 'Coming soon: premium templates for landing pages, e-commerce, dashboards, blogs, and components. Cinematic landings, full-stack e-commerce with Stripe, AI dashboards, and more.',
    badge: 'Templates · In progress',
    pill: 'COMING SOON',
    heading: ['Premium', 'templates', 'on the way'],
    lead: 'We are preparing a copy-paste-ready collection of cinematic landing pages, full-stack e-commerce builds, AI dashboards, MDX blogs, and premium component bundles. All with strict TypeScript and the quality you already know.',
    statusDev: 'In development',
    interest: 'Interested?',
    notifyLead: 'Leave your email and we will let you know when the first one launches, with a 30% early-bird discount.',
    notifyButton: 'Notify me',
    success: 'Done. We will let you know when it is available.',
    roadmap: [
      ['Aurora — Cinematic landing page', 'Premium SaaS landing with a 3D portal, GSAP animations, and glassmorphism.', 'In development'],
      ['Forge — AI dashboard', 'Admin dashboard with auth, charts, AI reports, and real-time updates.', 'Q3 2025'],
      ['TiendaNube Pro — E-commerce', 'Headless e-commerce with Stripe, multi-language, and multi-currency support.', 'Q3 2025'],
      ['Inkwell — MDX blog', 'Static blog with content collections, search, RSS, and i18n.', 'Q4 2025'],
      ['Marvel Bundle — 40+ components', 'Premium copy-paste-ready buttons, cards, modals, and navbars.', 'Q4 2025'],
    ],
  },
}[locale];
const title = copy.title;
const description = copy.description;
const formspreeEndpoint = siteConfig.formspree.endpoint;
---

<Layout title={title} description={description} path={locale === 'en' ? '/en/templates' : '/templates'} locale={locale}>
  <Nav locale={locale} />

  <main id="contenido" class="tpl-soon-page">
    <div class="tpl-soon-bg" aria-hidden="true">
      <div class="bg-glow bg-glow-1"></div>
      <div class="bg-glow bg-glow-2"></div>
      <div class="bg-glow bg-glow-3"></div>
      <div class="bg-grid"></div>
    </div>

    <div class="tpl-soon-content">
      <!-- Top badge -->
      <div class="tpl-soon-badge" data-tpl-soon-badge>
        <span class="tpl-soon-dot"></span>
        <span class="tpl-soon-badge-text font-mono">{copy.badge}</span>
      </div>

      <!-- Soon badge cinemático -->
      <div class="tpl-soon-pill" data-tpl-soon-pill>
        <span class="tpl-soon-pill-icon">◈</span>
        <span class="tpl-soon-pill-text font-mono">{copy.pill}</span>
        <span class="tpl-soon-pill-icon">◈</span>
      </div>

      <!-- Headline -->
      <h1 class="tpl-soon-title font-display" data-tpl-soon-title>
        <span class="tpl-soon-line" data-tpl-soon-line>
          <span class="tpl-soon-word">{copy.heading[0]}</span>
          <span class="tpl-soon-word tpl-soon-accent">{copy.heading[1]}</span>
        </span>
        <span class="tpl-soon-line" data-tpl-soon-line>
          <span class="tpl-soon-word tpl-soon-muted">{copy.heading[2]}</span>
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="tpl-soon-sub" data-tpl-soon-sub>
        {copy.lead}
      </p>

      <!-- Roadmap / Lo que viene -->
      <div class="tpl-soon-roadmap" data-tpl-soon-roadmap>
        <div class="roadmap-item">
          <div class="roadmap-num font-mono">01</div>
          <div class="roadmap-content">
            <h3 class="roadmap-title font-display">{copy.roadmap[0][0]}</h3>
            <p class="roadmap-desc">{copy.roadmap[0][1]}</p>
          </div>
          <div class="roadmap-status font-mono">{copy.roadmap[0][2]}</div>
        </div>

        <div class="roadmap-item">
          <div class="roadmap-num font-mono">02</div>
          <div class="roadmap-content">
            <h3 class="roadmap-title font-display">{copy.roadmap[1][0]}</h3>
            <p class="roadmap-desc">{copy.roadmap[1][1]}</p>
          </div>
          <div class="roadmap-status font-mono">{copy.roadmap[1][2]}</div>
        </div>

        <div class="roadmap-item">
          <div class="roadmap-num font-mono">03</div>
          <div class="roadmap-content">
            <h3 class="roadmap-title font-display">{copy.roadmap[2][0]}</h3>
            <p class="roadmap-desc">{copy.roadmap[2][1]}</p>
          </div>
          <div class="roadmap-status font-mono">{copy.roadmap[2][2]}</div>
        </div>

        <div class="roadmap-item">
          <div class="roadmap-num font-mono">04</div>
          <div class="roadmap-content">
            <h3 class="roadmap-title font-display">{copy.roadmap[3][0]}</h3>
            <p class="roadmap-desc">{copy.roadmap[3][1]}</p>
          </div>
          <div class="roadmap-status font-mono">{copy.roadmap[3][2]}</div>
        </div>

        <div class="roadmap-item">
          <div class="roadmap-num font-mono">05</div>
          <div class="roadmap-content">
            <h3 class="roadmap-title font-display">{copy.roadmap[4][0]}</h3>
            <p class="roadmap-desc">{copy.roadmap[4][1]}</p>
          </div>
          <div class="roadmap-status font-mono">{copy.roadmap[4][2]}</div>
        </div>
      </div>

      <!-- Notification signup -->
      <div class="tpl-soon-notify" data-tpl-soon-notify data-formspree-endpoint={formspreeEndpoint}>
        <div class="notify-card">
          <div class="notify-header">
            <div class="notify-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M15 17H20L18.5951 12.7619C18.2141 11.6767 17.2624 10.8798 16.1301 10.6689L9.86986 9.13108C8.73759 8.92014 7.76244 9.83925 7.76244 10.9967V17M15 17V18C15 19.6569 13.6569 21 12 21C10.3431 21 9 19.6569 9 18V17M15 17H9M3 8C3 6.89543 3.89543 6 5 6C6.10457 6 7 6.89543 7 8V13C7 14.1046 6.10457 15 5 15C3.89543 15 3 14.1046 3 13V8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="notify-title font-display">{copy.interest}</h3>
            <p class="notify-lead">
              {copy.notifyLead}
            </p>
          </div>
          <form class="notify-form" data-notify-form>
            <div class="notify-input-wrap">
              <input
                type="email"
                name="email"
                required
                placeholder={locale === 'en' ? 'you@email.com' : 'tu@email.com'}
                class="notify-input font-mono"
                autocomplete="email"
              />
              <button type="submit" class="notify-btn">
                <span>{copy.notifyButton}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            <p class="notify-success" data-notify-success>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M5 13L9 17L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {copy.success}
            </p>
          </form>
        </div>
      </div>

      <!-- Decoration dots -->
      <div class="tpl-soon-decoration" aria-hidden="true">
        <div class="deco-dot" style="top: 15%; left: 8%"></div>
        <div class="deco-dot" style="top: 25%; right: 12%"></div>
        <div class="deco-dot" style="bottom: 30%; left: 15%"></div>
        <div class="deco-dot" style="bottom: 20%; right: 10%"></div>
        <div class="deco-dot" style="top: 50%; left: 5%"></div>
        <div class="deco-dot" style="top: 60%; right: 6%"></div>
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</Layout>

<style>
  .tpl-soon-page {
    position: relative;
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 1.5rem 4rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .tpl-soon-page { padding: 8rem 2rem 4rem; }
  }

  /* BG */
  .tpl-soon-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }

  .bg-glow-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(237, 29, 36, 0.18) 0%, transparent 70%);
    top: -10%;
    right: -5%;
    animation: glow-drift-1 18s ease-in-out infinite;
  }

  .bg-glow-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(248, 180, 0, 0.12) 0%, transparent 70%);
    bottom: -10%;
    left: -5%;
    animation: glow-drift-2 22s ease-in-out infinite;
  }

  .bg-glow-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(177, 78, 255, 0.1) 0%, transparent 70%);
    top: 40%;
    left: 30%;
    animation: glow-drift-3 16s ease-in-out infinite;
  }

  @keyframes glow-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 30px) scale(1.1); }
  }
  @keyframes glow-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, -20px) scale(0.95); }
  }
  @keyframes glow-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(15px, -15px) scale(1.05); }
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  /* Content */
  .tpl-soon-content {
    position: relative;
    z-index: 1;
    max-width: 60rem;
    width: 100%;
    text-align: center;
  }

  /* Top badge */
  .tpl-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(16px);
  }

  .tpl-soon-dot {
    width: 6px;
    height: 6px;
    background: var(--color-secondary);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-secondary);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .tpl-soon-badge-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Soon pill */
  .tpl-soon-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, rgba(237, 29, 36, 0.15) 0%, rgba(248, 180, 0, 0.15) 100%);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(248, 180, 0, 0.4);
    border-radius: 999px;
    margin-bottom: 2rem;
    opacity: 0;
    transform: scale(0.9);
    position: relative;
    overflow: hidden;
  }

  .tpl-soon-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.15) 50%, transparent 100%);
    transform: translateX(-100%);
    animation: shine-sweep 3s ease-in-out infinite;
  }

  @keyframes shine-sweep {
    0%, 100% { transform: translateX(-100%); }
    50% { transform: translateX(100%); }
  }

  .tpl-soon-pill-icon {
    color: var(--color-marvel-gold);
    font-size: 0.875rem;
  }

  .tpl-soon-pill-text {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
    text-transform: uppercase;
  }

  /* Title */
  .tpl-soon-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }

  .tpl-soon-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    justify-content: center;
    margin-bottom: 0.1em;
  }

  .tpl-soon-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px);
  }

  .tpl-soon-accent {
    background: linear-gradient(135deg, #FFD75A 0%, #ED1D24 50%, #B14EFF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 40px rgba(237, 29, 36, 0.5));
  }

  .tpl-soon-muted { color: rgba(255, 255, 255, 0.4); }

  /* Sub */
  .tpl-soon-sub {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    max-width: 42rem;
    margin: 0 auto 3rem;
    opacity: 0;
    transform: translateY(20px);
  }

  /* Roadmap */
  .tpl-soon-roadmap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 48rem;
    margin: 0 auto 3rem;
    text-align: left;
    opacity: 0;
    transform: translateY(20px);
  }

  .roadmap-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.625rem;
    transition: border-color 0.2s, background 0.2s;
  }

  .roadmap-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(248, 180, 0, 0.2);
  }

  .roadmap-num {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(237, 29, 36, 0.1);
    border: 1px solid rgba(237, 29, 36, 0.3);
    border-radius: 0.375rem;
    color: var(--color-marvel-red);
    font-size: 0.875rem;
    font-weight: 900;
  }

  .roadmap-content {
    min-width: 0;
  }

  .roadmap-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.25rem;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  .roadmap-desc {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    line-height: 1.4;
  }

  .roadmap-status {
    padding: 0.3rem 0.625rem;
    background: rgba(248, 180, 0, 0.1);
    border: 1px solid rgba(248, 180, 0, 0.3);
    border-radius: 999px;
    color: var(--color-marvel-gold);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .roadmap-item {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      gap: 0.5rem;
    }
    .roadmap-status {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  /* Notify */
  .tpl-soon-notify {
    max-width: 32rem;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(20px);
  }

  .notify-card {
    padding: 2rem;
    background: linear-gradient(135deg, rgba(237, 29, 36, 0.05) 0%, rgba(0, 0, 0, 0.6) 50%, rgba(248, 180, 0, 0.05) 100%);
    border: 1px solid rgba(248, 180, 0, 0.2);
    border-radius: 1rem;
    backdrop-filter: blur(20px);
  }

  .notify-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .notify-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(248, 180, 0, 0.1);
    border: 1px solid rgba(248, 180, 0, 0.3);
    border-radius: 0.75rem;
    color: var(--color-marvel-gold);
    margin-bottom: 0.875rem;
  }

  .notify-title {
    font-weight: 900;
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 0 0 0.5rem;
  }

  .notify-lead {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .notify-form {
    width: 100%;
  }

  .notify-input-wrap {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .notify-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    color: #FFFFFF;
    font-size: 0.8125rem;
    transition: border-color 0.2s;
  }

  .notify-input::placeholder { color: rgba(255, 255, 255, 0.3); }
  .notify-input:focus {
    outline: none;
    border-color: rgba(248, 180, 0, 0.4);
  }

  .notify-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.25rem;
    background: #FFFFFF;
    color: #0a0a0a;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s;
    white-space: nowrap;
  }

  .notify-btn:hover {
    transform: translateY(-1px);
  }

  .notify-success {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem;
    background: rgba(0, 255, 136, 0.1);
    border: 1px solid rgba(0, 255, 136, 0.3);
    border-radius: 0.5rem;
    color: var(--color-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    margin: 0;
    text-align: center;
  }

  .notify-success.is-shown { display: flex; }

  @media (max-width: 480px) {
    .notify-input-wrap { flex-direction: column; }
    .notify-btn { width: 100%; justify-content: center; }
  }

  /* Decoration */
  .tpl-soon-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .deco-dot {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--color-marvel-gold);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(248, 180, 0, 0.5);
    animation: deco-twinkle 3s ease-in-out infinite;
  }

  @keyframes deco-twinkle {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion) {
    document.querySelectorAll('[data-tpl-soon-badge], [data-tpl-soon-pill], [data-tpl-soon-line] .tpl-soon-word, [data-tpl-soon-sub], [data-tpl-soon-roadmap], [data-tpl-soon-notify]')
      .forEach((el) => gsap.set(el, { opacity: 1, y: 0, scale: 1 }));
  } else {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.to('[data-tpl-soon-badge]', { opacity: 1, y: 0, duration: 0.6 }, 0.2);
    tl.to('[data-tpl-soon-pill]', { opacity: 1, scale: 1, duration: 0.7, ease: 'back.out(1.7)' }, 0.4);
    tl.to('[data-tpl-soon-line] .tpl-soon-word', {
      opacity: 1, y: 0, duration: 0.9, stagger: 0.06, ease: 'expo.out',
    }, 0.6);
    tl.to('[data-tpl-soon-sub]', { opacity: 1, y: 0, duration: 0.7 }, 1.1);
    tl.to('[data-tpl-soon-roadmap]', { opacity: 1, y: 0, duration: 0.7 }, 1.3);
    tl.to('[data-tpl-soon-notify]', { opacity: 1, y: 0, duration: 0.7 }, 1.5);
  }

  // Notify form
  const form = document.querySelector<HTMLFormElement>('[data-notify-form]');
  const success = document.querySelector<HTMLElement>('[data-notify-success]');
  const notify = document.querySelector<HTMLElement>('[data-tpl-soon-notify]');
  const formspreeEndpoint = notify?.dataset.formspreeEndpoint || '';

  if (form && success) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const email = formData.get('email') as string;

      // Track event
      if (window.ttq) {
        window.ttq.track('Subscribe', {
          content_name: 'templates_notify',
          url: window.location.href,
        });
      }

      // Submit to Formspree
      try {
        await fetch(formspreeEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email, type: 'templates_coming_soon' }),
        });
      } catch (err) {
        // Silent fail
      }

      // Show success
      form.style.display = 'none';
      success.classList.add('is-shown');
      gsap.fromTo(success, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' });
    });
  }
</script>
