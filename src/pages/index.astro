---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProgressBar from '../components/ProgressBar.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import PageTransition from '../components/PageTransition.astro';
import Hero from '../components/Hero.astro';
import HeroMobile from '../components/HeroMobile.astro';
import TrustSignals from '../components/TrustSignals.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import Refactor from '../components/Refactor.astro';
import Why from '../components/Why.astro';
import Tech from '../components/Tech.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n';

const locale: Locale = 'es';
---

<Layout title="TecnoDespegue | Desarrollo Fullstack & Automatizaciones con IA" locale={locale}>
  <LoadingScreen locale={locale} />
  <PageTransition />
  <ProgressBar />
  <Nav locale={locale} />
  
  <main id="contenido">
    {/* Mobile-only hero (≤768px) — más rápido de cargar y mejor LCP */}
    <HeroMobile />
    {/* Desktop-only hero (≥768px) — mockup full-bleed + animaciones */}
    <div class="hero-desktop-wrap">
      <Hero />
    </div>
    
    <TrustSignals />
    <Services />
    <Portfolio />
    <Refactor />
    <Why />
    <Tech />
    <CTA />
  </main>
  
  <Footer locale={locale} />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  /* Hero desktop wrapper: oculto en mobile, visible ≥768px.
     El HeroMobile se muestra a sí mismo via su propio media query. */
  .hero-desktop-wrap {
    display: none;
    background: #0a0508;
  }
  @media (min-width: 768px) {
    .hero-desktop-wrap {
      display: block;
    }
  }
</style>
