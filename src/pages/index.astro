---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProgressBar from '../components/ProgressBar.astro';
import PageTransition from '../components/PageTransition.astro';
import Hero from '../components/Hero.astro';
import HeroStatStrip from '../components/HeroStatStrip.astro';
import TrustSignals from '../components/TrustSignals.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import Refactor from '../components/Refactor.astro';
import Why from '../components/Why.astro';
import Tech from '../components/Tech.astro';
import CTA from '../components/CTA.astro';
import VaultaDownload from '../components/VaultaDownload.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n';

const locale: Locale = 'es';
---

<Layout title="TecnoDespegue | Software interno y automatización de procesos" description="Automatizamos procesos manuales, conectamos sistemas fragmentados y construimos software interno a medida para empresas." locale={locale} alternatePaths={{ es: '/', en: '/en' }}>
  <PageTransition />
  <ProgressBar />
  <Nav locale={locale} />
  
  <main id="contenido">
    <Hero />

    <HeroStatStrip locale={locale} />

    <TrustSignals />
    <Services />
    <Portfolio />
    <Refactor />
    <Why />
    <Tech />
    <CTA />
    <VaultaDownload locale={locale} />
  </main>
  
  <Footer locale={locale} />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

</style>
