---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import BlogHero from '../../components/BlogHero.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import Footer from '../../components/Footer.astro';
import { getCategories, getTopTags } from '../../utils/blog.ts';
import type { Locale } from '../../i18n';

const locale: Locale = 'es';
const allPosts = await getCollection('posts', ({ data }) => (data.locale ?? 'es') === locale);
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = getCategories(posts);
const topTags = getTopTags(posts, 12);

const title = 'Blog de Ingeniería | Fullstack, IA & Arquitectura | TecnoDespegue';
const description = 'Artículos sobre desarrollo fullstack, automatización con IA, arquitectura de software y estrategia tecnológica para startups. Experiencia real en producción, sin humo.';
---

<Layout title={title} description={description} path="/blog" locale={locale}>
  <Nav locale={locale} />
  <BlogHero postCount={posts.length} categoryCount={categories.length} locale={locale} />
  <BlogIndex posts={posts} categories={categories} topTags={topTags} locale={locale} />
  <Footer locale={locale} />
</Layout>
