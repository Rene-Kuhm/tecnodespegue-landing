---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { formatDate, calculateReadTime } from '../../utils/blog.ts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter(p => !p.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = formatDate(post.data.date);
const readTime = post.data.readTime ?? calculateReadTime(post.body);
const title = post.data.seo?.title ?? post.data.title;
const description = post.data.seo?.description ?? post.data.description;
const ogImage = post.data.seo?.image
  ? new URL(post.data.seo.image, Astro.site)
  : new URL('/og-image.png', Astro.site);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: 'https://github.com/Rene-Kuhm',
  },
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  url: canonicalURL.toString(),
  image: ogImage.toString(),
  publisher: {
    '@type': 'Organization',
    name: 'TecnoDespegue',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
  articleSection: post.data.category,
  keywords: (post.data.tags ?? []).join(', '),
};
---

<Layout title={`${title} — TecnoDespegue`} description={description}>
  <!-- Schema.org BlogPosting (injected manually because Layout uses generic schema) -->
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(blogPostingSchema)} />

  <!-- Override OG meta for article -->
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:section" content={post.data.category} />
    <meta property="article:author" content={post.data.author} />
    {post.data.tags?.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </Fragment>

  <Nav />

  <main id="contenido" class="pt-24 pb-24 min-h-screen">
    <article class="max-w-3xl mx-auto px-4 md:px-8">

      <!-- Post Header -->
      <header class="mb-10 md:mb-14">
        <div class="flex items-center gap-3 mb-6 text-xs font-mono text-zinc-400">
          <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
          <span class="text-outline-variant">/</span>
          <span class="text-primary">{post.data.category}</span>
          <span class="text-outline-variant">·</span>
          <time datetime={post.data.date.toISOString()}>{date}</time>
          <span class="text-outline-variant">·</span>
          <span>{readTime} min de lectura</span>
        </div>

        <h1 class="font-headline text-3xl md:text-4xl lg:text-5xl font-bold text-on-surface leading-tight tracking-tight mb-5">
          {post.data.title}
        </h1>

        <p class="text-on-surface-variant text-base md:text-lg leading-relaxed max-w-2xl">
          {post.data.description}
        </p>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map(tag => (
              <span class="px-2.5 py-1 text-xs font-medium text-zinc-400 bg-surface-container-high border border-outline-variant/30 rounded-chip font-label">
                {tag}
              </span>
            ))}
          </div>
        )}

        <div class="mt-8 flex items-center gap-3 pt-6 border-t border-outline-variant/20">
          <div class="w-9 h-9 rounded-full bg-surface-container-high border border-outline-variant/30 flex items-center justify-center text-sm font-bold text-primary">
            {post.data.author.split(' ').map(n => n[0]).join('')}
          </div>
          <div>
            <p class="text-sm font-medium text-on-surface">{post.data.author}</p>
            <p class="text-xs text-zinc-400">TecnoDespegue</p>
          </div>
        </div>
      </header>

      <!-- Post Content -->
      <div class="post-content">
        <Content />
      </div>

      <!-- Post Footer CTA -->
      <div class="mt-16 pt-10 border-t border-outline-variant/20">
        <div class="bg-surface-container border border-outline-variant/30 rounded-card p-6 md:p-8 text-center">
          <h3 class="font-headline text-xl md:text-2xl font-bold text-on-surface mb-2 leading-tight">
            ¿Te ayudamos a implementar esto?
          </h3>
          <p class="text-on-surface-variant text-sm md:text-base max-w-lg mx-auto mb-6">
            Consulta de 30 minutos sin cargo. Analizamos tu stack actual y te decimos exactamente qué optimizar.
          </p>
          <a
            href="/#contacto"
            class="inline-flex bg-primary hover:bg-primary-dim text-on-primary-container px-6 py-3 font-bold tracking-tight text-sm rounded-card transition-all duration-300 active:scale-95 ambient-glow"
          >
            Hablá con un experto
          </a>
        </div>
      </div>

    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  .post-content h1 {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .post-content h2 {
    font-family: var(--font-headline);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-on-surface);
    margin-top: 2rem;
    margin-bottom: 0.875rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .post-content h3 {
    font-family: var(--font-headline);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-on-surface);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .post-content p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-on-surface-variant);
    margin-bottom: 1.25rem;
  }
  .post-content a {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .post-content a:hover {
    border-bottom-color: var(--color-primary);
  }
  .post-content ul, .post-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .post-content li {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-on-surface-variant);
    margin-bottom: 0.5rem;
  }
  .post-content li::marker {
    color: var(--color-primary);
  }
  .post-content blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-primary);
    background-color: var(--color-surface-container);
    border-radius: 0.25rem;
    font-style: italic;
    color: var(--color-on-surface-variant);
    line-height: 1.7;
  }
  .post-content blockquote p {
    margin: 0;
    color: var(--color-on-surface-variant);
  }
  .post-content pre {
    background-color: #000000;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .post-content code {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.875em;
    background-color: var(--color-surface-container-high);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    color: var(--color-primary);
    border: 1px solid var(--color-outline-variant);
  }
  .post-content pre code {
    background-color: transparent;
    padding: 0;
    border: none;
    color: inherit;
  }
  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.9375rem;
  }
  .post-content th {
    text-align: left;
    padding: 0.625rem 0.875rem;
    font-weight: 700;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-high);
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .post-content td {
    padding: 0.625rem 0.875rem;
    color: var(--color-on-surface-variant);
    border-bottom: 1px solid var(--color-outline-variant);
    line-height: 1.5;
  }
  .post-content tr:hover td {
    background-color: var(--color-surface-container);
  }
  .post-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    margin: 1.25rem 0;
    border: 1px solid var(--color-outline-variant);
  }
  .post-content hr {
    border: none;
    border-top: 1px solid var(--color-outline-variant);
    margin: 2rem 0;
  }
  .post-content strong {
    color: var(--color-on-surface);
    font-weight: 600;
  }
  .post-content input[type="checkbox"] {
    accent-color: var(--color-primary);
    margin-right: 0.5rem;
  }
</style>
