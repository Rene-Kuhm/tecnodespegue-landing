---
/**
 * /admin/edit/[locale]/[slug] — Editar un post existente.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import PostEditor from '../../../../components/admin/PostEditor.astro';
import AdminLayout from '../../../../layouts/admin/AdminLayout.astro';

export const prerender = false;

const { locale, slug } = Astro.params;
if (!locale || !slug || (locale !== 'es' && locale !== 'en')) {
  return new Response('Not found', { status: 404 });
}

const all = await getCollection('posts');
const post = all.find(p => {
  const pSlug = p.id.replace(/^en\//, '');
  return pSlug === slug && (p.data.locale ?? 'es') === locale;
});

if (!post) {
  return new Response('Not found', { status: 404 });
}

// Leer el archivo raw para extraer el body (sin frontmatter)
const dir = locale === 'en' ? 'src/content/posts/en' : 'src/content/posts';
const filePath = join(process.cwd(), dir, `${slug}.md`);
let rawContent = '';
try {
  rawContent = await readFile(filePath, 'utf-8');
} catch (err) {
  return new Response(`Failed to read post: ${err}`, { status: 500 });
}

// Separar frontmatter del body
const fmMatch = rawContent.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
const body = fmMatch ? fmMatch[2].trim() : rawContent;

const categories = [...new Set(all.map(p => p.data.category))].sort();
const tags = [...new Set(all.flatMap(p => p.data.tags ?? []))].sort();

const csrfToken = Array.from(crypto.getRandomValues(new Uint8Array(24)))
  .map(b => b.toString(16).padStart(2, '0')).join('');

const postData = {
  id: post.id,
  slug: post.id.replace(/^en\//, ''),
  locale: (post.data.locale ?? 'es') as 'es' | 'en',
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString().slice(0, 10),
  author: post.data.author ?? 'René Kuhm',
  category: post.data.category,
  tags: post.data.tags ?? [],
  readTime: post.data.readTime ?? undefined,
  featured: post.data.featured ?? false,
  draft: post.data.draft ?? false,
  image: post.data.image,
  seoTitle: post.data.seo?.title,
  seoDescription: post.data.seo?.description,
  body,
};
---

<AdminLayout title={`Editar: ${post.data.title}`} csrfToken={csrfToken}>
  <header class="page-head">
    <a href="/admin/" class="back">← Volver a la lista</a>
    <h1>Editar post</h1>
  </header>
  <PostEditor post={postData} categories={categories} tags={tags} csrfToken={csrfToken} />

  <div class="danger-zone">
    <h2>Zona peligrosa</h2>
    <p>Eliminar este post lo borra de GitHub y Vercel. No se puede deshacer.</p>
    <button id="delete-btn" class="btn-danger" data-slug={postData.slug} data-locale={postData.locale}>Eliminar post</button>
    <div id="delete-status" class="status" role="status" aria-live="polite"></div>
  </div>
</AdminLayout>

<script define:vars={{ csrfToken, slug: postData.slug, locale: postData.locale }}>
  const btn = document.getElementById('delete-btn');
  const status = document.getElementById('delete-status');

  btn?.addEventListener('click', async () => {
    if (!confirm(`¿Eliminar el post "${slug}"? Esta accion no se puede deshacer.`)) return;
    btn.disabled = true;
    btn.textContent = 'Eliminando...';
    status.className = 'status';
    status.textContent = '';

    try {
      const res = await fetch('/admin/api/delete-post', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ locale, slug, csrfToken }),
      });
      const data = await res.json();
      if (!res.ok) {
        status.className = 'status error';
        status.textContent = data.error || 'Error al eliminar';
        if (data.detail) status.innerHTML += `<br><small>${data.detail}</small>`;
        btn.disabled = false;
        btn.textContent = 'Eliminar post';
        return;
      }
      status.className = 'status success';
      status.innerHTML = `Borrado. Commit: <a href="${data.commitUrl}" target="_blank">ver en GitHub</a>. Redirigiendo...`;
      setTimeout(() => window.location.href = '/admin/', 2000);
    } catch {
      status.className = 'status error';
      status.textContent = 'Error de red';
      btn.disabled = false;
      btn.textContent = 'Eliminar post';
    }
  });
</script>

<style>
  .danger-zone {
    margin-top: 3rem; padding: 1.5rem;
    background: rgba(237, 29, 36, 0.05);
    border: 1px solid rgba(237, 29, 36, 0.3);
    border-radius: 0.5rem;
  }
  .danger-zone h2 { font-size: 1rem; color: #FCA5A5; margin: 0 0 0.5rem; }
  .danger-zone p { color: rgba(255,255,255,0.5); font-size: 0.85rem; margin: 0 0 1rem; }
  .btn-danger {
    padding: 0.625rem 1.25rem;
    background: rgba(237, 29, 36, 0.15);
    border: 1px solid rgba(237, 29, 36, 0.4);
    color: #FCA5A5;
    border-radius: 0.5rem;
    font-size: 0.85rem; font-weight: 600;
    cursor: pointer; font-family: inherit;
  }
  .btn-danger:hover:not(:disabled) { background: rgba(237, 29, 36, 0.3); }
  .btn-danger:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<style>
  .page-head { margin-bottom: 1.5rem; }
  .back { display: inline-block; color: rgba(255,255,255,0.5); text-decoration: none; font-size: 0.8rem; margin-bottom: 0.5rem; }
  .back:hover { color: #fff; }
  .page-head h1 { margin: 0; font-size: 1.5rem; }
</style>