---
/**
 * /admin/ — Lista de posts (ES + EN) con acciones.
 */
export const prerender = false;

import { getCollection } from 'astro:content';
import AdminLayout from '../../layouts/admin/AdminLayout.astro';

// CSRF token: un valor aleatorio por sesion
const csrfToken = Array.from(crypto.getRandomValues(new Uint8Array(24)))
  .map(b => b.toString(16).padStart(2, '0')).join('');

const all = await getCollection('posts');
const posts = all
  .map(p => ({
    id: p.id,
    slug: p.id.replace(/^en\//, ''),
    locale: (p.data.locale ?? 'es') as 'es' | 'en',
    title: p.data.title,
    description: p.data.description,
    date: p.data.date,
    category: p.data.category,
    tags: p.data.tags ?? [],
    draft: p.data.draft ?? false,
    featured: p.data.featured ?? false,
  }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<AdminLayout title="Posts" csrfToken={csrfToken}>
  <header class="page-head">
    <div>
      <h1>Posts</h1>
      <p class="sub">{posts.length} total · {posts.filter(p => p.locale === 'es').length} ES · {posts.filter(p => p.locale === 'en').length} EN</p>
    </div>
    <a href="/admin/new" class="btn-primary">+ Nuevo post</a>
  </header>

  <div class="filter-bar">
    <button class="filter active" data-filter="all">Todos</button>
    <button class="filter" data-filter="es">Español</button>
    <button class="filter" data-filter="en">English</button>
    <button class="filter" data-filter="draft">Borradores</button>
    <button class="filter" data-filter="published">Publicados</button>
  </div>

  <table class="post-table">
    <thead>
      <tr>
        <th>Título</th>
        <th>Idioma</th>
        <th>Categoría</th>
        <th>Fecha</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="post-tbody">
      {posts.map(p => (
        <tr data-locale={p.locale} data-status={p.draft ? 'draft' : 'published'}>
          <td>
            <div class="post-title-cell">
              <strong>{p.title}</strong>
              {p.featured && <span class="badge badge-gold">★</span>}
              <div class="post-desc">{p.description}</div>
            </div>
          </td>
          <td><span class={`locale-pill locale-${p.locale}`}>{p.locale.toUpperCase()}</span></td>
          <td>{p.category}</td>
          <td class="muted">{p.date.toISOString().slice(0, 10)}</td>
          <td>
            {p.draft ? <span class="badge badge-draft">Borrador</span> : <span class="badge badge-live">Publicado</span>}
          </td>
          <td class="actions">
            <a href={`/admin/edit/${p.locale}/${p.slug}`} class="btn-sm">Editar</a>
            <a href={p.locale === 'en' ? `/en/blog/${p.slug}/` : `/blog/${p.slug}/`} target="_blank" class="btn-sm btn-ghost">Ver ↗</a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  {posts.length === 0 && <p class="empty">No hay posts todavía. <a href="/admin/new">Creá el primero</a>.</p>}
</AdminLayout>

<style>
  .page-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .page-head h1 { margin: 0 0 0.25rem; font-size: 1.5rem; }
  .sub { margin: 0; color: rgba(255,255,255,0.5); font-size: 0.85rem; }
  .btn-primary {
    padding: 0.625rem 1.25rem;
    background: linear-gradient(135deg, #ED1D24 0%, #B91C1C 100%);
    color: #fff; font-weight: 700; font-size: 0.85rem;
    border-radius: 0.5rem;
    text-decoration: none;
  }
  .filter-bar { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .filter {
    padding: 0.5rem 1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 999px;
    color: rgba(255,255,255,0.6);
    font-size: 0.75rem; font-weight: 600;
    cursor: pointer; font-family: inherit;
  }
  .filter.active { background: rgba(237, 29, 36, 0.15); border-color: rgba(237, 29, 36, 0.4); color: #fff; }
  .post-table { width: 100%; border-collapse: collapse; }
  .post-table th {
    text-align: left;
    padding: 0.75rem 0.5rem;
    font-size: 0.7rem; color: rgba(255,255,255,0.4);
    text-transform: uppercase; letter-spacing: 0.1em;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .post-table td {
    padding: 0.875rem 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    font-size: 0.85rem;
  }
  .post-title-cell strong { display: inline; font-weight: 600; color: #fff; }
  .post-desc { color: rgba(255,255,255,0.4); font-size: 0.75rem; margin-top: 0.25rem; max-width: 30rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .locale-pill {
    display: inline-block; padding: 0.2rem 0.5rem; border-radius: 0.25rem;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;
  }
  .locale-es { background: rgba(248, 180, 0, 0.15); color: #F8B400; }
  .locale-en { background: rgba(59, 130, 246, 0.15); color: #60A5FA; }
  .muted { color: rgba(255,255,255,0.4); }
  .badge { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.7rem; font-weight: 600; }
  .badge-draft { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.5); }
  .badge-live { background: rgba(34, 197, 94, 0.15); color: #86EFAC; }
  .badge-gold { background: rgba(248, 180, 0, 0.2); color: #F8B400; margin-left: 0.5rem; }
  .actions { text-align: right; white-space: nowrap; }
  .btn-sm {
    display: inline-block; padding: 0.375rem 0.75rem;
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.8);
    border-radius: 0.375rem;
    text-decoration: none;
    font-size: 0.75rem; font-weight: 600;
    margin-left: 0.5rem;
  }
  .btn-sm:hover { background: rgba(255,255,255,0.1); }
  .btn-ghost { background: transparent; border: 1px solid rgba(255,255,255,0.1); }
  .empty { padding: 3rem; text-align: center; color: rgba(255,255,255,0.4); }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const rows = document.querySelectorAll<HTMLTableRowElement>('#post-tbody tr');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      rows.forEach(r => {
        if (f === 'all') { r.style.display = ''; return; }
        const match = f === 'es' || f === 'en'
          ? r.dataset.locale === f
          : r.dataset.status === f;
        r.style.display = match ? '' : 'none';
      });
    });
  });
</script>