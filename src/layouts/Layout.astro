---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor.astro';
import { siteConfig } from '../config/site.config';
import { useTranslations, localeConfig, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Locale de la página: 'es' (default) o 'en' */
  locale?: Locale;
  /** URL path para generar hreflang alternates. Ej: '/blog', '/privacidad' */
  path?: string;
}

const {
  title,
  description = siteConfig.description,
  noindex = false,
  ogImage: customOgImage,
  locale = 'es',
  path = Astro.url.pathname,
} = Astro.props;

const t = useTranslations(locale);
const cfg = localeConfig[locale];

const canonicalURL = new URL(path, Astro.site);
const ogImage = new URL(customOgImage || (locale === 'en' ? siteConfig.ogImageEn : siteConfig.ogImage), Astro.site);
const plausibleDomain = siteConfig.plausible.domain || Astro.site?.hostname || canonicalURL.hostname;

const esPath = path.startsWith('/en') ? path.replace(/^\/en/, '') || '/' : path;
const enPath = esPath === '/' ? '/en/' : `/en${esPath}`;
const esURL = new URL(esPath, Astro.site).toString();
const enURL = new URL(enPath, Astro.site).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteConfig.name,
  "url": siteConfig.url,
  "logo": new URL('/favicon.svg', siteConfig.url).toString(),
  "description": description,
  "email": siteConfig.email,
  "telephone": siteConfig.phone,
  "founder": {
    "@type": "Person",
    "name": "René Kuhm",
    "jobTitle": "Senior Fullstack Engineer",
    "url": siteConfig.social.github
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.location.street,
    "addressRegion": siteConfig.location.region,
    "addressCountry": siteConfig.location.country
  },
  "areaServed": {
    "@type": "Country",
    "name": "Argentina"
  },
  "sameAs": [
    siteConfig.social.github,
    siteConfig.social.instagram,
    siteConfig.social.tiktok,
    siteConfig.social.youtube,
    siteConfig.social.linkedin
  ],
  "knowsAbout": [
    "Fullstack Development",
    "AI Automation",
    "TypeScript",
    "React",
    "Next.js",
    "Node.js",
    "Python",
    "Docker",
    "PostgreSQL"
  ]
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": siteConfig.name,
  "image": ogImage.toString(),
  "priceRange": "USD 5K - 50K+",
  "url": siteConfig.url,
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.location.street,
    "addressRegion": siteConfig.location.region,
    "addressCountry": siteConfig.location.country
  }
};
---

<!doctype html>
<html lang={cfg.htmlLang} class="dark" data-tt-pixel={siteConfig.tiktokPixel.enabled ? siteConfig.tiktokPixel.id : undefined} data-plausible-domain={siteConfig.plausible.enabled && import.meta.env.PROD ? plausibleDomain : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="TecnoDespegue" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Local @fontsource-variable fonts cargan vía @font-face (no necesitan preconnect a gstatic/googleapis)
         Solo pre-cargamos la fuente crítica: Space Grotesk (la usa el body + 90% de la UI).
         Inter y las display fonts (Big Shoulders / Bangers) solo se usan en títulos grandes
         y pueden esperar a FCP sin impactar LCP. -->

    <!-- LCP image: solo preload en desktop. En mobile HeroMobile usa loading="eager"
         fetchpriority="high" directamente en el <img> — el preload duplicado compite
         con otros recursos críticos. -->
    <link
      rel="preload"
      as="image"
      href="/hero-mockup.webp"
      type="image/webp"
      fetchpriority="high"
      media="(min-width: 768px)"
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang alternates for i18n -->
    <link rel="alternate" hreflang="es-AR" href={esURL} />
    <link rel="alternate" hreflang="en-US" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- RSS feed auto-discovery (so crawlers + readers can find it without manual URL) -->
    <link rel="alternate" type="application/rss+xml" title={locale === 'en' ? 'TecnoDespegue — Engineering Blog' : 'TecnoDespegue — Blog de Ingeniería'} href={locale === 'en' ? new URL('/en/rss.xml', Astro.site).toString() : new URL('/rss.xml', Astro.site).toString()} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={cfg.ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Keywords — locale-aware -->
    <meta name="keywords" content={locale === 'en'
      ? 'custom software, AI automation, fullstack development, typescript, react, node.js, machine learning workflows, web development'
      : 'desarrollo web, automatización IA, fullstack, typescript, react, node.js, inteligencia artificial, flujos de trabajo, argentina'} />
    <meta name="author" content="TecnoDespegue" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(professionalServiceSchema)} />

    {siteConfig.tiktokPixel.enabled && (
      <script src="/_astro/tiktok-pixel-loader.js" defer></script>
    )}

    {siteConfig.plausible.enabled && import.meta.env.PROD && (
      <script src="/_astro/plausible-loader.js" defer></script>
    )}

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <CustomCursor />
    <a class="skip-link" href="#contenido">{t.meta.skipToContent}</a>

    <!-- Lenis bootstrap. Las secciones son visibles por defecto; las animaciones
         no deben ser requisito para que la landing se renderice correctamente. -->
    <script>
      const startLenisAndAnimations = async () => {
        const { initLenis } = await import('../scripts/animations/lenis');
        initLenis();
      };

      const schedule = () => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(startLenisAndAnimations, { timeout: 2000 });
        } else {
          setTimeout(startLenisAndAnimations, 1500);
        }
      };

      if (document.readyState === 'complete') {
        schedule();
      } else {
        window.addEventListener('load', schedule, { once: true });
      }
      // Safety net: si la página lleva 6s sin cargar por algo raro,
      // arrancamos igual.
      setTimeout(schedule, 6000);
    </script>

    <slot />
  </body>
</html>

<style is:global>
  html, body {
    background-color: #0e0e0e;
    color: #ffffff;
    margin: 0;
    padding: 0;
  }
</style>
