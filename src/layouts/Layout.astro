---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Desarrollo fullstack, automatizaciones con IA y flujos de trabajo inteligentes. Arquitecturas escalables para empresas que buscan crecer sin límites."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TecnoDespegue",
  "url": Astro.site?.toString(),
  "logo": new URL('/favicon.svg', Astro.site).toString(),
  "description": description,
  "email": "renekuhm2@gmail.com",
  "telephone": "+54-9-2334-409838",
  "founder": {
    "@type": "Person",
    "name": "René Kuhm",
    "jobTitle": "Senior Fullstack Engineer",
    "url": "https://github.com/Rene-Kuhm"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Eduardo Castilla",
    "addressRegion": "La Pampa",
    "addressCountry": "AR"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Argentina"
  },
  "sameAs": [
    "https://github.com/Rene-Kuhm",
    "https://instagram.com/renekuhm",
    "https://tiktok.com/@kuhmdev",
    "https://youtube.com/@tecnodespegue",
    "https://linkedin.com/in/renekuhm"
  ],
  "knowsAbout": [
    "Fullstack Development",
    "AI Automation",
    "TypeScript",
    "React",
    "Next.js",
    "Node.js",
    "Python",
    "Docker",
    "PostgreSQL"
  ]
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "TecnoDespegue",
  "image": ogImage.toString(),
  "priceRange": "USD 5K - 50K+",
  "url": Astro.site?.toString(),
  "telephone": "+54-9-2334-409838",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Eduardo Castilla",
    "addressRegion": "La Pampa",
    "addressCountry": "AR"
  }
};
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_AR" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Keywords -->
    <meta name="keywords" content="desarrollo web, automatización IA, fullstack, typescript, react, node.js, inteligencia artificial, flujos de trabajo, argentina" />
    <meta name="author" content="TecnoDespegue" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0" rel="stylesheet">
    
    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(professionalServiceSchema)} />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>

<style is:global>
  html, body {
    background-color: #0e0e0e;
    color: #ffffff;
    margin: 0;
    padding: 0;
  }

  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
  }
</style>
