---
/**
 * Hero.astro — Mockup Edition v6 (3D screen layer)
 * La imagen mockup ocupa todo el viewport como background.
 * El contenido web (headline + CTAs + stats) va DEBAJO como un overlay
 * semi-transparente centrado sobre la imagen, NO se superpone con el monitor.
 *
 * v6: en desktop (>820px), sin prefers-reduced-motion y con WebGL disponible,
 * se monta una escena Three.js (Code3D, ya existente en
 * src/scripts/three/code3D.ts pero sin usar hasta ahora) exactamente sobre
 * el rectángulo de la pantalla del monitor en la foto, agregando líneas de
 * código flotando en 3D encima del dashboard estático. Es progressive
 * enhancement puro: si falla WebGL, hay reduced-motion, o el viewport es
 * mobile, el usuario sigue viendo la imagen estática (sin cambios de layout,
 * sin JS extra descargado — el chunk de Three.js se importa dinámicamente).
 */

import Icon from './Icon.astro';
import GlowOrbs from './GlowOrbs.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';
const copy = {
  es: {
    kicker: 'SOFTWARE PARA OPERACIONES · 01',
    title: ['Menos tareas', 'manuales.', 'Más control.'],
    lead: 'Automatizamos procesos, conectamos sistemas fragmentados y construimos software interno para equipos que necesitan operar con menos fricción.',
    primary: 'Iniciá tu Proyecto',
    secondary: 'Ver Portfolio',
    stats: ['Arquitectura', 'Pruebas', 'Entrega', 'Código'],
    status: 'SISTEMAS EN ÓRBITA',
    contactHref: '#contacto',
    portfolioHref: '#portfolio',
  },
  en: {
    kicker: 'SOFTWARE FOR OPERATIONS · 01',
    title: ['Less manual', 'work.', 'More control.'],
    lead: 'We automate processes, connect fragmented systems, and build internal software for teams that need to operate with less friction.',
    primary: 'Start your Project',
    secondary: 'View Portfolio',
    stats: ['Architecture', 'Testing', 'Delivery', 'Code'],
    status: 'SYSTEMS IN ORBIT',
    contactHref: '/en#contacto',
    portfolioHref: '/en#portfolio',
  },
}[locale];
---

<section class="hero-section" data-hero>
  <!-- Background full bleed — versión 4K 21:9 (ultrawide) cuando el viewport es ancho,
       versión 3:2 estándar en el resto. object-fit: cover mantiene aspect ratio. -->
  <picture class="hero-bg" aria-hidden="true">
    <source media="(min-aspect-ratio: 17/9)" srcset="/hero-mockup-ultrawide.webp" type="image/webp" />
    <source media="(min-aspect-ratio: 17/9)" srcset="/hero-mockup-ultrawide.jpg" type="image/jpeg" />
    <source srcset="/hero-mockup.webp" type="image/webp" />
    <source srcset="/hero-mockup.jpg" type="image/jpeg" />
    <img src="/hero-mockup.jpg" alt="" class="hero-bg-img" loading="eager" decoding="async" fetchpriority="high" width="1264" height="848" />
    <div class="hero-bg-top-fade" aria-hidden="true"></div>
  </picture>

  <!-- Glow orbs: cosmic/gold/red atmospheric wash behind the 3D code layer.
       DOM-ordered between .hero-bg (z:0) and .hero-3d-mount (z:1) so the
       orbs tint the dark areas of the mockup but stay behind the floating
       code lines. -->
  <GlowOrbs />

  <!-- Capa 3D: se posiciona por JS exactamente sobre la pantalla del monitor
       en la foto de fondo. Vacía y oculta hasta que el script la monta. -->
  <div class="hero-3d-mount" data-hero-3d aria-hidden="true"></div>

  <!-- Side content: title + copy + CTAs (no se superpone con el monitor) -->
  <div class="hero-side" data-hero-side>
    <span class="side-kicker" data-hero-kicker>
      <span class="side-kicker-dot"></span>
      <span class="side-kicker-text font-mono">{copy.kicker}</span>
    </span>

    <h1 class="side-title font-display" data-hero-title>
      <span class="side-line" data-side-line>
        <span class="side-word">{copy.title[0]}</span>
      </span>{' '}
      <span class="side-line" data-side-line>
        <span class="side-word side-accent">{copy.title[1]}</span>
      </span>{' '}
      <span class="side-line" data-side-line>
        <span class="side-word">{copy.title[2]}</span>
      </span>
    </h1>

    <p class="side-lead" data-hero-lead>
      {copy.lead}
    </p>

    <div class="side-ctas" data-hero-ctas>
      <a href={copy.contactHref} class="side-btn-primary magnetic" data-magnetic data-hero-analytics="primary" data-locale={locale}>
        <Icon name="bolt" class="w-4 h-4" />
        <span>{copy.primary}</span>
      </a>
      <a href={copy.portfolioHref} class="side-btn-ghost magnetic" data-magnetic data-hero-analytics="portfolio" data-locale={locale}>
        <span>{copy.secondary}</span>
        <Icon name="arrow_forward" class="w-4 h-4" />
      </a>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="hero-bottom-bar" data-hero-bottom>
    <div class="bb-stats">
      <div class="bb-stat">
        <div class="bb-stat-num font-display">SDD</div>
        <div class="bb-stat-label">{copy.stats[0]}</div>
      </div>
      <div class="bb-divider"></div>
      <div class="bb-stat">
        <div class="bb-stat-num font-display text-shine">BDD</div>
        <div class="bb-stat-label">{copy.stats[1]}</div>
      </div>
      <div class="bb-divider"></div>
      <div class="bb-stat">
        <div class="bb-stat-num font-display">CI/CD</div>
        <div class="bb-stat-label">{copy.stats[2]}</div>
      </div>
      <div class="bb-divider"></div>
      <div class="bb-stat">
        <div class="bb-stat-num font-display">OSS</div>
        <div class="bb-stat-label">{copy.stats[3]}</div>
      </div>
    </div>
    <div class="bb-cta-wrap">
      <span class="bb-status font-mono">
        <span class="bb-pulse"></span>
        {copy.status}
      </span>
    </div>
  </div>

  <!-- Scroll indicator — only on mobile (CSS hides on desktop) -->
  <a href="#soluciones" class="hero-scroll-cue" aria-label="Desplazarse hacia abajo">
    <span class="scroll-cue-text font-mono">Deslizá</span>
    <svg class="scroll-cue-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<style>
  /* ──────────────────────────────────────────────────────────────
     MOBILE-FIRST BASE (default styles apply on every viewport).
     Desktop enhancements are wrapped in @media (min-width: 821px).
     ────────────────────────────────────────────────────────────── */

  .hero-section {
    position: relative;
    min-height: 100svh;
    min-height: 100dvh;
    width: 100%;
    overflow: hidden;
    background: #0a0508;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom));
  }

  /* Hide monitor mockup + 3D code layer on mobile — text-first hero. */
  .hero-bg,
  .hero-3d-mount {
    display: none;
  }

  /* ─── Side content (mobile-first: stacked, full width) ─── */
  .hero-side {
    position: relative;
    width: 100%;
    max-width: 32rem;
    margin: 0 auto;
    z-index: 5;
  }

  .side-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.875rem;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    opacity: 0;
    translate: 0 12px;
    animation: hero-supporting-reveal 450ms var(--ease-marvel, ease) 150ms forwards;
  }

  .side-kicker-dot {
    width: 6px;
    height: 6px;
    background: var(--color-secondary);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-secondary);
  }

  .side-kicker-text {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: rgba(255,255,255,0.7);
  }

  .side-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 11vw, 3.75rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.25rem;
    text-shadow: 0 4px 24px rgba(0,0,0,0.7);
  }

  .side-line {
    display: block;
  }

  .side-word {
    display: inline-block;
  }

  .side-accent {
    background: linear-gradient(135deg, #FFFFFF 0%, #FF6B9D 50%, #B14EFF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(255,107,157,0.5));
  }

  .side-lead {
    font-size: clamp(0.95rem, 3.6vw, 1.05rem);
    line-height: 1.55;
    color: rgba(255,255,255,0.78);
    max-width: 28rem;
    margin: 0 0 1.5rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
    opacity: 0;
    translate: 0 12px;
    animation: hero-supporting-reveal 450ms var(--ease-marvel, ease) 250ms forwards;
  }

  .side-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    opacity: 0;
    translate: 0 12px;
    animation: hero-supporting-reveal 450ms var(--ease-marvel, ease) 350ms forwards;
  }

  .side-btn-primary,
  .side-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s, border-color 0.2s;
    white-space: nowrap;
    cursor: pointer;
  }

  /* Primary CTA dominates — full width, prominent on mobile */
  .side-btn-primary {
    width: 100%;
    min-height: 3rem;
    padding: 0.95rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 999px;
    background: #FFFFFF;
    color: #0a0a0a;
    box-shadow: 0 12px 32px -8px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08);
  }

  .side-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -8px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.18);
  }

  .side-btn-primary:active {
    transform: translateY(0);
  }

  /* Ghost CTA — secondary, smaller, centered text-only feel */
  .side-btn-ghost {
    align-self: center;
    width: auto;
    min-height: 2.5rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 999px;
    background: transparent;
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(255,255,255,0.15);
  }

  .side-btn-ghost:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.3);
    color: rgba(255,255,255,0.95);
    transform: translateY(-1px);
  }

  .side-btn-ghost:active {
    transform: translateY(0);
  }

  .magnetic { transition: transform 0.3s var(--ease-marvel, ease); }

  /* ─── Bottom bar (mobile-first: relative, full width) ─── */
  .hero-bottom-bar {
    position: relative;
    width: 100%;
    max-width: 32rem;
    margin: 0 auto;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1rem;
    box-shadow: 0 24px 48px -12px rgba(0,0,0,0.7);
    opacity: 0;
    translate: 0 12px;
    animation: hero-supporting-reveal 450ms var(--ease-marvel, ease) 450ms forwards;
  }

  @keyframes hero-supporting-reveal {
    to {
      opacity: 1;
      translate: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-kicker,
    .side-lead,
    .side-ctas,
    .hero-bottom-bar {
      animation: none;
      opacity: 1;
      translate: none;
    }
  }

  .bb-stats {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    width: 100%;
    justify-content: space-between;
  }

  .bb-stat {
    text-align: center;
    flex: 1 1 0;
    min-width: 0;
  }

  .bb-stat-num {
    font-size: clamp(0.95rem, 4vw, 1.125rem);
    font-weight: 900;
    line-height: 1;
    color: #FFFFFF;
  }

  .bb-stat-label {
    font-size: clamp(0.42rem, 1.5vw, 0.55rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45);
    font-family: var(--font-mono);
    margin-top: 0.2rem;
    overflow-wrap: anywhere;
  }

  /* On mobile we hide dividers and the status pill — they're desktop
     ornamentation that crowds the small viewport. */
  .bb-divider,
  .bb-cta-wrap {
    display: none;
  }

  /* ─── Scroll cue — visible only on mobile ─── */
  .hero-scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: center;
    margin: 1.25rem auto 0;
    padding: 0.5rem 1rem;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border-radius: 999px;
    transition: color 0.2s;
    z-index: 5;
  }

  .hero-scroll-cue:hover,
  .hero-scroll-cue:focus-visible {
    color: rgba(255,255,255,0.95);
  }

  .scroll-cue-arrow {
    animation: scroll-cue-bounce 2s ease-in-out infinite;
  }

  @keyframes scroll-cue-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-arrow { animation: none; }
  }

  @media (max-width: 360px) {
    .hero-section { padding-inline: 0.875rem; }
  }

  /* ──────────────────────────────────────────────────────────────
     DESKTOP ENHANCEMENTS — applied from 821px up.
     Adds the cinematic monitor mockup background, the 3D code layer,
     absolute side positioning, larger typography, the centered
     floating stats bar with dividers, and inline CTAs (side-by-side).
     Hides the mobile-only scroll cue.
     ────────────────────────────────────────────────────────────── */
  @media (min-width: 821px) {
    /* Hide mobile-only scroll cue — desktop has visible content below */
    .hero-scroll-cue { display: none; }

    /* CTAs go back to inline on desktop — primary prominent, ghost secondary */
    .side-ctas {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem;
      width: auto;
    }

    .side-btn-primary {
      width: auto;
      min-height: 2.875rem;
      padding: 0.875rem 1.5rem;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .side-btn-ghost {
      align-self: auto;
      min-height: 2.875rem;
      padding: 0.875rem 1.5rem;
      font-size: 0.875rem;
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(12px);
    }
  @media (min-width: 821px) {
    .hero-section {
      height: 100vh;
      min-height: 700px;
      padding: 0;
      display: block;
    }

    /* Show the monitor mockup + 3D code layer */
    .hero-bg {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
      margin: 0;
      overflow: hidden;
      background: #0a0508;
    }

    .hero-bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-width: 100%;
      min-height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .hero-bg-top-fade {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 30%;
      background: linear-gradient(180deg, #0a0508 0%, rgba(10,5,8,0.8) 50%, transparent 100%);
      pointer-events: none;
    }

    .hero-3d-mount {
      display: block;
      position: absolute;
      z-index: 1;
      overflow: hidden;
      opacity: 0;
      pointer-events: auto;
      transition: opacity 900ms var(--ease-marvel, ease);
    }

    .hero-3d-mount.is-active {
      opacity: 1;
    }

    .hero-3d-mount :global(canvas) {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }

    /* Side content — absolute, left of the monitor */
    .hero-side {
      position: absolute;
      top: 50%;
      left: 4rem;
      transform: translateY(-50%);
      z-index: 30;
      max-width: 32rem;
      width: auto;
      pointer-events: none;
      margin: 0;
      margin-top: 1rem; /* Compensa nav principal (~70px) */
    }

    .side-lead {
      pointer-events: auto;
    }

    .side-ctas {
      pointer-events: auto;
      width: auto;
    }

    .side-title {
      font-size: clamp(2.75rem, 6vw, 5.5rem);
      line-height: 0.9;
    }

    .side-kicker {
      pointer-events: auto;
    }

    /* Bottom bar — floating, centered */
    .hero-bottom-bar {
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      max-width: 1000px;
      width: calc(100% - 3rem);
      padding: 0.875rem 1.5rem;
    }

    .bb-stats {
      gap: 1.25rem;
      justify-content: flex-start;
    }

    .bb-stat {
      text-align: left;
      flex: 0 0 auto;
    }

    .bb-stat-num {
      font-size: 1.5rem;
    }

    .bb-stat-label {
      font-size: 0.55rem;
      letter-spacing: 0.18em;
      overflow-wrap: normal;
    }

    .bb-divider {
      display: block;
      width: 1px;
      height: 28px;
      background: rgba(255,255,255,0.1);
      flex: 0 0 auto;
    }

    .bb-cta-wrap {
      display: flex;
      align-items: center;
    }

    .bb-status {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--color-secondary);
    }

    .bb-pulse {
      width: 6px;
      height: 6px;
      background: var(--color-secondary);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--color-secondary);
    }
  }

  /* Tablet breakpoint — between mobile-first and desktop full */
  @media (min-width: 821px) and (max-width: 1023px) {
    .hero-side {
      left: clamp(1.25rem, 4vw, 2rem);
      max-width: 24rem;
    }
  }
    .side-title { font-size: clamp(1.85rem, 11vw, 2.35rem); }
    .side-ctas { flex-direction: column; }
    .side-btn-primary,
    .side-btn-ghost { width: 100%; }
    .bb-stats { gap: 0.35rem; }
    .bb-stat-num { font-size: 0.95rem; }
    .bb-stat-label { font-size: 0.4rem; }
  }

  @media (max-height: 700px) and (max-width: 820px) {
    .hero-section { min-height: 40rem; }
    .side-title { font-size: clamp(1.9rem, 9vh, 2.8rem); }
    .side-lead { margin-bottom: 0.75rem; }
  }
</style>

<script>
  type HeroAnalyticsWindow = typeof window & {
    __heroAnalyticsClickHandler?: (event: MouseEvent) => void;
    __heroAnalyticsPageLoadHandler?: () => void;
  };

  const analyticsWindow = window as HeroAnalyticsWindow;

  function bindHeroAnalytics() {
    if (analyticsWindow.__heroAnalyticsClickHandler) {
      document.removeEventListener('click', analyticsWindow.__heroAnalyticsClickHandler);
    }

    analyticsWindow.__heroAnalyticsClickHandler = (event: MouseEvent) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest<HTMLElement>('[data-hero-analytics]');
      if (!link) return;

      const locale = link.dataset.locale;
      const placement = link.dataset.heroAnalytics;
      if ((locale !== 'es' && locale !== 'en') || (placement !== 'primary' && placement !== 'portfolio')) return;

      window.plausible?.('Hero CTA Click', { props: { locale, placement } });
    };

    document.addEventListener('click', analyticsWindow.__heroAnalyticsClickHandler);
  }

  if (analyticsWindow.__heroAnalyticsPageLoadHandler) {
    document.removeEventListener('astro:page-load', analyticsWindow.__heroAnalyticsPageLoadHandler);
  }
  analyticsWindow.__heroAnalyticsPageLoadHandler = bindHeroAnalytics;
  document.addEventListener('astro:page-load', analyticsWindow.__heroAnalyticsPageLoadHandler);
  bindHeroAnalytics();
</script>

<script>
  /**
   * Capa 3D del hero (progressive enhancement).
   * Monta Code3D (src/scripts/three/code3D.ts) exactamente sobre el
   * rectángulo de la pantalla del monitor en la foto de fondo, solo en
   * desktop (>820px), sin prefers-reduced-motion, y si WebGL está
   * disponible. Se re-posiciona en resize y se limpia/remonta en cada
   * navegación de Astro (astro:page-load) para no perder contextos WebGL.
   */
  import type { Code3D as Code3DType } from '../scripts/three/code3D';

  type Hero3DWindow = typeof window & {
    __hero3DPageLoadHandler?: () => void;
    __hero3DResizeHandler?: () => void;
  };

  // Rectángulo de la pantalla dentro de cada foto fuente, en píxeles nativos
  // de la imagen (medido sobre hero-mockup.jpg / hero-mockup-ultrawide.jpg).
  const SCREEN_BOX = {
    standard: { iw: 1264, ih: 848, x0: 306, y0: 181, x1: 964, y1: 569 },
    ultrawide: { iw: 3840, ih: 1646, x0: 1267, y0: 345, x1: 2568, y1: 1152 },
  } as const;

  const heroWindow = window as Hero3DWindow;

  let instance: Code3DType | null = null;
  let mountEl: HTMLElement | null = null;

  function pickBox() {
    const ar = window.innerWidth / Math.max(window.innerHeight, 1);
    return ar >= 17 / 9 ? SCREEN_BOX.ultrawide : SCREEN_BOX.standard;
  }

  function supportsWebGL(): boolean {
    try {
      const canvas = document.createElement('canvas');
      return !!(
        window.WebGLRenderingContext &&
        (canvas.getContext('webgl') || canvas.getContext('experimental-webgl'))
      );
    } catch {
      return false;
    }
  }

  function shouldEnable3D(): boolean {
    return (
      window.matchMedia('(min-width: 821px)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      supportsWebGL()
    );
  }

  function updatePosition(section: HTMLElement) {
    if (!mountEl) return;
    const rect = section.getBoundingClientRect();
    const box = pickBox();
    const scale = Math.max(rect.width / box.iw, rect.height / box.ih);
    const dispW = box.iw * scale;
    const dispH = box.ih * scale;
    const offX = (rect.width - dispW) / 2;
    const offY = (rect.height - dispH) / 2;

    mountEl.style.left = `${offX + box.x0 * scale}px`;
    mountEl.style.top = `${offY + box.y0 * scale}px`;
    mountEl.style.width = `${(box.x1 - box.x0) * scale}px`;
    mountEl.style.height = `${(box.y1 - box.y0) * scale}px`;
  }

  async function mount() {
    if (instance || !mountEl) return;
    try {
      const { Code3D } = await import('../scripts/three/code3D');
      if (!mountEl || instance) return; // re-check tras el import async
      instance = new Code3D({ container: mountEl, density: 'low' });
      requestAnimationFrame(() => mountEl?.classList.add('is-active'));
    } catch (err) {
      console.warn('[hero-3d] No se pudo montar la escena 3D, se mantiene la imagen estática.', err);
    }
  }

  function teardown() {
    instance?.dispose();
    instance = null;
    mountEl?.classList.remove('is-active');
  }

  function setup() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    mountEl = section?.querySelector<HTMLElement>('[data-hero-3d]') ?? null;
    if (!section || !mountEl) return;

    updatePosition(section);
    if (shouldEnable3D()) {
      mount();
    }

    if (heroWindow.__hero3DResizeHandler) {
      window.removeEventListener('resize', heroWindow.__hero3DResizeHandler);
      window.removeEventListener('orientationchange', heroWindow.__hero3DResizeHandler);
    }

    let resizeRaf = 0;
    heroWindow.__hero3DResizeHandler = () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => {
        updatePosition(section);
        if (shouldEnable3D()) {
          mount();
        } else if (instance) {
          teardown();
        }
      });
    };
    window.addEventListener('resize', heroWindow.__hero3DResizeHandler);
    window.addEventListener('orientationchange', heroWindow.__hero3DResizeHandler);
  }

  if (heroWindow.__hero3DPageLoadHandler) {
    document.removeEventListener('astro:page-load', heroWindow.__hero3DPageLoadHandler);
  }
  heroWindow.__hero3DPageLoadHandler = () => {
    teardown();
    setup();
  };
  document.addEventListener('astro:page-load', heroWindow.__hero3DPageLoadHandler);
  setup();

  document.addEventListener('astro:before-swap', () => teardown(), { once: false });
</script>
