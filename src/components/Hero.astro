---
import Icon from './Icon.astro';
import CompileBadge from './CompileBadge.astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-30"></div>
  <div class="absolute inset-0 hero-gradient"></div>
  
  <style>
  .terminal-snippet {
    position: relative;
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: rgb(34, 197, 94);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgba(34, 197, 94, 0.2);
  }

  .terminal-dots {
    display: flex;
    gap: 0.25rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .red { background-color: #ef4444; }
  .yellow { background-color: #eab308; }
  .green { background-color: #22c55e; }

  .terminal-title {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.6875rem;
    font-weight: 500;
  }

  .terminal-body {
    line-height: 1.5;
  }

  .line {
    display: flex;
    align-items: center;
  }

  .line-number {
    display: inline-block;
    width: 2rem;
    color: rgba(34, 197, 94, 0.5);
    text-align: right;
    margin-right: 0.5rem;
    user-select: none;
  }

  .line-content {
    flex: 1;
  }

  .typewriter-text {
    display: inline-block;
  }

  .cursor {
    display: inline-block;
    margin-left: 0.25rem;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .animate-terminal-scroll {
    animation: terminal-scroll 25s linear infinite;
  }

  /* 3D Gyroscope animations & classes */
  .animate-gyro-global {
    animation: gyro-global 8s ease-in-out infinite;
  }

  .animate-spin-gyro-x {
    animation: spin-gyro-x 12s linear infinite;
  }

  .animate-spin-gyro-y {
    animation: spin-gyro-y 15s linear infinite;
  }

  .animate-spin-gyro-z {
    animation: spin-gyro-z 18s linear infinite;
  }

  .animate-hologram-pulse {
    animation: hologram-pulse 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .animate-bracket-pulse {
    animation: bracket-pulse 3s ease-in-out infinite;
  }

  .animate-glow-pulse {
    animation: glow-pulse 2s ease-in-out infinite;
  }

  @keyframes gyro-global {
    0%, 100% {
      transform: rotateX(15deg) rotateY(-10deg);
    }
    50% {
      transform: rotateX(25deg) rotateY(10deg);
    }
  }

  @keyframes spin-gyro-x {
    0% {
      transform: rotateX(70deg) rotateY(10deg) rotateZ(0deg);
    }
    100% {
      transform: rotateX(70deg) rotateY(10deg) rotateZ(360deg);
    }
  }

  @keyframes spin-gyro-y {
    0% {
      transform: rotateX(20deg) rotateY(70deg) rotateZ(360deg);
    }
    100% {
      transform: rotateX(20deg) rotateY(70deg) rotateZ(0deg);
    }
  }

  @keyframes spin-gyro-z {
    0% {
      transform: rotateX(45deg) rotateY(-45deg) rotateZ(0deg);
    }
    100% {
      transform: rotateX(45deg) rotateY(-45deg) rotateZ(360deg);
    }
  }

  @keyframes hologram-pulse {
    0% {
      transform: scale(0.8);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @keyframes bracket-pulse {
    0%, 100% {
      opacity: 0.4;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.05);
    }
  }

  @keyframes glow-pulse {
    0%, 100% {
      filter: drop-shadow(0 0 5px currentColor);
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      filter: drop-shadow(0 0 20px currentColor);
      transform: translate(-50%, -50%) scale(1.3);
    }
  }

  /* Circuit flow animations */
  .animate-pulse-flow-1 {
    stroke-dasharray: 8 32;
    stroke-dashoffset: 40;
    animation: flow-key 3s linear infinite;
  }
  
  .animate-pulse-flow-2 {
    stroke-dasharray: 8 32;
    stroke-dashoffset: 40;
    animation: flow-key 3s linear infinite;
    animation-delay: 1s;
  }
  
  .animate-pulse-flow-3 {
    stroke-dasharray: 8 32;
    stroke-dashoffset: 40;
    animation: flow-key 3s linear infinite;
    animation-delay: 2s;
  }

  @keyframes flow-key {
    0% {
      stroke-dashoffset: 40;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }
  </style>
  
  <div class="max-w-7xl mx-auto px-8 relative z-10 grid lg:grid-cols-2 gap-12 items-center">
    <div class="space-y-8">
      <CompileBadge />
      
      <div class="terminal-snippet">
        <div class="terminal-header">
          <div class="terminal-dots">
            <div class="dot red"></div>
            <div class="dot yellow"></div>
            <div class="dot green"></div>
          </div>
          <span class="terminal-title">astro.config.ts</span>
        </div>
        <div class="terminal-body">
          <div class="line">
            <span class="line-number">1</span>
            <span class="line-content">{"import { BlogPost } from '../content/posts'"}</span>
          </div>
          <div class="line">
            <span class="line-number">2</span>
            <span class="line-content">import Contact from '../components/Contact.astro'</span>
          </div>
          <div class="line">
            <span class="line-number">3</span>
            <span class="line-content">{"import { CompileBadge } from '../components/CompileBadge.astro'"}</span>
          </div>
        </div>
      </div>
      
      <h1 class="font-headline text-[2.5rem] md:text-[3.5rem] lg:text-[4.5rem] leading-[1.05] tracking-tight font-bold text-on-surface">
        <span id="hero-typewriter-1" class="typewriter-text">Ingeniería de software & </span><span id="hero-typewriter-2" class="text-primary typewriter-text">automatización con IA</span>
        <span class="cursor">|</span>
      </h1>
      
      <p class="text-on-surface-variant text-lg max-w-lg font-body leading-relaxed">
        Creamos aplicaciones web de alto rendimiento, apps móviles multiplataforma y automatizaciones avanzadas que optimizan y escalan tu negocio.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-4">
        <a href="#contacto" class="btn-primary">
          Iniciá tu Proyecto
        </a>
        <a href="#soluciones" class="btn-secondary">
          Nuestros Servicios
        </a>
      </div>
    </div>
    
    <div class="relative hidden lg:block">
      <div class="aspect-square relative">
        <!-- Animated gradient glow -->
        <div class="absolute inset-0 bg-primary/10 blur-[100px] rounded-full animate-pulse-slow"></div>
        
        <!-- 3D-style geometric visualization -->
        <div class="w-full h-full relative rounded-card border border-white/10 bg-gradient-to-br from-surface-container-low to-black overflow-hidden">
          <!-- Grid overlay -->
          <div class="absolute inset-0 grid-bg opacity-20"></div>
          
          <!-- Terminal scrolling backdrop -->
          <div class="absolute inset-0 font-mono text-[0.625rem] text-primary/5 select-none pointer-events-none overflow-hidden p-4">
            <div class="animate-terminal-scroll space-y-2">
              <div>&gt; npm run build</div>
              <div>[astro] Ready to build...</div>
              <div>[content] Syncing content</div>
              <div>[content] Synced content</div>
              <div>[astro] Building...</div>
              <div>[vite] Transforming code...</div>
              <div>[vite] Bundling scripts...</div>
              <div>[vite] Generating styles...</div>
              <div>[astro] Rendering pages...</div>
              <div>✓ /index.html (452ms)</div>
              <div>✓ /404.html (103ms)</div>
              <div>✓ sitemap-index.xml (12ms)</div>
              <div>✓ Completed build in 2.14s</div>
              <div>&gt; system status: ACTIVE</div>
              <div>&gt; compiling components...</div>
              <div>&gt; optimizing bundle sizes...</div>
              <div>✓ success: 0 dependencies warnings</div>
              <!-- Duplicate to repeat and scroll seamlessly -->
              <div>&gt; npm run build</div>
              <div>[astro] Ready to build...</div>
              <div>[content] Syncing content</div>
              <div>[content] Synced content</div>
              <div>[astro] Building...</div>
              <div>[vite] Transforming code...</div>
              <div>[vite] Bundling scripts...</div>
              <div>[vite] Generating styles...</div>
              <div>[astro] Rendering pages...</div>
              <div>✓ /index.html (452ms)</div>
              <div>✓ /404.html (103ms)</div>
              <div>✓ sitemap-index.xml (12ms)</div>
              <div>✓ Completed build in 2.14s</div>
              <div>&gt; system status: ACTIVE</div>
              <div>&gt; compiling components...</div>
              <div>&gt; optimizing bundle sizes...</div>
              <div>✓ success: 0 dependencies warnings</div>
            </div>
          </div>
          
          <!-- Specialty Nodes SVG Connection Lines -->
          <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 100 100" preserveAspectRatio="none">
            <!-- Path 1: Software -> Core -->
            <path d="M 18 18 L 50 50" class="stroke-primary/10 stroke-[0.3] fill-none" />
            <path d="M 18 18 L 50 50" class="stroke-primary stroke-[0.6] fill-none animate-pulse-flow-1" />

            <!-- Path 2: AI -> Core -->
            <path d="M 82 18 L 50 50" class="stroke-primary/10 stroke-[0.3] fill-none" />
            <path d="M 82 18 L 50 50" class="stroke-secondary stroke-[0.6] fill-none animate-pulse-flow-2" />

            <!-- Path 3: Domótica/Solar -> Core -->
            <path d="M 50 82 L 50 50" class="stroke-primary/10 stroke-[0.3] fill-none" />
            <path d="M 50 82 L 50 50" class="stroke-[rgb(234,179,8)] stroke-[0.6] fill-none animate-pulse-flow-3" />
          </svg>

          <!-- Specialty Node 1: Software (Top-Left) -->
          <div class="absolute top-[18%] left-[18%] -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-1 group z-10 cursor-pointer">
            <div class="w-9 h-9 rounded-full bg-surface-container border border-primary/30 flex items-center justify-center shadow-[0_0_15px_rgba(0,255,255,0.08)] group-hover:shadow-[0_0_20px_rgba(0,255,255,0.35)] group-hover:border-primary transition-all duration-300">
              <Icon name="code" class="w-4 h-4 text-primary" />
            </div>
            <span class="text-[7px] font-mono text-on-surface-variant uppercase tracking-widest bg-black/60 px-1 rounded border border-white/5 opacity-80 group-hover:opacity-100 group-hover:text-primary transition-all">Software</span>
          </div>

          <!-- Specialty Node 2: AI (Top-Right) -->
          <div class="absolute top-[18%] right-[18%] translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-1 group z-10 cursor-pointer">
            <div class="w-9 h-9 rounded-full bg-surface-container border border-secondary/30 flex items-center justify-center shadow-[0_0_15px_rgba(0,253,135,0.08)] group-hover:shadow-[0_0_20px_rgba(0,253,135,0.35)] group-hover:border-secondary transition-all duration-300">
              <Icon name="psychology" class="w-4 h-4 text-secondary" />
            </div>
            <span class="text-[7px] font-mono text-on-surface-variant uppercase tracking-widest bg-black/60 px-1 rounded border border-white/5 opacity-80 group-hover:opacity-100 group-hover:text-secondary transition-all">Sistemas IA</span>
          </div>

          <!-- Specialty Node 3: Domótica & Solar (Bottom-Center) -->
          <div class="absolute bottom-[18%] left-1/2 -translate-x-1/2 translate-y-1/2 flex flex-col items-center gap-1 group z-10 cursor-pointer">
            <div class="w-9 h-9 rounded-full bg-surface-container border-[rgb(234,179,8)]/30 flex items-center justify-center shadow-[0_0_15px_rgba(234,179,8,0.08)] group-hover:shadow-[0_0_20px_rgba(234,179,8,0.35)] group-hover:border-[rgb(234,179,8)] transition-all duration-300">
              <Icon name="bolt" class="w-4 h-4 text-[rgb(234,179,8)]" />
            </div>
            <span class="text-[7px] font-mono text-on-surface-variant uppercase tracking-widest bg-black/60 px-1 rounded border border-white/5 opacity-80 group-hover:opacity-100 group-hover:text-[rgb(234,179,8)] transition-all">IoT & Solar</span>
          </div>

          <!-- 3D Gyroscope & Holographic Core System -->
          <div class="absolute inset-0 flex items-center justify-center [perspective:1000px] z-0">
            <div class="relative w-48 h-48 [transform-style:preserve-3d] animate-gyro-global">
              
              <!-- Central Pulsing Core (Double layered) -->
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 rounded-full bg-gradient-to-br from-primary/30 via-secondary/10 to-transparent border border-primary/40 [transform-style:preserve-3d] animate-float relative flex items-center justify-center shadow-[0_0_40px_rgba(0,255,255,0.12)]">
                <!-- Inner core glow -->
                <div class="absolute w-16 h-16 rounded-full bg-secondary/15 blur-md animate-pulse"></div>
                <!-- Holographic scanner ring pulse -->
                <div class="absolute w-full h-full rounded-full border border-secondary/40 animate-hologram-pulse"></div>
              </div>
              
              <!-- 3D Gyroscope Ring 1 (X-Axis) -->
              <div class="absolute inset-0 border border-primary/20 rounded-full [transform:rotateX(70deg)_rotateY(10deg)] [transform-style:preserve-3d] animate-spin-gyro-x">
                <!-- Orbiting node 1 -->
                <div class="absolute top-0 left-1/2 w-2.5 h-2.5 rounded-full bg-primary text-primary animate-glow-pulse"></div>
              </div>
              
              <!-- 3D Gyroscope Ring 2 (Y-Axis) -->
              <div class="absolute inset-2 border border-secondary/20 rounded-full [transform:rotateX(20deg)_rotateY(70deg)] [transform-style:preserve-3d] animate-spin-gyro-y">
                <!-- Orbiting node 2 -->
                <div class="absolute bottom-0 left-1/2 w-2.5 h-2.5 rounded-full bg-secondary text-secondary animate-glow-pulse"></div>
              </div>
              
              <!-- 3D Gyroscope Ring 3 (Diagonal) -->
              <div class="absolute inset-4 border border-primary/10 rounded-full [transform:rotateX(45deg)_rotateY(-45deg)] [transform-style:preserve-3d] animate-spin-gyro-z">
                <!-- Orbiting node 3 -->
                <div class="absolute left-0 top-1/2 w-2 h-2 rounded-full bg-primary-dim text-primary-dim animate-glow-pulse"></div>
              </div>

              <!-- Tech Target / Crosshair Overlays -->
              <div class="absolute -inset-3 border border-dashed border-white/5 rounded-full animate-spin-slow"></div>
              <div class="absolute -inset-6 border border-white/5 rounded-full animate-spin-reverse opacity-50"></div>
              
              <!-- Corner accents (Holographic bracket style) -->
              <div class="absolute -top-1 -left-1 w-4 h-4 border-t-2 border-l-2 border-primary/40 rounded-tl-sm animate-bracket-pulse"></div>
              <div class="absolute -top-1 -right-1 w-4 h-4 border-t-2 border-r-2 border-primary/40 rounded-tr-sm animate-bracket-pulse"></div>
              <div class="absolute -bottom-1 -left-1 w-4 h-4 border-b-2 border-l-2 border-secondary/40 rounded-bl-sm animate-bracket-pulse" style="animation-delay: 0.5s"></div>
              <div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-secondary/40 rounded-br-sm animate-bracket-pulse" style="animation-delay: 0.5s"></div>
            </div>
          </div>
          
          <!-- Scan line effect -->
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent h-32 animate-scan"></div>
        </div>
        
        <!-- Floating badge with icon -->
        <div class="absolute -bottom-6 -left-6 bg-surface-container p-6 border border-white/5 shadow-2xl rounded-card max-w-xs glass-effect hover:scale-105 transition-transform">
          <Icon name="terminal" class="w-10 h-10 text-secondary mb-4 block" />
          <p class="text-sm font-label text-on-surface-variant leading-snug italic">
            "Transformamos ideas complejas en código de alto rendimiento."
          </p>
        </div>
      </div>
    </div>
  </div>
  
  <script>
  import { typeWriter } from '../scripts/heroScript';

  // Run typewriter effect after a short delay
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const span1 = document.getElementById('hero-typewriter-1');
      const span2 = document.getElementById('hero-typewriter-2');
      if (span1 && span2) {
        typeWriter([
          { element: span1, text: 'Ingeniería de software & ' },
          { element: span2, text: 'automatización con IA' }
        ]);
      }
    }, 300);
  });
  </script>
</section>
