---
/**
 * Hero.astro — Mockup Edition v5 (Clean overlay)
 * La imagen mockup ocupa todo el viewport como background.
 * El contenido web (headline + CTAs + stats) va DEBAJO como un overlay
 * semi-transparente centrado sobre la imagen, NO se superpone con el monitor.
 */

import Icon from './Icon.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';
const copy = {
  es: {
    kicker: 'SISTEMAS AUTÓNOMOS · 01',
    title: ['Construí', 'el futuro', 'digital'],
    lead: 'Software a medida, automatizaciones con IA y experiencias digitales que escalan tu negocio.',
    primary: 'Iniciá tu Proyecto',
    secondary: 'Ver Portfolio',
    stats: ['Proyectos', 'PageSpeed', 'Uptime', 'Deploys/mes'],
    status: 'SISTEMAS EN ÓRBITA',
    contactHref: '#contacto',
    portfolioHref: '#portfolio',
  },
  en: {
    kicker: 'AUTONOMOUS SYSTEMS · 01',
    title: ['Build', 'the digital', 'future'],
    lead: 'Custom software, AI automation, and digital experiences that scale your business.',
    primary: 'Start your Project',
    secondary: 'View Portfolio',
    stats: ['Projects', 'PageSpeed', 'Uptime', 'Deploys/mo'],
    status: 'SYSTEMS IN ORBIT',
    contactHref: '/en#contacto',
    portfolioHref: '/en#portfolio',
  },
}[locale];
---

<section class="hero-section" data-hero>
  <!-- Background full bleed — WebP con fallback -->
  <picture class="hero-bg" aria-hidden="true">
    <source srcset="/hero-mockup.webp" type="image/webp" />
    <source srcset="/hero-mockup.jpg" type="image/jpeg" />
    <img src="/hero-mockup.jpg" alt="" class="hero-bg-img" loading="eager" decoding="async" fetchpriority="high" width="1264" height="848" />
    <div class="hero-bg-top-fade" aria-hidden="true"></div>
  </picture>

  <!-- Side content: title + copy + CTAs (no se superpone con el monitor) -->
  <div class="hero-side" data-hero-side>
    <span class="side-kicker" data-hero-kicker>
      <span class="side-kicker-dot"></span>
      <span class="side-kicker-text font-mono">{copy.kicker}</span>
    </span>

    <h1 class="side-title font-display" data-hero-title>
      <span class="side-line" data-side-line>
        <span class="side-word">{copy.title[0]}</span>
      </span>
      <span class="side-line" data-side-line>
        <span class="side-word side-accent">{copy.title[1]}</span>
      </span>
      <span class="side-line" data-side-line>
        <span class="side-word">{copy.title[2]}</span>
      </span>
    </h1>

    <p class="side-lead" data-hero-lead>
      {copy.lead}
    </p>

    <div class="side-ctas" data-hero-ctas>
      <a href={copy.contactHref} class="side-btn-primary magnetic" data-magnetic>
        <Icon name="bolt" class="w-4 h-4" />
        <span>{copy.primary}</span>
      </a>
      <a href={copy.portfolioHref} class="side-btn-ghost magnetic" data-magnetic>
        <span>{copy.secondary}</span>
        <Icon name="arrow_forward" class="w-4 h-4" />
      </a>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="hero-bottom-bar" data-hero-bottom>
    <div class="bb-stats">
      <div class="bb-stat">
        <div class="bb-stat-num font-display">15<span class="bb-stat-plus">+</span></div>
        <div class="bb-stat-label">{copy.stats[0]}</div>
      </div>
      <div class="bb-divider"></div>
      <div class="bb-stat">
        <div class="bb-stat-num font-display text-shine">99<span class="bb-stat-suffix">/100</span></div>
        <div class="bb-stat-label">{copy.stats[1]}</div>
      </div>
      <div class="bb-divider"></div>
      <div class="bb-stat">
        <div class="bb-stat-num font-display">99.9<span class="bb-stat-suffix">%</span></div>
        <div class="bb-stat-label">{copy.stats[2]}</div>
      </div>
      <div class="bb-divider"></div>
      <div class="bb-stat">
        <div class="bb-stat-num font-display">38</div>
        <div class="bb-stat-label">{copy.stats[3]}</div>
      </div>
    </div>
    <div class="bb-cta-wrap">
      <span class="bb-status font-mono">
        <span class="bb-pulse"></span>
        {copy.status}
      </span>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    height: 100vh;
    min-height: 700px;
    width: 100%;
    max-width: 1920px; /* limita el ancho: en ultrawide evita que la imagen se recorte demasiado */
    margin-inline: auto; /* centra en viewports > 1920px */
    overflow: hidden;
    background: #0a0508;
  }

  /* Background full bleed — <picture> container */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    overflow: hidden;
    background: #0a0508; /* fallback mientras carga la imagen */
  }

  .hero-bg-img {
    /* Cubre todo el hero preservando el aspect ratio (recorta lo que sobra) */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Fade oscuro arriba para tapar el borde superior del monitor */
  .hero-bg-top-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(180deg, #0a0508 0%, rgba(10,5,8,0.8) 50%, transparent 100%);
    pointer-events: none;
  }

  /* ─── Side content (izquierda, fuera del monitor) ─── */
  .hero-side {
    position: absolute;
    top: 50%;
    left: 4rem;
    transform: translateY(-50%);
    z-index: 20;
    max-width: 32rem;
    pointer-events: none;
    /* Compensar el nav principal de la página (~70px) */
    margin-top: 1rem;
  }

  .side-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.4rem 0.875rem;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    opacity: 0;
    pointer-events: auto;
  }

  .side-kicker-dot {
    width: 6px;
    height: 6px;
    background: var(--color-secondary);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-secondary);
    animation: kicker-pulse 2s ease-in-out infinite;
  }

  @keyframes kicker-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .side-kicker-text {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: rgba(255,255,255,0.7);
  }

  .side-title {
    font-weight: 900;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.25rem;
    text-shadow: 0 4px 24px rgba(0,0,0,0.7);
  }

  .side-line {
    display: block;
  }

  .side-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
  }

  .side-accent {
    background: linear-gradient(135deg, #FFFFFF 0%, #FF6B9D 50%, #B14EFF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(255,107,157,0.5));
  }

  .side-lead {
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    line-height: 1.6;
    color: rgba(255,255,255,0.75);
    max-width: 28rem;
    margin: 0 0 1.5rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
    opacity: 0;
    pointer-events: auto;
  }

  .side-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    pointer-events: auto;
    opacity: 0;
  }

  .side-btn-primary,
  .side-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .side-btn-primary {
    background: #FFFFFF;
    color: #0a0a0a;
    box-shadow: 0 8px 24px -4px rgba(0,0,0,0.4);
  }

  .side-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.2);
  }

  .side-btn-ghost {
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(12px);
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.2);
  }

  .side-btn-ghost:hover {
    background: rgba(0,0,0,0.6);
    border-color: rgba(255,255,255,0.3);
    transform: translateY(-2px);
  }

  .magnetic { transition: transform 0.3s var(--ease-marvel); }

  /* ─── Bottom bar ─── */
  .hero-bottom-bar {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 1rem;
    box-shadow: 0 24px 48px -12px rgba(0,0,0,0.7);
    max-width: 1000px;
    width: calc(100% - 3rem);
    opacity: 0;
  }

  .bb-stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .bb-stat { text-align: left; }

  .bb-stat-num {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    color: #FFFFFF;
  }

  .bb-stat-plus, .bb-stat-suffix {
    font-size: 0.75rem;
    color: var(--color-marvel-gold);
  }

  .bb-stat-label {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.4);
    font-family: var(--font-mono);
    margin-top: 0.2rem;
  }

  .bb-divider {
    width: 1px;
    height: 28px;
    background: rgba(255,255,255,0.1);
  }

  .bb-cta-wrap {
    display: flex;
    align-items: center;
  }

  .bb-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-secondary);
  }

  .bb-pulse {
    width: 6px;
    height: 6px;
    background: var(--color-secondary);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-secondary);
    animation: kicker-pulse 2s ease-in-out infinite;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .hero-side {
      left: clamp(1.25rem, 4vw, 2rem);
      max-width: 24rem;
    }
  }

  @media (max-width: 820px) {
    .hero-section {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 100svh;
      min-height: 100dvh;
      padding: 5rem 1rem calc(1rem + env(safe-area-inset-bottom));
    }
    .hero-bg-img {
      width: min(100%, 52rem);
      max-height: 72vh;
      object-position: center;
    }
    .hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(10,5,8,0.2) 0%, rgba(10,5,8,0.06) 36%, rgba(10,5,8,0.92) 82%),
        linear-gradient(90deg, rgba(10,5,8,0.72) 0%, rgba(10,5,8,0.16) 54%, rgba(10,5,8,0.56) 100%);
      pointer-events: none;
    }
    .hero-side {
      position: relative;
      inset: auto;
      transform: none;
      width: min(100%, 34rem);
      max-width: none;
      margin: auto auto clamp(1rem, 3vh, 1.75rem);
    }
    .hero-bottom-bar {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      width: min(100%, 44rem);
      max-width: none;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .side-title {
      font-size: clamp(2.05rem, 12vw, 3.25rem);
      line-height: 0.95;
      margin-bottom: 0.875rem;
    }
    .side-kicker-text {
      font-size: clamp(0.52rem, 2.4vw, 0.62rem);
      letter-spacing: 0.16em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .side-lead {
      font-size: clamp(0.875rem, 3.6vw, 1rem);
      line-height: 1.5;
      margin-bottom: 1rem;
    }
    .side-ctas {
      width: 100%;
      gap: 0.5rem;
    }
    .side-btn-primary,
    .side-btn-ghost {
      min-height: 2.75rem;
      font-size: clamp(0.74rem, 3.2vw, 0.875rem);
      padding: 0.72rem 0.9rem;
      flex: 1 1 9.5rem;
      justify-content: center;
      white-space: nowrap;
    }
    .hero-bottom-bar {
      padding: 0.625rem 0.75rem;
      width: 100%;
      border-radius: 0.875rem;
    }
    .bb-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.5rem;
      width: 100%;
    }
    .bb-stat {
      min-width: 0;
      text-align: center;
    }
    .bb-stat-num {
      font-size: clamp(0.95rem, 4.5vw, 1.125rem);
    }
    .bb-stat-label {
      font-size: clamp(0.42rem, 1.9vw, 0.5rem);
      letter-spacing: 0.08em;
      overflow-wrap: anywhere;
    }
    .bb-divider,
    .bb-cta-wrap {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .hero-section { padding-inline: 0.75rem; }
    .side-title { font-size: clamp(1.85rem, 11vw, 2.35rem); }
    .side-ctas { flex-direction: column; }
    .side-btn-primary,
    .side-btn-ghost { width: 100%; }
    .bb-stats { gap: 0.35rem; }
    .bb-stat-num { font-size: 0.95rem; }
    .bb-stat-label { font-size: 0.4rem; }
  }

  @media (max-height: 700px) and (max-width: 820px) {
    .hero-section { min-height: 40rem; }
    .side-title { font-size: clamp(1.9rem, 9vh, 2.8rem); }
    .side-lead { margin-bottom: 0.75rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initHero() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    if (!section) return;

    if (prefersReducedMotion) {
      gsap.set([
        '[data-hero-kicker]',
        '[data-side-line] .side-word',
        '[data-hero-lead]',
        '[data-hero-ctas]',
        '[data-hero-bottom]',
      ], { opacity: 1, y: 0 });
      return;
    }

    // ── Entrance timeline ──
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.to('[data-hero-kicker]', { opacity: 1, y: 0, duration: 0.6 }, 0.4);
    tl.to('[data-side-line] .side-word', {
      opacity: 1, y: 0, duration: 0.9,
      stagger: 0.1, ease: 'expo.out',
    }, 0.6);
    tl.to('[data-hero-lead]', { opacity: 1, y: 0, duration: 0.7 }, 1.0);
    tl.to('[data-hero-ctas]', { opacity: 1, y: 0, duration: 0.7 }, 1.1);
    tl.to('[data-hero-bottom]', { opacity: 1, y: 0, duration: 0.7 }, 1.3);

    // Magnetic
    const magneticEls = section.querySelectorAll<HTMLElement>('[data-magnetic]');
    magneticEls.forEach((el) => {
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(el, { x: x * 0.2, y: y * 0.2, duration: 0.35, ease: 'power2.out' });
      });
      el.addEventListener('mouseleave', () => {
        gsap.to(el, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.4)' });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
