---
/**
 * TrustSignals.astro - Versión Marvel
 * Métricas con números en gold shine, chips con glow, divider cinemático
 */

import Icon from './Icon.astro';

const stats = [
  { value: "15+", label: "Proyectos Entregados" },
  { value: "3+", label: "Clientes en Producción" },
  { value: "<24h", label: "Tiempo de Respuesta" },
  { value: "20+", label: "Tecnologías Dominadas" }
];
---

<section class="py-20 bg-surface border-y border-white/5 relative overflow-hidden" data-trust>
  <div class="trust-bg" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-8 relative z-10">
    <div class="trust-stats">
      {stats.map((stat) => (
        <div class="trust-stat" data-trust-stat>
          <div class="trust-stat-num font-display text-shine">{stat.value}</div>
          <div class="trust-stat-label">{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="trust-divider" aria-hidden="true">
      <div class="trust-divider-bar"></div>
      <div class="trust-divider-diamond">◆</div>
      <div class="trust-divider-bar"></div>
    </div>

    <div class="trust-chips">
      <div class="trust-chip">
        <Icon name="code" class="w-5 h-5" />
        <span>Open Source</span>
      </div>
      <div class="trust-chip">
        <Icon name="deployed_code" class="w-5 h-5" />
        <span>CI/CD Automático</span>
      </div>
      <div class="trust-chip">
        <Icon name="cloud" class="w-5 h-5" />
        <span>Cloud &amp; Self-Hosted</span>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(248, 180, 0, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .trust-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .trust-stats { grid-template-columns: repeat(4, 1fr); }
  }

  .trust-stat {
    transition: transform 0.3s var(--ease-marvel);
  }
  .trust-stat:hover { transform: translateY(-4px); }

  .trust-stat-num {
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .trust-stat-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .trust-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2.5rem auto;
    max-width: 28rem;
  }
  .trust-divider-bar {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--color-marvel-gold) 50%, transparent 100%);
    opacity: 0.5;
  }
  .trust-divider-diamond {
    color: var(--color-marvel-gold);
    font-size: 0.75rem;
    text-shadow: 0 0 12px rgba(248, 180, 0, 0.6);
  }

  .trust-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    background: var(--color-surface-1);
    border: 1px solid rgba(248, 180, 0, 0.2);
    border-radius: 999px;
    color: var(--color-on-surface-variant);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: all 0.3s var(--ease-marvel);
  }
  .trust-chip:hover {
    border-color: var(--color-marvel-gold);
    color: #FFFFFF;
    background: rgba(248, 180, 0, 0.08);
    box-shadow: 0 0 20px rgba(248, 180, 0, 0.2);
    transform: translateY(-2px);
  }
  .trust-chip :global(svg) { color: var(--color-marvel-gold); }
</style>
