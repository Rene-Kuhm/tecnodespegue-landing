---
/** Vaulta public release downloads and verifiable security notes. */

import Icon from './Icon.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';

// Release oficial v1.0.22 (publicado 11 jun 2026) — incluye APK Android + bundle
// Windows. La release dev-latest del bot de GitHub Actions solo incluye el APK,
// por eso apuntamos a v1.0.22 para que ambos botones tengan destino real.
const APK_URL =
  'https://github.com/Rene-Kuhm/vaulta/releases/download/v1.0.22/vaulta.apk';
const WIN_URL =
  'https://github.com/Rene-Kuhm/vaulta/releases/download/v1.0.22/vaulta-windows-bundle.zip';
const RELEASE_PAGE =
  'https://github.com/Rene-Kuhm/vaulta/releases/tag/v1.0.22';
const REPO_URL =
  'https://github.com/Rene-Kuhm/vaulta';

const copy = {
  es: {
    kicker: 'APP · DISPONIBLE',
    title: ['Vaulta ya está', 'disponible'],
    lead: 'Gestor de contraseñas open source y offline-first para Android y Windows. La release documenta cifrado AES-256-GCM, derivación de clave con Argon2id y desbloqueo biométrico.',
    countdownLabel: 'Cuenta regresiva al lanzamiento',
    days: ['días', 'día'],
    hours: ['hs', 'h'],
    minutes: ['min', 'm'],
    seconds: ['seg', 's'],
    launched: '¡Ya está disponible!',
    launchedSub: 'Descargá la versión firmada de Vaulta.',
    androidCta: 'Descargar APK',
    androidSub: 'Android · vaulta.apk',
    winCta: 'Descargar para Windows',
    winSub: 'Windows x64 · vaulta-windows-bundle.zip',
    repoCta: 'Ver código y notas de release',
    securityTitle: 'Pensado para mantener tus claves a salvo',
    securityPoints: [
      'Cifrado AES-256-GCM local, sin servidores.',
      'Argon2id para derivar la clave del master password.',
      'Biometría real en Android (Android KeyStore) y Windows Hello.',
    ],
    supportBadge: 'OPEN SOURCE',
    supportTitle: '¿Te sirvió? Dejanos una ⭐ en GitHub.',
    supportText: 'Vaulta es gratis y open source. Una estrella ayuda al proyecto a crecer y nos motiva a seguir publicando software seguro y offline-first.',
    starsLabel: 'ESTRELLAS',
    starCta: 'Dar estrella en GitHub',
    loadingStars: '…',
  },
  en: {
    kicker: 'APP · AVAILABLE',
    title: ['Vaulta is', 'available now'],
    lead: "Open-source, offline-first password manager for Android and Windows. The release documents AES-256-GCM encryption, Argon2id key derivation, and biometric unlock.",
    countdownLabel: 'Countdown to launch',
    days: ['days', 'day'],
    hours: ['h', 'h'],
    minutes: ['min', 'm'],
    seconds: ['s', 's'],
    launched: 'It\'s live!',
    launchedSub: 'Download the signed Vaulta build.',
    androidCta: 'Download APK',
    androidSub: 'Android · vaulta.apk',
    winCta: 'Download for Windows',
    winSub: 'Windows x64 · vaulta-windows-bundle.zip',
    repoCta: 'View source & release notes',
    securityTitle: 'Built to keep your keys safe',
    securityPoints: [
      'Local AES-256-GCM encryption, no servers.',
      'Argon2id for master password key derivation.',
      'Real biometrics on Android (Android KeyStore) and Windows Hello.',
    ],
    supportBadge: 'OPEN SOURCE',
    supportTitle: 'Loved it? Leave us a star.',
    supportText: 'Vaulta is free and open source. A star helps the project grow and motivates us to keep shipping secure, offline-first software.',
    starsLabel: 'STARS',
    starCta: 'Star on GitHub',
    loadingStars: '…',
  },
}[locale];
---

<section class="vaulta-section py-24 md:py-32 relative overflow-hidden" id="vaulta">
  <!-- Background decorativo -->
  <div class="vaulta-bg" aria-hidden="true">
    <div class="vaulta-glow vaulta-glow-1"></div>
    <div class="vaulta-glow vaulta-glow-2"></div>
    <div class="vaulta-grid"></div>
    <div class="vaulta-vignette"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 md:px-8 relative z-10">

    <header class="vaulta-header">
      <span class="kicker">
        <span class="kicker-dot"></span>
        <span class="kicker-text font-mono">{copy.kicker}</span>
      </span>

      <h2 class="vaulta-title font-display">
        <span class="vaulta-title-line">{copy.title[0]}</span>
        <span class="vaulta-title-line vaulta-title-accent">
          <span class="vaulta-underline-wrap">
            <span class="vaulta-underline-text">{copy.title[1]}</span>
            <span class="vaulta-underline-bar" aria-hidden="true"></span>
          </span>
        </span>
      </h2>

      <p class="vaulta-lead">{copy.lead}</p>
    </header>
    <div class="vaulta-countdown is-available">
      <p class="vaulta-countdown-label font-mono">{copy.launched}</p>
      <p class="vaulta-countdown-meta font-mono">
        <Icon name="check_circle" class="w-3.5 h-3.5 inline-block align-[-2px] mr-1.5" />
        {copy.launchedSub}
      </p>
    </div>

    <!-- Signed release downloads. -->
    <div class="vaulta-ctas" data-vaulta-ctas>
      <a
        href={APK_URL}
        class="vaulta-btn vaulta-btn-primary"
        data-vaulta-android
        download="vaulta.apk"
        rel="noopener"
      >
        <span class="vaulta-btn-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M17.5 14.4c-.03-2.6 2.13-3.85 2.23-3.91-1.22-1.78-3.11-2.02-3.78-2.05-1.61-.16-3.14.94-3.96.94-.82 0-2.08-.92-3.42-.9-1.76.03-3.38 1.02-4.28 2.6-1.82 3.16-.47 7.84 1.31 10.41.86 1.26 1.88 2.67 3.22 2.62 1.29-.05 1.78-.84 3.34-.84 1.55 0 2 .84 3.36.81 1.39-.02 2.27-1.28 3.12-2.55.99-1.46 1.4-2.88 1.42-2.95-.03-.01-2.72-1.04-2.75-4.13ZM14.93 6.78c.71-.86 1.19-2.06 1.06-3.25-1.02.04-2.27.68-3 1.54-.66.76-1.24 1.98-1.08 3.14 1.14.09 2.31-.58 3.02-1.43Z"/>
          </svg>
        </span>
        <span class="vaulta-btn-text">
          <span class="vaulta-btn-title" data-vaulta-android-title>{copy.androidCta}</span>
          <span class="vaulta-btn-sub font-mono">{copy.androidSub}</span>
        </span>
      </a>

      <a
        href={WIN_URL}
        class="vaulta-btn vaulta-btn-secondary"
        data-vaulta-windows
        download="vaulta-windows-bundle.zip"
        rel="noopener"
      >
        <span class="vaulta-btn-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M3 5.4 10.5 4v8H3V5.4Zm0 13.2 7.5 1.4v-8H3v6.6Zm8.5-14.7L21 3v9h-9.5V3.9Zm0 16.2L21 21v-9h-9.5v8.1Z"/>
          </svg>
        </span>
        <span class="vaulta-btn-text">
          <span class="vaulta-btn-title" data-vaulta-windows-title>{copy.winCta}</span>
          <span class="vaulta-btn-sub font-mono">{copy.winSub}</span>
        </span>
      </a>
    </div>

    <div class="vaulta-extra">
      <a href={RELEASE_PAGE} class="vaulta-link" target="_blank" rel="noopener noreferrer">
        <Icon name="open_in_new" class="w-3.5 h-3.5" />
        <span>{copy.repoCta}</span>
        <span class="vaulta-link-arrow" aria-hidden="true">→</span>
      </a>
      <a href={REPO_URL} class="vaulta-link" target="_blank" rel="noopener noreferrer">
        <Icon name="code" class="w-3.5 h-3.5" />
        <span>github.com/Rene-Kuhm/vaulta</span>
        <span class="vaulta-link-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Bloque de soporte: invitación a star + contador en vivo + CTA secundario al repo -->
    <aside class="vaulta-support" data-vaulta-support data-repo="Rene-Kuhm/vaulta">
      <div class="vaulta-support-copy">
        <span class="vaulta-support-badge">
          <Icon name="star" class="w-3.5 h-3.5" />
          <span class="font-mono">OPEN SOURCE</span>
        </span>
        <h3 class="vaulta-support-title font-display">{copy.supportTitle}</h3>
        <p class="vaulta-support-text">
          {copy.supportText}
        </p>
      </div>

      <div class="vaulta-support-actions">
        <a
          href={REPO_URL}
          class="vaulta-support-cta"
          target="_blank"
          rel="noopener noreferrer"
          data-vaulta-star-cta
        >
          <Icon name="star" class="w-4 h-4" />
          <span>{copy.starCta}</span>
          <span class="vaulta-support-cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </aside>

    <!-- Security blurb -->
    <aside class="vaulta-security">
      <div class="vaulta-security-head">
        <span class="vaulta-security-badge">
          <Icon name="lock" class="w-3.5 h-3.5" />
          <span class="font-mono">SECURITY</span>
        </span>
        <h3 class="vaulta-security-title font-display">{copy.securityTitle}</h3>
      </div>
      <ul class="vaulta-security-list">
        {copy.securityPoints.map((point) => (
          <li class="vaulta-security-item">
            <Icon name="check_circle" class="w-4 h-4" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .vaulta-section {
    background:
      radial-gradient(ellipse at 20% 0%, rgba(248, 180, 0, 0.06) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 100%, rgba(237, 29, 36, 0.07) 0%, transparent 55%),
      #0a0a0a;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .vaulta-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .vaulta-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.35;
  }
  .vaulta-glow-1 {
    width: 480px;
    height: 480px;
    background: var(--color-marvel-gold);
    top: -120px;
    left: -80px;
  }
  .vaulta-glow-2 {
    width: 420px;
    height: 420px;
    background: var(--color-marvel-red);
    bottom: -120px;
    right: -80px;
    opacity: 0.25;
  }
  .vaulta-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(248, 180, 0, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248, 180, 0, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }
  .vaulta-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.55) 100%);
  }

  /* Header */
  .vaulta-header {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto 2.5rem;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-gold);
    box-shadow: 0 0 12px rgba(248, 180, 0, 0.7);
    animation: vaulta-pulse 1.6s ease-in-out infinite;
  }
  .kicker-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
  }

  .vaulta-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 1.5rem;
  }
  .vaulta-title-line { display: block; }
  .vaulta-title-accent { font-style: italic; }
  .vaulta-underline-wrap { position: relative; display: inline-block; }
  .vaulta-underline-text { position: relative; z-index: 2; }
  .vaulta-underline-bar {
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    bottom: 0.05em;
    height: 0.18em;
    background: linear-gradient(90deg, var(--color-marvel-gold) 0%, var(--color-marvel-red) 100%);
    transform-origin: left center;
    z-index: 1;
    box-shadow: 0 0 32px rgba(248, 180, 0, 0.35);
  }

  .vaulta-lead {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.65;
    color: var(--color-on-surface-variant);
    max-width: 42rem;
    margin: 0 auto;
  }

  /* Countdown */
  .vaulta-countdown {
    text-align: center;
    margin: 2.5rem auto 2rem;
    max-width: 36rem;
    padding: 1.75rem 1.25rem;
    border: 1px solid rgba(248, 180, 0, 0.18);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0) 100%),
      rgba(20, 20, 26, 0.55);
    backdrop-filter: blur(6px);
  }
  .vaulta-countdown-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-marvel-gold);
    margin: 0 0 1.25rem;
  }
  .vaulta-clock {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .vaulta-clock-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    padding: 0.75rem 0.5rem;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
  .vaulta-clock-num {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    color: #ffffff;
    text-shadow: 0 0 18px rgba(248, 180, 0, 0.25);
  }
  .vaulta-clock-unit {
    margin-top: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-on-surface-dim);
  }
  .vaulta-clock-sep {
    align-self: center;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-marvel-gold);
    line-height: 1;
    transform: translateY(-0.6rem);
  }
  .vaulta-countdown-meta {
    margin: 1.25rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-on-surface-dim);
  }
  .vaulta-countdown-meta :global(svg) { color: var(--color-marvel-gold); }

  @media (max-width: 520px) {
    .vaulta-clock { gap: 0.25rem; }
    .vaulta-clock-cell { min-width: 56px; padding: 0.6rem 0.25rem; }
  }

  /* CTAs */
  .vaulta-ctas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 44rem;
    margin: 2.5rem auto 1.25rem;
  }
  @media (max-width: 640px) {
    .vaulta-ctas { grid-template-columns: 1fr; }
  }
  .vaulta-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.4rem;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(20, 20, 26, 0.7);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease, background 200ms ease;
    overflow: hidden;
  }
  .vaulta-btn::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.08) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 700ms ease;
    pointer-events: none;
  }
  .vaulta-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(248, 180, 0, 0.5);
    box-shadow: 0 18px 40px -20px rgba(248, 180, 0, 0.4);
  }
  .vaulta-btn:hover::after { transform: translateX(100%); }

  .vaulta-btn-primary {
    background: linear-gradient(135deg, var(--color-marvel-red) 0%, var(--color-marvel-red-deep) 100%);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .vaulta-btn-primary:hover {
    box-shadow: 0 18px 40px -20px rgba(237, 29, 36, 0.55);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .vaulta-btn-secondary {
    background: linear-gradient(135deg, #1c1c24 0%, #14141a 100%);
    border-color: rgba(248, 180, 0, 0.35);
  }
  .vaulta-btn-secondary:hover {
    border-color: rgba(248, 180, 0, 0.8);
  }


  .vaulta-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.35);
    color: #ffffff;
    flex-shrink: 0;
  }
  .vaulta-btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    gap: 0.15rem;
    min-width: 0;
  }
  .vaulta-btn-title {
    font-size: 0.95rem;
    line-height: 1.2;
    color: #ffffff;
  }
  .vaulta-btn-sub {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .vaulta-btn-primary .vaulta-btn-icon { background: rgba(0, 0, 0, 0.3); }
  .vaulta-btn-secondary .vaulta-btn-icon { color: var(--color-marvel-gold); }

  /* Extra links */
  .vaulta-extra {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 1.75rem;
    margin: 1rem 0 3rem;
  }
  .vaulta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    border-bottom: 1px dashed transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .vaulta-link:hover { color: var(--color-marvel-gold); border-color: var(--color-marvel-gold); }
  .vaulta-link-arrow { font-weight: 700; }

  /* Security blurb */
  .vaulta-security {
    margin: 0 auto;
    max-width: 44rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    background: rgba(10, 10, 10, 0.55);
  }
  .vaulta-security-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .vaulta-security-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(248, 180, 0, 0.08);
    border: 1px solid rgba(248, 180, 0, 0.3);
    color: var(--color-marvel-gold);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }
  .vaulta-security-title {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    color: #ffffff;
    margin: 0;
  }
  .vaulta-security-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }
  .vaulta-security-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--color-on-surface-variant);
  }
  .vaulta-security-item :global(svg) { color: var(--color-marvel-gold); flex-shrink: 0; }

  /* Animación del dot kicker */
  @keyframes vaulta-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 12px rgba(248, 180, 0, 0.7); }
    50% { transform: scale(1.4); box-shadow: 0 0 22px rgba(248, 180, 0, 0.9); }
  }

  /* Support block (star CTA + live counter) */
  .vaulta-support {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    align-items: center;
    margin: 2rem auto 0;
    max-width: 56rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid rgba(248, 180, 0, 0.18);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(248, 180, 0, 0.04) 0%, rgba(248, 180, 0, 0) 100%),
      rgba(20, 20, 26, 0.55);
  }
  @media (max-width: 720px) {
    .vaulta-support { grid-template-columns: 1fr; text-align: left; }
  }
  .vaulta-support-copy { display: flex; flex-direction: column; gap: 0.5rem; }
  .vaulta-support-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(248, 180, 0, 0.08);
    border: 1px solid rgba(248, 180, 0, 0.3);
    color: var(--color-marvel-gold);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    align-self: flex-start;
  }
  .vaulta-support-title {
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }
  .vaulta-support-text {
    font-size: 0.85rem;
    line-height: 1.5;
