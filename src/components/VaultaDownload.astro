---
/**
 * VaultaDownload.astro
 *
 * Sección "Descargá Vaulta" con contador regresivo al lanzamiento público
 * (jueves 12 jun 2026 12:00 ART = 15:00 UTC) y dos CTAs de descarga:
 * APK Android + bundle ZIP Windows.
 *
 * Comportamiento del contador:
 *  - Antes del lanzamiento: muestra countdown vivo (dd hh mm ss) en ES y en.
 *  - Después del lanzamiento: muestra "Disponible ahora" + los botones quedan activos.
 *  - Zona horaria: America/Argentina/Buenos_Aires (UTC-3). Se calcula contra UTC
 *    en el cliente para evitar drift si el visitante está en otra zona.
 *
 * URLs de release (tomadas del README oficial del repo):
 *  - APK Android:     .../releases/download/v1.0.22/vaulta.apk
 *  - Bundle Windows:  .../releases/download/v1.0.22/vaulta-windows-bundle.zip
 *  - Release page:    .../releases/tag/v1.0.22
 */

import Icon from './Icon.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';

const RELEASE_ISO_UTC = '2026-06-12T15:00:00.000Z';
// Release oficial v1.0.22 (publicado 11 jun 2026) — incluye APK Android + bundle
// Windows. La release dev-latest del bot de GitHub Actions solo incluye el APK,
// por eso apuntamos a v1.0.22 para que ambos botones tengan destino real.
const APK_URL =
  'https://github.com/Rene-Kuhm/vaulta/releases/download/v1.0.22/vaulta.apk';
const WIN_URL =
  'https://github.com/Rene-Kuhm/vaulta/releases/download/v1.0.22/vaulta-windows-bundle.zip';
const RELEASE_PAGE =
  'https://github.com/Rene-Kuhm/vaulta/releases/tag/v1.0.22';
const REPO_URL =
  'https://github.com/Rene-Kuhm/vaulta';

const copy = {
  es: {
    kicker: 'APP · LANZAMIENTO',
    title: ['Vaulta está', 'a punto de despegar'],
    lead: 'El gestor de contraseñas cifrado de TecnoDespegue llega mañana al mediodía (hora Argentina). Andoird y Windows, cifrado AES-256-GCM, Argon2id, desbloqueo biométrico y vault offline-first.',
    countdownLabel: 'Cuenta regresiva al lanzamiento',
    days: ['días', 'día'],
    hours: ['hs', 'h'],
    minutes: ['min', 'm'],
    seconds: ['seg', 's'],
    launched: '¡Ya está disponible!',
    launchedSub: 'Descargá la versión firmada de Vaulta.',
    androidCta: 'Descargar APK',
    androidSub: 'Android · vaulta.apk',
    winCta: 'Descargar para Windows',
    winSub: 'Windows x64 · vaulta-windows-bundle.zip',
    repoCta: 'Ver código y notas de release',
    securityTitle: 'Pensado para mantener tus claves a salvo',
    securityPoints: [
      'Cifrado AES-256-GCM local, sin servidores.',
      'Argon2id para derivar la clave del master password.',
      'Biometría real en Android (Android KeyStore) y Windows Hello.',
    ],
    supportBadge: 'OPEN SOURCE',
    supportTitle: '¿Te sirvió? Dejanos una ⭐ en GitHub.',
    supportText: 'Vaulta es gratis y open source. Una estrella ayuda al proyecto a crecer y nos motiva a seguir publicando software seguro y offline-first.',
    starsLabel: 'ESTRELLAS',
    starCta: 'Dar estrella en GitHub',
    loadingStars: '…',
  },
  en: {
    kicker: 'APP · LAUNCH',
    title: ['Vaulta is', 'about to launch'],
    lead: "TecnoDespegue's encrypted password manager lands tomorrow at noon (Argentina time). Android and Windows, AES-256-GCM encryption, Argon2id, biometric unlock, offline-first vault.",
    countdownLabel: 'Countdown to launch',
    days: ['days', 'day'],
    hours: ['h', 'h'],
    minutes: ['min', 'm'],
    seconds: ['s', 's'],
    launched: 'It\'s live!',
    launchedSub: 'Download the signed Vaulta build.',
    androidCta: 'Download APK',
    androidSub: 'Android · vaulta.apk',
    winCta: 'Download for Windows',
    winSub: 'Windows x64 · vaulta-windows-bundle.zip',
    repoCta: 'View source & release notes',
    securityTitle: 'Built to keep your keys safe',
    securityPoints: [
      'Local AES-256-GCM encryption, no servers.',
      'Argon2id for master password key derivation.',
      'Real biometrics on Android (Android KeyStore) and Windows Hello.',
    ],
    supportBadge: 'OPEN SOURCE',
    supportTitle: 'Loved it? Leave us a star.',
    supportText: 'Vaulta is free and open source. A star helps the project grow and motivates us to keep shipping secure, offline-first software.',
    starsLabel: 'STARS',
    starCta: 'Star on GitHub',
    loadingStars: '…',
  },
}[locale];
---

<section class="vaulta-section py-24 md:py-32 relative overflow-hidden" id="vaulta" data-vaulta-release={RELEASE_ISO_UTC}>
  <!-- Background decorativo -->
  <div class="vaulta-bg" aria-hidden="true">
    <div class="vaulta-glow vaulta-glow-1"></div>
    <div class="vaulta-glow vaulta-glow-2"></div>
    <div class="vaulta-grid"></div>
    <div class="vaulta-vignette"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 md:px-8 relative z-10">

    <header class="vaulta-header">
      <span class="kicker">
        <span class="kicker-dot"></span>
        <span class="kicker-text font-mono">{copy.kicker}</span>
      </span>

      <h2 class="vaulta-title font-display">
        <span class="vaulta-title-line">{copy.title[0]}</span>
        <span class="vaulta-title-line vaulta-title-accent">
          <span class="vaulta-underline-wrap">
            <span class="vaulta-underline-text">{copy.title[1]}</span>
            <span class="vaulta-underline-bar" aria-hidden="true"></span>
          </span>
        </span>
      </h2>

      <p class="vaulta-lead">{copy.lead}</p>
    </header>

    <!-- Countdown / launched state -->
    <div class="vaulta-countdown" data-vaulta-countdown>
      <p class="vaulta-countdown-label font-mono" data-vaulta-countdown-label>
        {copy.countdownLabel}
      </p>

      <div class="vaulta-clock" role="timer" aria-live="polite">
        <div class="vaulta-clock-cell">
          <span class="vaulta-clock-num font-display" data-vaulta-d>00</span>
          <span class="vaulta-clock-unit font-mono">{copy.days[1]}</span>
        </div>
        <span class="vaulta-clock-sep" aria-hidden="true">:</span>
        <div class="vaulta-clock-cell">
          <span class="vaulta-clock-num font-display" data-vaulta-h>00</span>
          <span class="vaulta-clock-unit font-mono">{copy.hours[1]}</span>
        </div>
        <span class="vaulta-clock-sep" aria-hidden="true">:</span>
        <div class="vaulta-clock-cell">
          <span class="vaulta-clock-num font-display" data-vaulta-m>00</span>
          <span class="vaulta-clock-unit font-mono">{copy.minutes[1]}</span>
        </div>
        <span class="vaulta-clock-sep" aria-hidden="true">:</span>
        <div class="vaulta-clock-cell">
          <span class="vaulta-clock-num font-display" data-vaulta-s>00</span>
          <span class="vaulta-clock-unit font-mono">{copy.seconds[1]}</span>
        </div>
      </div>

      <p class="vaulta-countdown-meta font-mono">
        <Icon name="schedule" class="w-3.5 h-3.5 inline-block align-[-2px] mr-1.5" />
        <span data-vaulta-target>12 jun 2026 · 12:00 ART (UTC-3)</span>
      </p>
    </div>

    <!-- Botones de descarga (siempre visibles: antes del launch muestran
         el estado "no disponible" en cliente; después quedan activos). -->
    <div class="vaulta-ctas" data-vaulta-ctas>
      <a
        href={APK_URL}
        class="vaulta-btn vaulta-btn-primary"
        data-vaulta-android
        download="vaulta.apk"
        rel="noopener"
      >
        <span class="vaulta-btn-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M17.5 14.4c-.03-2.6 2.13-3.85 2.23-3.91-1.22-1.78-3.11-2.02-3.78-2.05-1.61-.16-3.14.94-3.96.94-.82 0-2.08-.92-3.42-.9-1.76.03-3.38 1.02-4.28 2.6-1.82 3.16-.47 7.84 1.31 10.41.86 1.26 1.88 2.67 3.22 2.62 1.29-.05 1.78-.84 3.34-.84 1.55 0 2 .84 3.36.81 1.39-.02 2.27-1.28 3.12-2.55.99-1.46 1.4-2.88 1.42-2.95-.03-.01-2.72-1.04-2.75-4.13ZM14.93 6.78c.71-.86 1.19-2.06 1.06-3.25-1.02.04-2.27.68-3 1.54-.66.76-1.24 1.98-1.08 3.14 1.14.09 2.31-.58 3.02-1.43Z"/>
          </svg>
        </span>
        <span class="vaulta-btn-text">
          <span class="vaulta-btn-title" data-vaulta-android-title>{copy.androidCta}</span>
          <span class="vaulta-btn-sub font-mono">{copy.androidSub}</span>
        </span>
      </a>

      <a
        href={WIN_URL}
        class="vaulta-btn vaulta-btn-secondary"
        data-vaulta-windows
        download="vaulta-windows-bundle.zip"
        rel="noopener"
      >
        <span class="vaulta-btn-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M3 5.4 10.5 4v8H3V5.4Zm0 13.2 7.5 1.4v-8H3v6.6Zm8.5-14.7L21 3v9h-9.5V3.9Zm0 16.2L21 21v-9h-9.5v8.1Z"/>
          </svg>
        </span>
        <span class="vaulta-btn-text">
          <span class="vaulta-btn-title" data-vaulta-windows-title>{copy.winCta}</span>
          <span class="vaulta-btn-sub font-mono">{copy.winSub}</span>
        </span>
      </a>
    </div>

    <div class="vaulta-extra">
      <a href={RELEASE_PAGE} class="vaulta-link" target="_blank" rel="noopener noreferrer">
        <Icon name="open_in_new" class="w-3.5 h-3.5" />
        <span>{copy.repoCta}</span>
        <span class="vaulta-link-arrow" aria-hidden="true">→</span>
      </a>
      <a href={REPO_URL} class="vaulta-link" target="_blank" rel="noopener noreferrer">
        <Icon name="code" class="w-3.5 h-3.5" />
        <span>github.com/Rene-Kuhm/vaulta</span>
        <span class="vaulta-link-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Bloque de soporte: invitación a star + contador en vivo + CTA secundario al repo -->
    <aside class="vaulta-support" data-vaulta-support data-repo="Rene-Kuhm/vaulta">
      <div class="vaulta-support-copy">
        <span class="vaulta-support-badge">
          <Icon name="star" class="w-3.5 h-3.5" />
          <span class="font-mono">OPEN SOURCE</span>
        </span>
        <h3 class="vaulta-support-title font-display">{copy.supportTitle}</h3>
        <p class="vaulta-support-text">
          {copy.supportText}
        </p>
      </div>

      <div class="vaulta-support-actions">
        <div class="vaulta-stars" data-vaulta-stars aria-live="polite" aria-atomic="true">
          <span class="vaulta-stars-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M12 2.5l2.95 6.36 6.95.78-5.2 4.85 1.5 6.91L12 17.95l-6.2 3.45 1.5-6.91-5.2-4.85 6.95-.78L12 2.5z"/>
            </svg>
          </span>
          <span class="vaulta-stars-num font-display" data-vaulta-stars-num>—</span>
          <span class="vaulta-stars-label font-mono">{copy.starsLabel}</span>
        </div>

        <a
          href={REPO_URL}
          class="vaulta-support-cta"
          target="_blank"
          rel="noopener noreferrer"
          data-vaulta-star-cta
        >
          <Icon name="star" class="w-4 h-4" />
          <span>{copy.starCta}</span>
          <span class="vaulta-support-cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </aside>

    <!-- Security blurb -->
    <aside class="vaulta-security">
      <div class="vaulta-security-head">
        <span class="vaulta-security-badge">
          <Icon name="lock" class="w-3.5 h-3.5" />
          <span class="font-mono">SECURITY</span>
        </span>
        <h3 class="vaulta-security-title font-display">{copy.securityTitle}</h3>
      </div>
      <ul class="vaulta-security-list">
        {copy.securityPoints.map((point) => (
          <li class="vaulta-security-item">
            <Icon name="check_circle" class="w-4 h-4" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<script>
  /**
   * Vaulta countdown client logic.
   * Lee `data-vaulta-release` (ISO UTC) y actualiza dd:hh:mm:ss cada segundo
   * hasta llegar a 0; en ese momento, marca la sección como "launched" y
   * habilita los botones de descarga.
   *
   * Robusto a:
   *  - Zona horaria del visitante: todo se calcula contra UTC.
   *  - Reloj adelantado: muestra ceros y cambia a "launched" automáticamente.
   *  - JS deshabilitado / reducido: el HTML sigue siendo legible y los <a>
   *    siguen funcionando (el contador simplemente queda estático).
   */
  type Locale = 'es' | 'en';

  const section = document.querySelector<HTMLElement>('[data-vaulta-release]');
  if (section) {
    const targetIso = section.dataset.vaultaRelease!;
    const targetMs = Date.parse(targetIso);
    if (!Number.isNaN(targetMs)) {
      // Heurística de idioma: si el <html lang> empieza con "en", usamos copy EN.
      const htmlLang = (document.documentElement.lang || 'es').toLowerCase();
      const locale: Locale = htmlLang.startsWith('en') ? 'en' : 'es';

      const i18n = {
        es: {
          label: 'Cuenta regresiva al lanzamiento',
          launched: '¡Ya está disponible!',
          launchedSub: 'Descargá la versión firmada de Vaulta.',
          days: ['días', 'día'],
          hours: ['hs', 'h'],
          minutes: ['min', 'm'],
          seconds: ['seg', 's'],
          androidCta: 'Descargar APK',
          winCta: 'Descargar para Windows',
        },
        en: {
          label: 'Countdown to launch',
          launched: "It's live!",
          launchedSub: 'Download the signed Vaulta build.',
          days: ['days', 'day'],
          hours: ['h', 'h'],
          minutes: ['min', 'm'],
          seconds: ['s', 's'],
          androidCta: 'Download APK',
          winCta: 'Download for Windows',
        },
      }[locale];

      const $d = section.querySelector<HTMLElement>('[data-vaulta-d]');
      const $h = section.querySelector<HTMLElement>('[data-vaulta-h]');
      const $m = section.querySelector<HTMLElement>('[data-vaulta-m]');
      const $s = section.querySelector<HTMLElement>('[data-vaulta-s]');
      const $label = section.querySelector<HTMLElement>('[data-vaulta-countdown-label]');
      const $androidTitle = section.querySelector<HTMLElement>('[data-vaulta-android-title]');
      const $windowsTitle = section.querySelector<HTMLElement>('[data-vaulta-windows-title]');

      const pad = (n: number) => String(n).padStart(2, '0');

      const unit = (es: string[], en: string[], n: number) =>
        locale === 'en' ? en[0] : (n === 1 ? es[0] : es[1]);

      const renderRemaining = (ms: number) => {
        const clamped = Math.max(0, ms);
        const totalSec = Math.floor(clamped / 1000);
        const days = Math.floor(totalSec / 86400);
        const hours = Math.floor((totalSec % 86400) / 3600);
        const minutes = Math.floor((totalSec % 3600) / 60);
        const seconds = totalSec % 60;

        if ($d) $d.textContent = pad(days);
        if ($h) $h.textContent = pad(hours);
        if ($m) $m.textContent = pad(minutes);
        if ($s) $s.textContent = pad(seconds);

        // Actualizamos los labels de unidad (singular/plural) abajo del número.
        const cells = section.querySelectorAll<HTMLElement>('.vaulta-clock-cell .vaulta-clock-unit');
        if (cells.length === 4) {
          cells[0].textContent = unit(i18n.days, i18n.days, days);
          cells[1].textContent = unit(i18n.hours, i18n.hours, hours);
          cells[2].textContent = unit(i18n.minutes, i18n.minutes, minutes);
          cells[3].textContent = unit(i18n.seconds, i18n.seconds, seconds);
        }
      };

      const markLaunched = () => {
        section.classList.add('is-launched');
        if ($label) $label.textContent = i18n.launched;
        const sub = section.querySelector<HTMLElement>('.vaulta-countdown-meta');
        if (sub) {
          sub.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 inline-block align-[-2px] mr-1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>' +
            i18n.launchedSub;
        }
        if ($androidTitle) $androidTitle.textContent = i18n.androidCta;
        if ($windowsTitle) $windowsTitle.textContent = i18n.winCta;
      };

      const tick = () => {
        const remaining = targetMs - Date.now();
        if (remaining <= 0) {
          renderRemaining(0);
          markLaunched();
          return false; // detener
        }
        renderRemaining(remaining);
        return true;
      };

      // Render inicial + interval (se cancela solo al lanzar).
      if (tick()) {
        const interval = window.setInterval(() => {
          if (!tick()) window.clearInterval(interval);
        }, 1000);
        // Limpieza si Astro navega con View Transitions.
        document.addEventListener('astro:before-swap', () => window.clearInterval(interval), { once: true });
      }
    }
  }

  /**
   * Star counter — pide /api/github-stars y renderiza el conteo.
   * Si la API falla, mantiene el placeholder "—" sin romper la UI.
   * El endpoint ya cachea en CDN por 1h, así que esto es un solo fetch por visita.
   */
  const supportEl = document.querySelector<HTMLElement>('[data-vaulta-support]');
  if (supportEl) {
    const repo = supportEl.dataset.repo || 'Rene-Kuhm/vaulta';
    const $num = supportEl.querySelector<HTMLElement>('[data-vaulta-stars-num]');
    if ($num) {
      const format = (n: number) => {
        if (n < 1000) return String(n);
        if (n < 10_000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
        return Math.round(n / 1000) + 'k';
      };
      try {
        const res = await fetch(`/api/github-stars?repo=${encodeURIComponent(repo)}`, {
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          const data = (await res.json()) as { stars?: number };
          if (typeof data.stars === 'number') {
            $num.textContent = format(data.stars);
            supportEl.classList.add('has-stars');
          }
        }
      } catch {
        // Silencioso: dejamos el "—" si la red o el server fallan.
      }
    }
  }
</script>

<style>
  .vaulta-section {
    background:
      radial-gradient(ellipse at 20% 0%, rgba(248, 180, 0, 0.06) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 100%, rgba(237, 29, 36, 0.07) 0%, transparent 55%),
      #0a0a0a;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .vaulta-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .vaulta-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.35;
  }
  .vaulta-glow-1 {
    width: 480px;
    height: 480px;
    background: var(--color-marvel-gold);
    top: -120px;
    left: -80px;
  }
  .vaulta-glow-2 {
    width: 420px;
    height: 420px;
    background: var(--color-marvel-red);
    bottom: -120px;
    right: -80px;
    opacity: 0.25;
  }
  .vaulta-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(248, 180, 0, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248, 180, 0, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }
  .vaulta-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.55) 100%);
  }

  /* Header */
  .vaulta-header {
    text-align: center;
    max-width: 56rem;
    margin: 0 auto 2.5rem;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-gold);
    box-shadow: 0 0 12px rgba(248, 180, 0, 0.7);
    animation: vaulta-pulse 1.6s ease-in-out infinite;
  }
  .kicker-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
  }

  .vaulta-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 1.5rem;
  }
  .vaulta-title-line { display: block; }
  .vaulta-title-accent { font-style: italic; }
  .vaulta-underline-wrap { position: relative; display: inline-block; }
  .vaulta-underline-text { position: relative; z-index: 2; }
  .vaulta-underline-bar {
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    bottom: 0.05em;
    height: 0.18em;
    background: linear-gradient(90deg, var(--color-marvel-gold) 0%, var(--color-marvel-red) 100%);
    transform-origin: left center;
    z-index: 1;
    box-shadow: 0 0 32px rgba(248, 180, 0, 0.35);
  }

  .vaulta-lead {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.65;
    color: var(--color-on-surface-variant);
    max-width: 42rem;
    margin: 0 auto;
  }

  /* Countdown */
  .vaulta-countdown {
    text-align: center;
    margin: 2.5rem auto 2rem;
    max-width: 36rem;
    padding: 1.75rem 1.25rem;
    border: 1px solid rgba(248, 180, 0, 0.18);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0) 100%),
