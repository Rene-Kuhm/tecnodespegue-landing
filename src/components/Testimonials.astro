---
const projects = [
  {
    quote: "Sistema e-commerce completo para Aguamarina Mosaicos: tienda online con catálogo dinámico, panel admin, API REST documentada con Swagger y deploy automatizado en Railway + Vercel.",
    project: "Aguamarina Mosaicos",
    type: "E-Commerce Empresarial",
    metric: "Full-stack en producción",
    stack: "Next.js 15 · PostgreSQL · Railway"
  },
  {
    quote: "Pipeline de automatización con IA que genera contenido, crea imágenes y publica en 3 plataformas automáticamente. 4 publicaciones diarias sin intervención humana.",
    project: "TecnoDespegue Automation",
    type: "IA & Automatización",
    metric: "4 posts/día automáticos",
    stack: "Python · OpenClaw · GPT-5 · Postiz"
  },
  {
    quote: "Ingeniería inversa del protocolo USB HID para crear un driver macOS nativo. Lee CPU, GPU y fans en tiempo real enviando datos al display del gabinete cada 200ms.",
    project: "HydroTemp AIO Driver",
    type: "Hardware & Reverse Engineering",
    metric: "200ms refresh rate",
    stack: "Python · USB HID · macOS"
  }
];
---

<section class="py-32 bg-surface-container-lowest relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 blur-[150px] rounded-full"></div>
  
  <div class="max-w-7xl mx-auto px-8 relative z-10">
    <div class="text-center mb-16">
      <span class="text-xs font-mono text-secondary uppercase tracking-[0.4em] mb-4 block">
        Resultados
      </span>
      <h2 class="text-3xl font-headline font-bold">
        Casos Reales, Resultados Medibles
      </h2>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {projects.map((project) => (
        <div class="card group hover:scale-105 transition-transform duration-300">
          <div class="mb-2">
            <span class="px-2 py-1 bg-secondary/10 border border-secondary/20 rounded-chip text-[10px] font-mono text-secondary uppercase">
              {project.type}
            </span>
          </div>
          
          <div class="mb-6">
            <p class="text-on-surface-variant text-sm leading-relaxed">
              {project.quote}
            </p>
          </div>
          
          <div class="pt-6 border-t border-white/5">
            <p class="font-headline font-bold text-on-surface text-sm">
              {project.project}
            </p>
            <p class="text-xs text-on-surface-variant font-mono mt-1">
              {project.stack}
            </p>
          </div>
          
          <div class="mt-4 inline-block px-3 py-1 bg-primary/10 border border-primary/20 rounded-chip">
            <span class="text-xs font-mono text-primary font-bold">
              {project.metric}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
