  terminal: { paths: ['M4 17 10 11 4 5', 'M12 19h8'] },
  forum: { paths: ['M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z'] },
  calendar_month: { paths: ['M8 2v4', 'M16 2v4', 'M3 10h18', 'M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z'] },
  chat: { paths: ['M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z'] },
  verified: { paths: ['m9 12 2 2 4-4', 'M12 3l2.2 1.2 2.5-.3 1.1 2.3 2.3 1.1-.3 2.5L21 12l-1.2 2.2.3 2.5-2.3 1.1-1.1 2.3-2.5-.3L12 21l-2.2-1.2-2.5.3-1.1-2.3-2.3-1.1.3-2.5L3 12l1.2-2.2-.3-2.5 2.3-1.1 1.1-2.3 2.5.3Z'] },
  code: { paths: ['M16 18l6-6-6-6', 'M8 6l-6 6 6 6'] },
  support_agent: { paths: ['M4 12a8 8 0 0 1 16 0', 'M4 15v-3a2 2 0 0 0-2 2v1a2 2 0 0 0 2 2h1', 'M20 15v-3a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2h-1', 'M9 18h6', 'M9 10a3 3 0 1 1 6 0v3H9Z'] },
  psychology: { paths: ['M12 3a6 6 0 0 0-6 6v2a4 4 0 0 0 4 4h1v2H9a2 2 0 0 0 0 4h6', 'M12 7a2 2 0 1 1 2 2c0 1-1 1.5-1.5 2.5', 'M12 17h.01'] },
  layers: { paths: ['m12 3-9 4.5 9 4.5 9-4.5L12 3Z', 'm3 12 9 4.5 9-4.5', 'm3 16.5 9 4.5 9-4.5'] },
  account_tree: { paths: ['M12 3v6', 'M6 9h12', 'M6 9v6', 'M18 9v6', 'M3 15h6', 'M15 15h6', 'M5 19h2', 'M17 19h2', 'M11 5h2'] },
  api: { paths: ['M8 8h8', 'M8 12h5', 'M8 16h8', 'M4 6h16v12H4z'] },
  database: { paths: ['M12 5c-4.4 0-8 1.3-8 3v8c0 1.7 3.6 3 8 3s8-1.3 8-3V8c0-1.7-3.6-3-8-3Z', 'M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3', 'M4 8c0 1.7 3.6 3 8 3s8-1.3 8-3'] },
  cloud_done: { paths: ['M7 18a4 4 0 1 1 .7-7.9A5 5 0 0 1 17.9 8 4 4 0 1 1 17 18Z', 'm9.5 13.5 2 2 3.5-3.5'] },
  open_in_new: { paths: ['M14 4h6v6', 'M10 14 20 4', 'M20 14v6H4V4h6'] },
  deployed_code: { paths: ['M12 2v6', 'M8 5h8', 'M6 10h12v10H6z', 'm9 15 2 2 4-4'] },
  cloud: { paths: ['M7 18a4 4 0 1 1 .7-7.9A5 5 0 0 1 17.9 8 4 4 0 1 1 17 18Z'] },
  arrow_forward: { paths: ['M5 12h14', 'm13 5 7 7-7 7'] },
  check_circle: { paths: ['M22 11.08V12a10 10 0 1 1-5.93-9.14', 'm9 11 3 3L22 4'] },
  storefront: { paths: ['M3 9l1-4h16l1 4', 'M4 9h16v10H4z', 'M9 19v-5h6v5'] },
  shopping_bag: { paths: ['M6 8h12l-1 12H7L6 8Z', 'M9 8a3 3 0 1 1 6 0'] },
  smart_toy: { paths: ['M9 3h6', 'M12 3v3', 'M8 6h8a3 3 0 0 1 3 3v5a5 5 0 0 1-5 5h-4a5 5 0 0 1-5-5V9a3 3 0 0 1 3-3Z', 'M9 11h.01', 'M15 11h.01', 'M9 15h6'] },
  memory: { paths: ['M7 7h10v10H7z', 'M9 1v4', 'M15 1v4', 'M9 19v4', 'M15 19v4', 'M1 9h4', 'M1 15h4', 'M19 9h4', 'M19 15h4'] },
  lock: { paths: ['M7 11V8a5 5 0 0 1 10 0v3', 'M5 11h14v10H5z'] }
};

const icon = icons[name] ?? icons.code;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox ?? '0 0 24 24'}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  {icon.paths.map((path) => <path d={path} />)}
</svg>
