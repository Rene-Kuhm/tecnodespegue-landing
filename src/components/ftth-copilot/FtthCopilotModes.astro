---
/**
 * FtthCopilotModes.astro — Tres modos de diagnóstico de FTTH-Copilot.
 * Cards bilingües con icono, kicker, título y descripción corta.
 * Estética Marvel consistente con CTA/Services.
 */

import Icon from '../Icon.astro';
import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';

const copy = {
  es: {
    modes: [
      {
        index: '01',
        icon: 'terminal',
        kicker: 'MODO DETERMINISTA',
        title: 'DIRECT',
        desc: 'Consultas deterministas sin gastar LLM innecesariamente.',
      },
      {
        index: '02',
        icon: 'psychology',
        kicker: 'IA + TOOLS',
        title: 'ASSISTED',
        desc: 'IA + únicamente las herramientas relevantes.',
      },
      {
        index: '03',
        icon: 'account_tree',
        kicker: 'DEEP INVESTIGATION',
        title: 'INVESTIGATION',
        desc: 'Telemetría + eventos + topología + historial + hipótesis + evidencia.',
      },
    ],
  },
  en: {
    modes: [
      {
        index: '01',
        icon: 'terminal',
        kicker: 'DETERMINISTIC MODE',
        title: 'DIRECT',
        desc: 'Deterministic queries without spending LLM tokens unnecessarily.',
      },
      {
        index: '02',
        icon: 'psychology',
        kicker: 'AI + TOOLS',
        title: 'ASSISTED',
        desc: 'AI + only the relevant tools.',
      },
      {
        index: '03',
        icon: 'account_tree',
        kicker: 'DEEP INVESTIGATION',
        title: 'INVESTIGATION',
        desc: 'Telemetry + events + topology + history + hypotheses + evidence.',
      },
    ],
  },
}[locale];
---

<section class="ftth-modes relative" data-ftth-modes>

  <ul class="ftth-modes-grid" role="list">
    {copy.modes.map((mode) => (
      <li class="ftth-modes-card" data-ftth-mode>
        <div class="ftth-modes-card-bg" aria-hidden="true"></div>
        <div class="ftth-modes-icon-wrap">
          <Icon name={mode.icon} class="ftth-modes-icon" />
        </div>
        <span class="ftth-modes-index font-mono" aria-hidden="true">{mode.index}</span>
        <span class="ftth-modes-card-kicker font-mono">{mode.kicker}</span>
        <h3 class="ftth-modes-card-title font-display">{mode.title}</h3>
        <p class="ftth-modes-card-desc">{mode.desc}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .ftth-modes {
    width: 100%;
  }

  /* Header removed in the conversion-optimization pass. The page-level
     <section> wrapper in src/pages/ftth-copilot.astro provides its own
     kicker + h2 + lead to avoid duplicate headings. */

  /* Grid */
  .ftth-modes-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .ftth-modes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  /* Card */
  .ftth-modes-card {
    position: relative;
    padding: 2rem 1.75rem 1.75rem;
    border-radius: var(--radius-marvel);
    background: linear-gradient(180deg, rgba(28, 28, 36, 0.9) 0%, rgba(15, 15, 21, 0.9) 100%);
    border: 1px solid rgba(248, 180, 0, 0.18);
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    overflow: hidden;
    transition: transform 0.3s var(--ease-marvel), border-color 0.3s, box-shadow 0.3s;
  }

  .ftth-modes-card-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 0%, rgba(237, 29, 36, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .ftth-modes-card:hover {
    transform: translateY(-4px);
    border-color: rgba(248, 180, 0, 0.45);
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.55);
  }

  .ftth-modes-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-card);
    background: rgba(237, 29, 36, 0.12);
    border: 1px solid rgba(237, 29, 36, 0.35);
    color: var(--color-marvel-red-glow);
    margin-bottom: 1.25rem;
    position: relative;
  }

  .ftth-modes-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .ftth-modes-index {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-marvel-gold);
    opacity: 0.55;
  }

  .ftth-modes-card-kicker {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-marvel-gold);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .ftth-modes-card-title {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .ftth-modes-card-desc {
    color: var(--color-on-surface-variant);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ftth-modes-card {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
