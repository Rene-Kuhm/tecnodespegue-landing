---
/**
 * FtthCopilotFlow.astro — Diagrama de flujo de diagnóstico.
 * Inline SVG, accesible, bilingüe. Animación sutil sólo en desktop
 * y deshabilitada automáticamente con prefers-reduced-motion.
 *
 * Pipeline visualizado:
 *   OLT/NMS → Telemetría → Organic Diagnostic Router → TruthGate → Diagnóstico → Incidente/Alerta
 */

import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';

const labels = {
  es: {
    ariaLabel: 'Diagrama del flujo de diagnóstico de FTTH-Copilot: OLT y NMS, Telemetría, Organic Diagnostic Router, TruthGate, Diagnóstico, Incidente o Alerta.',
    nodes: [
      { kicker: 'FUENTE',     lines: ['OLT', '/ NMS'] },
      { kicker: 'INGESTA',    lines: ['Telemetría'] },
      { kicker: 'RUTEO',      lines: ['Organic', 'Diagnostic', 'Router'] },
      { kicker: 'VALIDACIÓN', lines: ['TruthGate'] },
      { kicker: 'RESULTADO',  lines: ['Diagnóstico'] },
      { kicker: 'SALIDA',     lines: ['Incidente', '/ Alerta'] },
    ],
  },
  en: {
    ariaLabel: 'FTTH-Copilot diagnostic flow diagram: OLT and NMS, Telemetry, Organic Diagnostic Router, TruthGate, Diagnosis, Incident or Alert.',
    nodes: [
      { kicker: 'SOURCE',    lines: ['OLT', '/ NMS'] },
      { kicker: 'INGEST',    lines: ['Telemetry'] },
      { kicker: 'ROUTING',   lines: ['Organic', 'Diagnostic', 'Router'] },
      { kicker: 'VALIDATE',  lines: ['TruthGate'] },
      { kicker: 'OUTPUT',    lines: ['Diagnosis'] },
      { kicker: 'EMIT',      lines: ['Incident', '/ Alert'] },
    ],
  },
}[locale];
---

<section class="ftth-flow relative" data-ftth-flow aria-labelledby="ftth-flow-title">
  <h2 id="ftth-flow-title" class="ftth-flow-title font-display">Pipeline</h2>

  <svg
    class="ftth-flow-svg"
    viewBox="0 0 1200 360"
    role="img"
    aria-label={labels.ariaLabel}
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <linearGradient id="ftth-flow-node" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#1C1C24" />
        <stop offset="100%" stop-color="#0F0F15" />
      </linearGradient>
      <linearGradient id="ftth-flow-edge" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"   stop-color="#ED1D24" />
        <stop offset="100%" stop-color="#F8B400" />
      </linearGradient>
      <marker
        id="ftth-flow-arrowhead"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#F8B400" />
      </marker>
    </defs>

    <!-- Connector lines (rendered first so nodes sit on top) -->
    <g class="ftth-flow-edges" aria-hidden="true">
      <path class="ftth-flow-edge ftth-flow-edge-1" d="M 260 180 L 284 180" marker-end="url(#ftth-flow-arrowhead)" />
      <path class="ftth-flow-edge ftth-flow-edge-2" d="M 424 180 L 448 180" marker-end="url(#ftth-flow-arrowhead)" />
      <path class="ftth-flow-edge ftth-flow-edge-3" d="M 588 180 L 612 180" marker-end="url(#ftth-flow-arrowhead)" />
      <path class="ftth-flow-edge ftth-flow-edge-4" d="M 752 180 L 776 180" marker-end="url(#ftth-flow-arrowhead)" />
      <path class="ftth-flow-edge ftth-flow-edge-5" d="M 916 180 L 940 180" marker-end="url(#ftth-flow-arrowhead)" />
    </g>

    <!-- Nodes -->
    <g class="ftth-flow-nodes">
      {labels.nodes.map((node, i) => {
        const x = 120 + i * 164;
        const y = 110;
        const w = 140;
        const h = 140;
        return (
          <g class="ftth-flow-node" transform={`translate(${x} ${y})`}>
            <rect
              class="ftth-flow-node-bg"
              x="0" y="0"
              width={w} height={h}
              rx="10" ry="10"
              fill="url(#ftth-flow-node)"
              stroke="#F8B400"
              stroke-width="1.5"
              stroke-opacity="0.7"
            />
            <text
              class="ftth-flow-node-kicker"
              x={w / 2} y="26"
              text-anchor="middle"
              fill="#F8B400"
              font-size="11"
              font-family="var(--font-mono)"
              font-weight="700"
              letter-spacing="2"
            >{node.kicker}</text>
            <line
              x1="20" y1="40"
              x2={w - 20} y2="40"
              stroke="#ED1D24"
              stroke-width="1"
              stroke-opacity="0.5"
            />
            <g class="ftth-flow-node-label" font-family="var(--font-display)" font-weight="800" fill="#FFFFFF" text-anchor="middle">
              {node.lines.map((line, li) => (
                <text
                  x={w / 2}
                  y={72 + li * 22}
                  font-size={line.length > 10 ? 16 : 18}
                  letter-spacing="-0.01em"
                >{line}</text>
              ))}
            </g>
          </g>
        );
      })}
    </g>
  </svg>
</section>

<style>
  .ftth-flow {
    width: 100%;
  }

  .ftth-flow-title {
    /* Accesibilidad: heading real pero visualmente oculto. */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ftth-flow-svg {
    display: block;
    width: 100%;
    height: auto;
    max-width: 1100px;
    margin: 0 auto;
  }

  .ftth-flow-node-bg {
    transition: stroke-opacity 0.3s var(--ease-marvel),
                filter 0.3s var(--ease-marvel);
  }

  .ftth-flow-edge {
    fill: none;
    stroke: url(#ftth-flow-edge);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 6 6;
  }

  /* Desktop: pulse + scan-line a lo largo de los conectores. */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .ftth-flow-edge {
      animation: ftth-flow-dash 2.4s linear infinite;
    }
    .ftth-flow-edge-2 { animation-delay: 0.3s; }
    .ftth-flow-edge-3 { animation-delay: 0.6s; }
    .ftth-flow-edge-4 { animation-delay: 0.9s; }
    .ftth-flow-edge-5 { animation-delay: 1.2s; }

    .ftth-flow-node-bg {
      animation: ftth-flow-glow 3.6s ease-in-out infinite;
    }
    .ftth-flow-node:nth-child(2n) .ftth-flow-node-bg { animation-delay: 0.6s; }
    .ftth-flow-node:nth-child(3n) .ftth-flow-node-bg { animation-delay: 1.2s; }
    .ftth-flow-node:nth-child(4n) .ftth-flow-node-bg { animation-delay: 1.8s; }
    .ftth-flow-node:nth-child(5n) .ftth-flow-node-bg { animation-delay: 2.4s; }

    @keyframes ftth-flow-dash {
      from { stroke-dashoffset: 24; }
      to   { stroke-dashoffset: 0; }
    }
    @keyframes ftth-flow-glow {
      0%, 100% {
        filter: drop-shadow(0 0 2px rgba(248, 180, 0, 0.2));
        stroke-opacity: 0.7;
      }
      50% {
        filter: drop-shadow(0 0 10px rgba(248, 180, 0, 0.6));
        stroke-opacity: 1;
      }
    }
  }

  /* Móvil: nada se mueve. Las marcas de animación se omiten a propósito
     (en mobile el SVG ya queda apretado, sumar movimiento distrae). */
  @media (max-width: 767px) {
    .ftth-flow-edge { stroke-dasharray: none; }
  }

  /* Respeto global: si el SO pide reduced-motion, apagamos TODO. */
  @media (prefers-reduced-motion: reduce) {
    .ftth-flow-edge,
    .ftth-flow-node-bg {
      animation: none !important;
      stroke-dasharray: none;
    }
  }
</style>
