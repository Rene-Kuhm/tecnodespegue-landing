---
/**
 * Why.astro - Versión Marvel
 * Header con kicker, lista con iconos bevel, consola con border dorado
 */

import Icon from './Icon.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';
const copy = {
  es: {
    kicker: 'PROCESO · 04',
    title: ['Por qué', 'TecnoDespegue'],
    lead: 'No somos solo desarrolladores; somos socios estratégicos en la evolución técnica de tu negocio. La diferencia no se ve solo en el código — se ve en los resultados.',
    items: [
      ['Foco Técnico', 'Hardware-level mindset aplicado al desarrollo web. Optimizamos hasta el ciclo de CPU.'],
      ['Código Limpio', 'Documentación rigurosa y patrones de diseño modernos. Sin deuda técnica oculta.'],
      ['Comunicación Transparente', 'Acceso directo a los ingenieros, sin intermediarios ni tickets de soporte eternos.'],
    ],
    footer: 'Cada entrega deja evidencia: especificaciones, pruebas, CI y decisiones documentadas.',
  },
  en: {
    kicker: 'PROCESS · 04',
    title: ['Why', 'TecnoDespegue'],
    lead: 'We are not just developers; we are strategic partners in the technical evolution of your business. The difference is not only in the code, it shows up in the results.',
    items: [
      ['Technical Focus', 'A hardware-level mindset applied to web development. We optimize down to the CPU cycle.'],
      ['Clean Code', 'Rigorous documentation and modern design patterns. No hidden technical debt.'],
      ['Transparent Communication', 'Direct access to engineers, with no middlemen or endless support tickets.'],
    ],
    footer: 'Every delivery leaves evidence: specifications, tests, CI, and documented decisions.',
  },
}[locale];
---

<section class="py-32 relative" id="proceso" data-why>
  <div class="max-w-7xl mx-auto px-6 md:px-8 grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

    <!-- Left column -->
    <div class="why-left">
      <span class="kicker">
        <span class="kicker-dot"></span>
        <span class="kicker-text font-mono">{copy.kicker}</span>
      </span>

      <h2 class="why-title font-display">
        <span class="why-title-line">{copy.title[0]}</span>
        <span class="why-title-line why-title-accent">{copy.title[1]}</span>
      </h2>

      <p class="why-lead">
        {copy.lead}
      </p>

      <ul class="why-list">
        <li class="why-item" data-why-item>
          <div class="why-item-icon why-item-icon-red">
            <Icon name="bolt" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="why-item-title">{copy.items[0][0]}</h3>
            <p class="why-item-desc">{copy.items[0][1]}</p>
          </div>
        </li>

        <li class="why-item" data-why-item>
          <div class="why-item-icon why-item-icon-gold">
            <Icon name="terminal" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="why-item-title">{copy.items[1][0]}</h3>
            <p class="why-item-desc">{copy.items[1][1]}</p>
          </div>
        </li>

        <li class="why-item" data-why-item>
          <div class="why-item-icon why-item-icon-cosmic">
            <Icon name="forum" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="why-item-title">{copy.items[2][0]}</h3>
            <p class="why-item-desc">{copy.items[2][1]}</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Right column: Console -->
    <div class="why-right">
      <div class="why-console-wrap" aria-hidden="true"></div>

      <div class="why-console">
        <div class="why-console-bar">
          <div class="why-console-dots">
            <span class="why-dot why-dot-red"></span>
            <span class="why-dot why-dot-yellow"></span>
            <span class="why-dot why-dot-green"></span>
          </div>
          <span class="why-console-title font-mono">~/tecnodespegue · deploy.sh</span>
          <span class="why-console-status font-mono">
            <span class="why-console-pulse"></span>
            ACTIVE
          </span>
        </div>

        <div class="why-console-body font-mono">
          <div class="why-console-line">
            <span class="why-prompt">$</span>
            <span>pnpm test:all &amp;&amp; pytest</span>
          </div>
          <div class="why-console-output">
            <div><span class="why-arrow">→</span> validating requirements <span class="why-ok">✓ traceable</span></div>
            <div><span class="why-arrow">→</span> running automated tests <span class="why-ok">✓ verified</span></div>
            <div><span class="why-arrow">→</span> building optimized assets <span class="why-ok">✓ budgeted</span></div>
            <div><span class="why-arrow">→</span> checking deployment health <span class="why-ok">✓ observable</span></div>
          </div>

          <div class="why-console-line">
            <span class="why-prompt">$</span>
            <span>engineering-evidence --latest</span>
          </div>

          <div class="why-metrics">
            <div class="why-metric">
              <div class="why-metric-label">REQUIREMENTS</div>
              <div class="why-metric-num">SDD</div>
            </div>
            <div class="why-metric">
              <div class="why-metric-label">BEHAVIOR</div>
              <div class="why-metric-num why-metric-num-gold">BDD</div>
            </div>
            <div class="why-metric">
              <div class="why-metric-label">DELIVERY</div>
              <div class="why-metric-num why-ok-num">CI</div>
            </div>
            <div class="why-metric">
              <div class="why-metric-label">DECISIONS</div>
              <div class="why-metric-num">ADR</div>
            </div>
          </div>

          <div class="why-console-line">
            <span class="why-prompt">$</span>
            <span class="why-cursor">_</span>
          </div>
        </div>

        <div class="why-console-foot">
          <p>{copy.footer}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-red);
    box-shadow: 0 0 12px var(--color-marvel-red-glow);
    animation: energy-pulse 2s ease-in-out infinite;
  }
  .kicker-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
  }

  .why-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
    overflow: visible;
  }
  .why-title-line { display: block; }
  .why-title-accent {
    font-style: italic;
    color: var(--color-marvel-gold);
    text-shadow: 0 0 24px rgba(248, 180, 0, 0.25);
  }

  .why-lead {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    margin: 0 0 2.5rem;
  }
  .why-strong { color: #FFFFFF; font-weight: 600; }

  .why-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .why-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .why-item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 0.5rem;
    flex-shrink: 0;
    border: 1.5px solid;
    transition: transform 0.3s var(--ease-marvel);
  }
  .why-item-icon-red {
    background: rgba(237, 29, 36, 0.1);
    border-color: var(--color-marvel-red);
    color: var(--color-marvel-red-glow);
    box-shadow: 0 0 20px rgba(237, 29, 36, 0.2);
  }
  .why-item-icon-gold {
    background: rgba(248, 180, 0, 0.1);
    border-color: var(--color-marvel-gold);
    color: var(--color-marvel-gold-bright);
    box-shadow: 0 0 20px rgba(248, 180, 0, 0.2);
  }
  .why-item-icon-cosmic {
    background: rgba(107, 45, 142, 0.15);
    border-color: var(--color-marvel-cosmic-bright);
    color: var(--color-marvel-cosmic-bright);
    box-shadow: 0 0 20px rgba(107, 45, 142, 0.3);
  }
  .why-item:hover .why-item-icon { transform: rotate(-8deg) scale(1.1); }

  .why-item-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 0.375rem;
  }
  .why-item-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  /* Console */
  .why-right { position: relative; }

  .why-console-wrap {
    position: absolute;
    inset: -1.5rem;
    background: radial-gradient(circle at center, rgba(248, 180, 0, 0.15) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .why-console {
    position: relative;
    background: var(--color-surface-1);
    border: 2px solid #000;
    border-radius: 0.75rem;
    box-shadow:
      0 0 0 1px var(--color-marvel-gold),
      0 32px 64px -16px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }

  .why-console-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .why-console-dots { display: flex; gap: 0.375rem; }
  .why-dot { width: 10px; height: 10px; border-radius: 50%; }
  .why-dot-red { background: #ef4444; }
  .why-dot-yellow { background: #eab308; }
  .why-dot-green { background: #22c55e; }

  .why-console-title { font-size: 0.7rem; color: var(--color-on-surface-variant); }

  .why-console-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6rem;
    color: var(--color-secondary);
    letter-spacing: 0.15em;
  }
  .why-console-pulse {
    width: 6px;
    height: 6px;
    background: var(--color-secondary);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-secondary);
    animation: energy-pulse 1.4s ease-in-out infinite;
  }

  .why-console-body { padding: 1.25rem; font-size: 0.8rem; line-height: 1.6; }

  .why-console-line {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .why-prompt { color: var(--color-secondary); }
  .why-arrow { color: var(--color-primary); margin-right: 0.375rem; }
  .why-ok { color: var(--color-secondary); font-weight: 600; }
  .why-ok-num { color: var(--color-secondary); }

  .why-console-output {
    color: var(--color-on-surface-variant);
    padding: 0.5rem 0 0.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.75rem;
  }

  .why-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
    margin: 1rem 0;
  }

  .why-metric {
    background: var(--color-surface-2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.375rem;
    padding: 0.625rem 0.75rem;
  }
  .why-metric-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-on-surface-variant);
    margin-bottom: 0.25rem;
  }
  .why-metric-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1;
    color: #FFFFFF;
  }
  .why-metric-num-gold {
    color: var(--color-marvel-gold);
    text-shadow: 0 0 12px rgba(248, 180, 0, 0.3);
  }

  .why-cursor {
    display: inline-block;
    color: var(--color-secondary);
    animation: blink-cursor 1s step-end infinite;
  }
  @keyframes blink-cursor { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  .why-console-foot {
    padding: 0.875rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.3);
  }
  .why-console-foot p {
    font-size: 0.75rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
    margin: 0;
  }
</style>
