---
/**
 * Portfolio.astro - Versión Marvel
 * Cards con hover cinemático, esquinas cómic, scan line, comic accents
 */

import Icon from './Icon.astro';
import GlowOrbs from './GlowOrbs.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';

const projectsByLocale = {
  es: [
  {
    title: "flow-engineering",
    description: "Plataforma de ingeniería para trabajar con contexto estructurado, especificaciones y verificación. El repositorio registra 541 commits, suites unitarias, BDD y E2E, CI y gobernanza técnica.",
    stack: ["Go", "SDD", "MCP", "BDD", "E2E", "CI"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/flow-engineering",
    caseUrl: "/casos/flow-engineering",
    type: "Arquitectura & Tooling",
    status: "Código y caso de estudio públicos",
    icon: "account_tree",
    color: "red",
  },
  {
    title: "Vaulta — Password Manager",
    description: "Gestor de contraseñas multiplataforma, open source y offline-first. El repositorio documenta arquitectura limpia, contratos de seguridad, cifrado local y releases descargables para Android y Windows.",
    stack: ["Flutter", "Dart", "Material 3", "Encryption"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/vaulta",
    caseUrl: "/casos/vaulta",
    type: "Mobile & Desktop",
    status: "Release público",
    icon: "check_circle",
    color: "gold",
  },
  {
    title: "TecnoDespegue Landing",
    description: "Este sitio: una landing bilingüe construida con Astro, contenido tipado, SEO técnico, seguridad por headers, CI y pruebas Playwright para desktop y mobile.",
    stack: ["Astro", "TypeScript", "Playwright", "Tailwind", "Vercel"],
    link: "https://www.tecnodespegue.com",
    repo: "https://github.com/Rene-Kuhm/tecnodespegue-landing",
    type: "Web & Producto",
    status: "Sitio público",
    icon: "language",
    color: "cosmic",
  },
  {
    title: "HydroTemp AIO Driver",
    description: "Ingeniería inversa completa del protocolo HID de displays AIO. Driver macOS nativo que lee sensores de CPU, GPU y fans en tiempo real a 200ms de refresh.",
    stack: ["Python", "USB HID", "macOS", "LaunchAgent"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/hydrotemp-aio-mac",
    type: "Hardware & Drivers",
    status: "Código público",
    icon: "memory",
    color: "red",
  },
  {
    title: "KineIA",
    description: "Proyecto de IA aplicada con recuperación aumentada por contexto. Se presenta como trabajo en evolución: la evidencia pública está en el código y la documentación del repositorio.",
    stack: ["Python", "RAG", "AI", "Vector Search"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/KineIA",
    type: "IA & RAG",
    status: "En evolución",
    icon: "psychology",
    color: "gold",
  },
  {
    title: "Tecno-JARVIS",
    description: "Asistente de automatización distribuido como proyecto open source con releases públicas. El repositorio permite revisar implementación, instalación y evolución del producto.",
    stack: ["Python", "Automation", "AI", "Releases"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/tecno-jarvis",
    type: "IA & Automatización",
    status: "Código y releases públicos",
    icon: "smart_toy",
    color: "cosmic",
  }
],
  en: [
  {
    title: "flow-engineering",
    description: "Engineering platform for structured context, specifications, and verification. The repository records 541 commits, unit, BDD, and E2E suites, CI, and technical governance.",
    stack: ["Go", "SDD", "MCP", "BDD", "E2E", "CI"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/flow-engineering",
    caseUrl: "/en/case-studies/flow-engineering",
    type: "Architecture & Tooling",
    status: "Public source & case study",
    icon: "account_tree",
    color: "red",
  },
  {
    title: "Vaulta — Password Manager",
    description: "Open-source, offline-first, cross-platform password manager. Its repository documents clean architecture, security contracts, local encryption, and downloadable Android and Windows releases.",
    stack: ["Flutter", "Dart", "Material 3", "Encryption"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/vaulta",
    caseUrl: "/en/case-studies/vaulta",
    type: "Mobile & Desktop",
    status: "Public release",
    icon: "check_circle",
    color: "gold",
  },
  {
    title: "TecnoDespegue Landing",
    description: "This site: a bilingual Astro landing page with typed content, technical SEO, security headers, CI, and Playwright coverage across desktop and mobile.",
    stack: ["Astro", "TypeScript", "Playwright", "Tailwind", "Vercel"],
    link: "https://www.tecnodespegue.com",
    repo: "https://github.com/Rene-Kuhm/tecnodespegue-landing",
    type: "Web & Product",
    status: "Public site",
    icon: "language",
    color: "cosmic",
  },
  {
    title: "HydroTemp AIO Driver",
    description: "Full reverse engineering of the HID protocol for AIO displays. Native macOS driver that reads CPU, GPU, and fan sensors in real time at 200ms refresh.",
    stack: ["Python", "USB HID", "macOS", "LaunchAgent"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/hydrotemp-aio-mac",
    type: "Hardware & Drivers",
    status: "Public source",
    icon: "memory",
    color: "red",
  },
  {
    title: "KineIA",
    description: "Applied AI project with retrieval-augmented context. It is presented as evolving work: public evidence lives in the repository's code and documentation.",
    stack: ["Python", "RAG", "AI", "Vector Search"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/KineIA",
    type: "AI & RAG",
    status: "In progress",
    icon: "psychology",
    color: "gold",
  },
  {
    title: "Tecno-JARVIS",
    description: "Automation assistant distributed as an open-source project with public releases. The repository exposes its implementation, setup, and product evolution.",
    stack: ["Python", "Automation", "AI", "Releases"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/tecno-jarvis",
    type: "AI & Automation",
    status: "Public source & releases",
    icon: "smart_toy",
    color: "cosmic",
  }
]};

const copy = {
  es: {
    kicker: 'PORTFOLIO · 02',
    title: ['Proyectos', 'Reales,', 'Código Real'],
    lead: 'Casos con estado y evidencia explícitos. Código público cuando existe; alcance y límites claros cuando el trabajo es privado o está en evolución.',
    live: 'Ver en vivo',
    source: 'Código fuente',
    caseStudy: 'Ver caso de estudio',
  },
  en: {
    kicker: 'PORTFOLIO · 02',
    title: ['Real', 'Projects,', 'Real Code'],
    lead: 'Case studies with explicit status and evidence. Public source when available; clear scope and limits for private or evolving work.',
    live: 'View live',
    source: 'Source code',
    caseStudy: 'View case study',
  },
}[locale];

const projects = projectsByLocale[locale].map(project => ({ caseUrl: '', ...project }));
---

<section class="py-32 relative overflow-hidden" id="portfolio" data-portfolio>
  <!-- Glow orbs (atmospheric depth) -->
  <GlowOrbs intensity={0.5} />

  <div class="portfolio-bg" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-8 relative z-10">
    <!-- Header -->
    <header class="port-header">
      <div>
        <span class="kicker">
          <span class="kicker-dot"></span>
          <span class="kicker-text font-mono">{copy.kicker}</span>
        </span>
        <h2 class="port-title font-display">
          <span class="port-title-line">{copy.title[0]}</span>
          <span class="port-title-line text-shine">{copy.title[1]}</span>
          <span class="port-title-line">{copy.title[2]}</span>
        </h2>
        <p class="port-lead">
          {copy.lead}
        </p>
      </div>
    </header>

    <!-- Grid -->
    <div class="port-grid">
      {projects.map((project, index) => (
        <article class={`port-card port-card-${index === 0 ? 'lg' : 'sm'}`} data-port-card>
          <!-- Background gradient -->
          <div class={`port-card-bg port-card-bg-${project.color}`} aria-hidden="true"></div>

          <!-- Esquinas cómic -->
          <div class="port-corner port-corner-tl" aria-hidden="true"></div>
          <div class="port-corner port-corner-tr" aria-hidden="true"></div>
          <div class="port-corner port-corner-bl" aria-hidden="true"></div>
          <div class="port-corner port-corner-br" aria-hidden="true"></div>

          <!-- Scan line en hover -->
          <div class="port-card-scan" aria-hidden="true"></div>

          <div class="port-card-inner">
            <!-- Header -->
            <div class="port-card-head">
              <div class="port-card-meta">
                <span class="port-card-type">{project.type}</span>
                <span class="port-card-status">{project.status}</span>
              </div>
              <div class={`port-card-icon port-card-icon-${project.color}`}>
                <Icon name={project.icon} class="w-5 h-5" />
              </div>
            </div>

            <!-- Title + Description -->
            <h3 class="port-card-title font-display">{project.title}</h3>
            <p class="port-card-desc">{project.description}</p>

            <!-- Stack -->
            <div class="port-card-stack">
              {project.stack.map((tech) => (
                <span class="port-card-tech">{tech}</span>
              ))}
            </div>

            <!-- Actions -->
            <div class="port-card-actions">
              {project.caseUrl && (
                <a href={project.caseUrl} class="port-link port-link-live" data-analytics-event="Portfolio Project Open" data-analytics-project={project.title} data-analytics-locale={locale} data-magnetic>
                  <Icon name="article" class="w-4 h-4" />
                  <span>{copy.caseStudy}</span>
                </a>
              )}
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="port-link port-link-live" data-analytics-event="Portfolio Project Open" data-analytics-project={project.title} data-analytics-locale={locale} data-magnetic>
                  <Icon name="open_in_new" class="w-4 h-4" />
                  <span>{copy.live}</span>
                </a>
              )}
              {project.repo && (
                <a href={project.repo} target="_blank" rel="noopener noreferrer" class="port-link port-link-repo" data-analytics-event="Portfolio Project Open" data-analytics-project={project.title} data-analytics-locale={locale} data-magnetic>
                  <Icon name="code" class="w-4 h-4" />
                  <span>{copy.source}</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-analytics-event="Portfolio Project Open"]').forEach((link) => {
    link.addEventListener('click', () => {
      window.plausible?.('Portfolio Project Open', { props: {
        locale: link.dataset.analyticsLocale || 'unknown',
        project: link.dataset.analyticsProject || 'unknown',
        placement: 'portfolio',
      }});
    });
  });
</script>

<style>
  .portfolio-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(248, 180, 0, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248, 180, 0, 0.025) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
  }

  .port-header {
    margin-bottom: 4rem;
    max-width: 56rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-red);
    box-shadow: 0 0 12px var(--color-marvel-red-glow);
    animation: energy-pulse 2s ease-in-out infinite;
  }
  .kicker-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
  }

  .port-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }
  .port-title-line { display: block; }

  .port-lead {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    max-width: 38rem;
  }

  /* Grid */
  .port-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .port-grid {
      grid-template-columns: repeat(12, 1fr);
    }
  }

  .port-card-lg { grid-column: span 12; }
  .port-card-sm { grid-column: span 12; }

  @media (min-width: 768px) {
    .port-card-lg { grid-column: span 8; }
    .port-card-sm { grid-column: span 4; }

    /* Pattern bento: alternamos tamaños */
    .port-card:nth-child(3) { grid-column: span 4; }
    .port-card:nth-child(4) { grid-column: span 8; }
    .port-card:nth-child(5) { grid-column: span 6; }
    .port-card:nth-child(6) { grid-column: span 6; }
  }

  /* Card */
  .port-card {
    position: relative;
    background: var(--color-surface-1);
    border: 2px solid #000;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(248, 180, 0, 0.15), 0 24px 48px -16px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s var(--ease-marvel), box-shadow 0.4s;
    isolation: isolate;
  }

  .port-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px var(--color-marvel-red),
      0 0 0 4px rgba(237, 29, 36, 0.2),
      0 32px 64px -12px rgba(237, 29, 36, 0.4);
  }

  /* Background accent */
  .port-card-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s;
    z-index: -1;
  }
  .port-card-bg-red {
    background: radial-gradient(ellipse at top right, rgba(237, 29, 36, 0.15) 0%, transparent 60%);
  }
  .port-card-bg-gold {
    background: radial-gradient(ellipse at top right, rgba(248, 180, 0, 0.12) 0%, transparent 60%);
  }
  .port-card-bg-cosmic {
    background: radial-gradient(ellipse at top right, rgba(107, 45, 142, 0.18) 0%, transparent 60%);
  }
  .port-card:hover .port-card-bg { opacity: 1; }

  /* Esquinas cómic */
  .port-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--color-marvel-red);
    transition: inset 0.4s var(--ease-marvel);
    z-index: 2;
  }
  .port-corner-tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .port-corner-tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .port-corner-bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .port-corner-br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  .port-card:hover .port-corner-tl { top: -5px; left: -5px; }
  .port-card:hover .port-corner-tr { top: -5px; right: -5px; }
  .port-card:hover .port-corner-bl { bottom: -5px; left: -5px; }
  .port-card:hover .port-corner-br { bottom: -5px; right: -5px; }

  /* Scan line */
  .port-card-scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-marvel-gold) 50%, transparent 100%);
    box-shadow: 0 0 12px var(--color-marvel-gold);
    top: 0;
    opacity: 0;
    z-index: 3;
    pointer-events: none;
  }
  .port-card:hover .port-card-scan {
    opacity: 0.7;
    animation: scan-sweep 1.6s ease-in-out infinite;
  }

  @keyframes scan-sweep {
    0% { top: 0; }
    100% { top: 100%; }
  }

  .port-card-inner { padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; height: 100%; }

  .port-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .port-card-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; min-width: 0; }

  .port-card-status {
    font-size: 0.67rem;
    color: rgba(255, 255, 255, 0.58);
  }

  .port-card-type {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-marvel-gold);
    background: rgba(248, 180, 0, 0.08);
    border: 1px solid rgba(248, 180, 0, 0.25);
    padding: 0.3rem 0.625rem;
    border-radius: 0.25rem;
  }

  .port-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.375rem;
    background: var(--color-surface-2);
    border: 1px solid rgba(248, 180, 0, 0.2);
    color: var(--color-marvel-gold);
  }
  .port-card-icon-red { color: var(--color-marvel-red-glow); border-color: rgba(237, 29, 36, 0.3); }
  .port-card-icon-cosmic { color: var(--color-marvel-cosmic-bright); border-color: rgba(177, 78, 255, 0.3); }

  .port-card-title {
    font-weight: 900;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 0;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .port-card:hover .port-card-title { color: var(--color-marvel-gold-bright); }

  .port-card-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .port-card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .port-card-tech {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-on-surface-variant);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.25rem;
  }

  .port-card-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .port-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.2s, transform 0.2s;
  }
  .port-link-live { color: var(--color-marvel-gold); }
  .port-link-repo { color: var(--color-on-surface-variant); }
  .port-link:hover { transform: translateX(2px); }
  .port-link-live:hover { color: var(--color-marvel-gold-bright); }
  .port-link-repo:hover { color: var(--color-marvel-gold); }
</style>
