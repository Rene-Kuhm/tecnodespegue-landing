---
/**
 * Portfolio.astro - Versión Marvel
 * Cards con hover cinemático, esquinas cómic, scan line, comic accents
 */

import Icon from './Icon.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';

const projectsByLocale = {
  es: [
  {
    title: "Aguamarina Mosaicos",
    description: "Sistema e-commerce empresarial completo con tienda online, panel de administración y API REST. Catálogo de productos, gestión de pedidos y métricas en tiempo real.",
    stack: ["Next.js 15", "React 19", "TypeScript", "PostgreSQL", "Railway"],
    link: "https://aguamarinamosaicos.com",
    repo: "https://github.com/Rene-Kuhm/acuamarina-ceramica",
    type: "E-Commerce",
    icon: "storefront",
    color: "red",
  },
  {
    title: "E-Commerce Premium",
    description: "Plataforma e-commerce con diseño premium inspirado en Nike/Adidas. Filtros avanzados, carrito persistente, checkout con validación Zod y accesibilidad WCAG 2.1 AA.",
    stack: ["Next.js", "React 19", "TypeScript", "Tailwind", "Zod"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/e-commerce-profecional",
    type: "E-Commerce",
    icon: "shopping_bag",
    color: "gold",
  },
  {
    title: "TecnoDespegue Automation",
    description: "Pipeline de automatización con IA que genera contenido, crea imágenes con GPT-5 y publica automáticamente en Instagram, Facebook y TikTok vía cron jobs.",
    stack: ["Python", "OpenClaw", "OpenRouter", "Postiz", "Docker"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/tecnodespegue-automation",
    type: "IA & Automatización",
    icon: "smart_toy",
    color: "cosmic",
  },
  {
    title: "HydroTemp AIO Driver",
    description: "Ingeniería inversa completa del protocolo HID de displays AIO. Driver macOS nativo que lee sensores de CPU, GPU y fans en tiempo real a 200ms de refresh.",
    stack: ["Python", "USB HID", "macOS", "LaunchAgent"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/hydrotemp-aio-mac",
    type: "Hardware & Drivers",
    icon: "memory",
    color: "red",
  },
  {
    title: "Vaulta — Password Manager",
    description: "Gestor de contraseñas multiplataforma con Material 3, arquitectura limpia, contratos de seguridad y cifrado. Dashboard con métricas de seguridad del vault.",
    stack: ["Flutter", "Dart", "Material 3", "Encryption"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/vaulta",
    type: "Mobile & Desktop",
    icon: "lock",
    color: "gold",
  },
  {
    title: "CampusMind",
    description: "SaaS educativa con IA para estudiantes universitarios hispanohablantes. RAG pipeline sobre documentos académicos, flashcards con repetición espaciada, quiz automático y billing integrado.",
    stack: ["Next.js 16", "NestJS", "Turborepo", "pgvector", "GPT-4o", "Gemini"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/CampusMind-sass",
    type: "SaaS & IA",
    icon: "school",
    color: "cosmic",
  }
],
  en: [
  {
    title: "Aguamarina Mosaicos",
    description: "Complete enterprise e-commerce system with online store, admin panel, and REST API. Product catalog, order management, and real-time metrics.",
    stack: ["Next.js 15", "React 19", "TypeScript", "PostgreSQL", "Railway"],
    link: "https://aguamarinamosaicos.com",
    repo: "https://github.com/Rene-Kuhm/acuamarina-ceramica",
    type: "E-Commerce",
    icon: "storefront",
    color: "red",
  },
  {
    title: "Premium E-Commerce",
    description: "Premium e-commerce platform inspired by Nike/Adidas. Advanced filters, persistent cart, Zod-validated checkout, and WCAG 2.1 AA accessibility.",
    stack: ["Next.js", "React 19", "TypeScript", "Tailwind", "Zod"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/e-commerce-profecional",
    type: "E-Commerce",
    icon: "shopping_bag",
    color: "gold",
  },
  {
    title: "TecnoDespegue Automation",
    description: "AI automation pipeline that generates content, creates images with GPT-5, and posts automatically to Instagram, Facebook, and TikTok through cron jobs.",
    stack: ["Python", "OpenClaw", "OpenRouter", "Postiz", "Docker"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/tecnodespegue-automation",
    type: "AI & Automation",
    icon: "smart_toy",
    color: "cosmic",
  },
  {
    title: "HydroTemp AIO Driver",
    description: "Full reverse engineering of the HID protocol for AIO displays. Native macOS driver that reads CPU, GPU, and fan sensors in real time at 200ms refresh.",
    stack: ["Python", "USB HID", "macOS", "LaunchAgent"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/hydrotemp-aio-mac",
    type: "Hardware & Drivers",
    icon: "memory",
    color: "red",
  },
  {
    title: "Vaulta — Password Manager",
    description: "Cross-platform password manager with Material 3, clean architecture, security contracts, and encryption. Dashboard with vault security metrics.",
    stack: ["Flutter", "Dart", "Material 3", "Encryption"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/vaulta",
    type: "Mobile & Desktop",
    icon: "lock",
    color: "gold",
  },
  {
    title: "CampusMind",
    description: "AI education SaaS for Spanish-speaking university students. RAG pipeline over academic documents, spaced-repetition flashcards, automatic quizzes, and integrated billing.",
    stack: ["Next.js 16", "NestJS", "Turborepo", "pgvector", "GPT-4o", "Gemini"],
    link: "",
    repo: "https://github.com/Rene-Kuhm/CampusMind-sass",
    type: "SaaS & AI",
    icon: "school",
    color: "cosmic",
  }
]};

const copy = {
  es: {
    kicker: 'PORTFOLIO · 02',
    title: ['Proyectos', 'Reales,', 'Código Real'],
    lead: 'No mockups. No demos. Sistemas en producción que resuelven problemas reales. Cada uno en su universo, todos con el mismo ADN.',
    live: 'Ver en vivo',
    source: 'Código fuente',
  },
  en: {
    kicker: 'PORTFOLIO · 02',
    title: ['Real', 'Projects,', 'Real Code'],
    lead: 'No mockups. No demos. Production systems that solve real problems. Each in its own universe, all with the same DNA.',
    live: 'View live',
    source: 'Source code',
  },
}[locale];

const projects = projectsByLocale[locale];
---

<section class="py-32 relative" id="portfolio" data-portfolio>
  <div class="portfolio-bg" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-8 relative z-10">
    <!-- Header -->
    <header class="port-header">
      <div>
        <span class="kicker">
          <span class="kicker-dot"></span>
          <span class="kicker-text font-mono">{copy.kicker}</span>
        </span>
        <h2 class="port-title font-display">
          <span class="port-title-line">{copy.title[0]}</span>
          <span class="port-title-line text-shine">{copy.title[1]}</span>
          <span class="port-title-line">{copy.title[2]}</span>
        </h2>
        <p class="port-lead">
          {copy.lead}
        </p>
      </div>
    </header>

    <!-- Grid -->
    <div class="port-grid">
      {projects.map((project, index) => (
        <article class={`port-card port-card-${index === 0 ? 'lg' : 'sm'}`} data-port-card>
          <!-- Background gradient -->
          <div class={`port-card-bg port-card-bg-${project.color}`} aria-hidden="true"></div>

          <!-- Esquinas cómic -->
          <div class="port-corner port-corner-tl" aria-hidden="true"></div>
          <div class="port-corner port-corner-tr" aria-hidden="true"></div>
          <div class="port-corner port-corner-bl" aria-hidden="true"></div>
          <div class="port-corner port-corner-br" aria-hidden="true"></div>

          <!-- Scan line en hover -->
          <div class="port-card-scan" aria-hidden="true"></div>

          <div class="port-card-inner">
            <!-- Header -->
            <div class="port-card-head">
              <span class="port-card-type">{project.type}</span>
              <div class={`port-card-icon port-card-icon-${project.color}`}>
                <Icon name={project.icon} class="w-5 h-5" />
              </div>
            </div>

            <!-- Title + Description -->
            <h3 class="port-card-title font-display">{project.title}</h3>
            <p class="port-card-desc">{project.description}</p>

            <!-- Stack -->
            <div class="port-card-stack">
              {project.stack.map((tech) => (
                <span class="port-card-tech">{tech}</span>
              ))}
            </div>

            <!-- Actions -->
            <div class="port-card-actions">
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="port-link port-link-live" data-magnetic>
                  <Icon name="open_in_new" class="w-4 h-4" />
                  <span>{copy.live}</span>
                </a>
              )}
              <a href={project.repo} target="_blank" rel="noopener noreferrer" class="port-link port-link-repo" data-magnetic>
                <Icon name="code" class="w-4 h-4" />
                <span>{copy.source}</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .portfolio-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(248, 180, 0, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248, 180, 0, 0.025) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
  }

  .port-header {
    margin-bottom: 4rem;
    max-width: 56rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-red);
    box-shadow: 0 0 12px var(--color-marvel-red-glow);
    animation: energy-pulse 2s ease-in-out infinite;
  }
  .kicker-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
  }

  .port-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }
  .port-title-line { display: block; }

  .port-lead {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    max-width: 38rem;
  }

  /* Grid */
  .port-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .port-grid {
      grid-template-columns: repeat(12, 1fr);
    }
  }

  .port-card-lg { grid-column: span 12; }
  .port-card-sm { grid-column: span 12; }

  @media (min-width: 768px) {
    .port-card-lg { grid-column: span 8; }
    .port-card-sm { grid-column: span 4; }

    /* Pattern bento: alternamos tamaños */
    .port-card:nth-child(3) { grid-column: span 4; }
    .port-card:nth-child(4) { grid-column: span 8; }
    .port-card:nth-child(5) { grid-column: span 6; }
    .port-card:nth-child(6) { grid-column: span 6; }
  }

  /* Card */
  .port-card {
    position: relative;
    background: var(--color-surface-1);
    border: 2px solid #000;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(248, 180, 0, 0.15), 0 24px 48px -16px rgba(0, 0, 0, 0.6);
    transition: transform 0.4s var(--ease-marvel), box-shadow 0.4s;
    isolation: isolate;
  }

  .port-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px var(--color-marvel-red),
      0 0 0 4px rgba(237, 29, 36, 0.2),
      0 32px 64px -12px rgba(237, 29, 36, 0.4);
  }

  /* Background accent */
  .port-card-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s;
    z-index: -1;
  }
  .port-card-bg-red {
    background: radial-gradient(ellipse at top right, rgba(237, 29, 36, 0.15) 0%, transparent 60%);
  }
  .port-card-bg-gold {
    background: radial-gradient(ellipse at top right, rgba(248, 180, 0, 0.12) 0%, transparent 60%);
  }
  .port-card-bg-cosmic {
    background: radial-gradient(ellipse at top right, rgba(107, 45, 142, 0.18) 0%, transparent 60%);
  }
  .port-card:hover .port-card-bg { opacity: 1; }

  /* Esquinas cómic */
  .port-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--color-marvel-red);
    transition: all 0.4s var(--ease-marvel);
    z-index: 2;
  }
  .port-corner-tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .port-corner-tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .port-corner-bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .port-corner-br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  .port-card:hover .port-corner-tl { top: -5px; left: -5px; }
  .port-card:hover .port-corner-tr { top: -5px; right: -5px; }
  .port-card:hover .port-corner-bl { bottom: -5px; left: -5px; }
  .port-card:hover .port-corner-br { bottom: -5px; right: -5px; }

  /* Scan line */
  .port-card-scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-marvel-gold) 50%, transparent 100%);
    box-shadow: 0 0 12px var(--color-marvel-gold);
    top: 0;
    opacity: 0;
    z-index: 3;
    pointer-events: none;
  }
  .port-card:hover .port-card-scan {
    opacity: 0.7;
    animation: scan-sweep 1.6s ease-in-out infinite;
  }

  @keyframes scan-sweep {
    0% { top: 0; }
    100% { top: 100%; }
  }

  .port-card-inner { padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; height: 100%; }

  .port-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .port-card-type {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-marvel-gold);
    background: rgba(248, 180, 0, 0.08);
    border: 1px solid rgba(248, 180, 0, 0.25);
    padding: 0.3rem 0.625rem;
    border-radius: 0.25rem;
  }

  .port-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.375rem;
    background: var(--color-surface-2);
    border: 1px solid rgba(248, 180, 0, 0.2);
    color: var(--color-marvel-gold);
  }
  .port-card-icon-red { color: var(--color-marvel-red-glow); border-color: rgba(237, 29, 36, 0.3); }
  .port-card-icon-cosmic { color: var(--color-marvel-cosmic-bright); border-color: rgba(177, 78, 255, 0.3); }

  .port-card-title {
    font-weight: 900;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 0;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .port-card:hover .port-card-title { color: var(--color-marvel-gold-bright); }

  .port-card-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .port-card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .port-card-tech {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-on-surface-variant);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.25rem;
  }

  .port-card-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .port-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.2s, transform 0.2s;
  }
  .port-link-live { color: var(--color-marvel-gold); }
  .port-link-repo { color: var(--color-on-surface-variant); }
  .port-link:hover { transform: translateX(2px); }
  .port-link-live:hover { color: var(--color-marvel-gold-bright); }
  .port-link-repo:hover { color: var(--color-marvel-gold); }
</style>
