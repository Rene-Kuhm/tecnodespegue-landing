---
import Icon from './Icon.astro';

const technologies = [
  { name: 'React',        icon: '/tech/react.svg' },
  { name: 'Next.js',      icon: '/tech/nextdotjs.svg' },
  { name: 'Astro',        icon: '/tech/astro.svg' },
  { name: 'Node.js',      icon: '/tech/nodedotjs.svg' },
  { name: 'TypeScript',   icon: '/tech/typescript.svg' },
  { name: 'Python',       icon: '/tech/python.svg' },
  { name: 'Flutter',      icon: '/tech/flutter.svg' },
  { name: 'Dart',         icon: '/tech/dart.svg' },
  { name: 'Tailwind CSS', icon: '/tech/tailwindcss.svg' },
  { name: 'PostgreSQL',   icon: '/tech/postgresql.svg' },
  { name: 'Docker',       icon: '/tech/docker.svg' },
  { name: 'AI / ML',      symbol: 'psychology' },
  { name: 'n8n',          icon: '/tech/n8n.svg' },
  { name: 'Railway',      icon: '/tech/railway.svg' },
  { name: 'Vercel',       icon: '/tech/vercel.svg' },
  { name: 'Linux',        icon: '/tech/linux.svg' }
];
---

<section class="py-24 bg-surface-container-low overflow-hidden" id="stack">
  <div class="max-w-7xl mx-auto px-8">
    <div class="text-center mb-16">
      <span class="text-xs font-mono text-primary-dim uppercase tracking-[0.4em] mb-4 block">
        Nuestro Arsenal
      </span>
      <h2 class="text-3xl font-headline font-bold">
        Tecnologías que Dominamos
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-8 gap-3">
      {technologies.map((tech) => (
        <div class="group flex flex-col items-center justify-center gap-3 p-6 bg-surface-container border border-white/5 rounded-card hover:border-primary/40 hover:bg-surface-container-high transition-all duration-300">
          <div class="h-10 w-10 flex items-center justify-center opacity-80 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300">
            {tech.icon ? (
              <img
                src={tech.icon}
                alt={`${tech.name} logo`}
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="h-10 w-10"
              />
            ) : tech.symbol ? (
              <Icon name={tech.symbol} class="w-10 h-10 text-primary" />
            ) : null}
          </div>
          <span class="text-[11px] font-mono text-on-surface-variant group-hover:text-primary transition-colors uppercase tracking-wider text-center">
            {tech.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
