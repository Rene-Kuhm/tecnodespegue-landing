---
/**
 * Tech.astro - Versión Marvel
 * Badges con glow dorado en hover, header con kicker
 */

import Icon from './Icon.astro';

const technologies = [
  { name: 'React',        icon: '/tech/react.svg' },
  { name: 'Next.js',      icon: '/tech/nextdotjs.svg' },
  { name: 'Astro',        icon: '/tech/astro.svg' },
  { name: 'Node.js',      icon: '/tech/nodedotjs.svg' },
  { name: 'TypeScript',   icon: '/tech/typescript.svg' },
  { name: 'Python',       icon: '/tech/python.svg' },
  { name: 'Flutter',      icon: '/tech/flutter.svg' },
  { name: 'Dart',         icon: '/tech/dart.svg' },
  { name: 'Tailwind CSS', icon: '/tech/tailwindcss.svg' },
  { name: 'PostgreSQL',   icon: '/tech/postgresql.svg' },
  { name: 'Docker',       icon: '/tech/docker.svg' },
  { name: 'AI / ML',      symbol: 'psychology' },
  { name: 'n8n',          icon: '/tech/n8n.svg' },
  { name: 'Railway',      icon: '/tech/railway.svg' },
  { name: 'Vercel',       icon: '/tech/vercel.svg' },
  { name: 'Linux',        icon: '/tech/linux.svg' }
];
---

<section class="py-32 relative overflow-hidden" id="stack" data-tech>
  <div class="tech-bg" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-8 relative z-10">
    <!-- Header -->
    <header class="tech-header">
      <span class="kicker">
        <span class="kicker-dot"></span>
        <span class="kicker-text font-mono">ARSENAL · 03</span>
      </span>
      <h2 class="tech-title font-display">
        <span class="tech-title-line">Tecnologías</span>
        <span class="tech-title-line text-shine">que Dominamos</span>
      </h2>
      <p class="tech-lead">
        El stack que sostiene cada despegue. Las mismas herramientas que usan Netflix, Stripe y los equipos de elite — seleccionadas, dominadas, listas para producción.
      </p>
    </header>

    <!-- Grid -->
    <div class="tech-grid">
      {technologies.map((tech) => (
        <div class="tech-cell" data-tech-cell data-magnetic>
          <div class="tech-cell-inner">
            <div class="tech-cell-icon">
              {tech.icon ? (
                <img
                  src={tech.icon}
                  alt={`${tech.name} logo`}
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                  class="h-10 w-10"
                />
              ) : tech.symbol ? (
                <Icon name={tech.symbol} class="w-10 h-10" />
              ) : null}
            </div>
            <span class="tech-cell-name">{tech.name}</span>
            <div class="tech-cell-glow" aria-hidden="true"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom callout -->
    <div class="tech-callout-wrap">
      <div class="tech-callout">
        <span class="tech-callout-icon" aria-hidden="true">✦</span>
        <span class="tech-callout-text font-mono">Y seguimos sumando. Si tu stack no está, lo aprendemos.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .tech-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(248, 180, 0, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .tech-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 4rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-red);
    box-shadow: 0 0 12px var(--color-marvel-red-glow);
    animation: energy-pulse 2s ease-in-out infinite;
  }
  .kicker-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
  }

  .tech-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }
  .tech-title-line { display: block; }

  .tech-lead {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
  }

  /* Grid */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .tech-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 768px) { .tech-grid { grid-template-columns: repeat(4, 1fr); gap: 1rem; } }
  @media (min-width: 1024px) { .tech-grid { grid-template-columns: repeat(8, 1fr); } }

  .tech-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-surface-1);
    border: 1px solid rgba(248, 180, 0, 0.12);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: transform 0.3s var(--ease-marvel), border-color 0.3s, box-shadow 0.3s;
  }

  .tech-cell:hover {
    transform: translateY(-4px) scale(1.03);
    border-color: var(--color-marvel-gold);
    box-shadow:
      0 0 0 1px var(--color-marvel-gold),
      0 16px 32px -8px rgba(248, 180, 0, 0.4);
  }

  .tech-cell-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.75rem;
  }

  .tech-cell-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface-variant);
    filter: grayscale(0.3);
    transition: filter 0.3s, color 0.3s, transform 0.3s;
  }
  .tech-cell:hover .tech-cell-icon {
    filter: grayscale(0);
    color: var(--color-marvel-gold);
    transform: scale(1.1);
  }

  .tech-cell-name {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    text-align: center;
    transition: color 0.3s;
  }
  .tech-cell:hover .tech-cell-name { color: #FFFFFF; }

  .tech-cell-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(248, 180, 0, 0.2) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .tech-cell:hover .tech-cell-glow { opacity: 1; }

  /* Callout */
  .tech-callout-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }
  .tech-callout {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.25rem;
    background: var(--color-surface-1);
    border: 1px solid rgba(248, 180, 0, 0.25);
    border-radius: 999px;
    color: var(--color-on-surface-variant);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .tech-callout-icon { color: var(--color-marvel-gold); font-size: 1rem; line-height: 1; text-shadow: 0 0 8px rgba(248, 180, 0, 0.6); }
</style>
