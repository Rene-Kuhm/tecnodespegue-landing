---
const { featuredCount = 3 } = Astro.props;
---

<section class="relative overflow-hidden pt-24 pb-10 md:pt-32 md:pb-16">
  <!-- Background geometric decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-10 left-[10%] w-72 h-72 rounded-full bg-primary/[0.03] blur-3xl"></div>
    <div class="absolute bottom-0 right-[5%] w-96 h-96 rounded-full bg-secondary/[0.02] blur-3xl"></div>
    <div class="absolute top-1/4 right-[20%] w-2 h-2 rounded-full bg-primary/40 animate-pulse"></div>
    <div class="absolute top-1/3 right-[22%] w-1 h-1 rounded-full bg-primary/30 animate-pulse" style="animation-delay: 0.5s"></div>
    <div class="absolute top-[15%] left-[40%] w-1.5 h-1.5 rounded-full bg-secondary/30 animate-pulse" style="animation-delay: 1s"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 relative">
    <!-- Top badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-chip bg-primary/10 border border-primary/20 text-primary text-xs font-bold tracking-widest uppercase font-label mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      Blog
    </div>

    <!-- Main headline -->
    <h1 class="font-headline text-5xl md:text-6xl lg:text-7xl font-bold text-on-surface leading-[0.9] tracking-tight mb-6 max-w-4xl">
      Pensamientos<br class="hidden md:block" />
      <span class="text-primary">técnicos</span>
      <span class="block md:inline text-on-surface-variant/60">sin humo</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-on-surface-variant text-lg md:text-xl leading-relaxed max-w-2xl mb-8">
      Experiencia real en desarrollo fullstack, automatización con IA y arquitectura de software. 
      Sin teoría vacía — solo lo que funciona en producción.
    </p>

    <!-- Stats bar -->
    <div class="flex flex-wrap items-center gap-6 md:gap-10 pt-6 border-t border-outline-variant/20 text-sm font-mono">
      <div class="flex items-center gap-2">
        <span class="text-primary font-bold text-lg">{featuredCount}</span>
        <span class="text-zinc-500">artículos</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-secondary font-bold">TypeScript</span>
        <span class="text-zinc-500">Astro</span>
        <span class="text-zinc-500">Next.js</span>
        <span class="text-zinc-500">IA</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
      </div>
      <div class="text-zinc-500">
        Actualizado <span class="text-on-surface-variant">{new Date().toLocaleDateString('es-AR', { month: 'long', year: 'numeric' })}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .font-headline {
    font-family: var(--font-headline);
  }
  .font-label {
    font-family: var(--font-label);
  }
</style>
