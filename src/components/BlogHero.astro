---
/**
 * BlogHero.astro - Marvel Edition
 * Hero cinemático del blog con glassmorphism, gradiente Marvel, y stats
 */
import type { Locale } from '../i18n';
import { localeConfig } from '../i18n';

interface Props {
  featuredCount?: number;
  postCount?: number;
  categoryCount?: number;
  locale?: Locale;
}

const { featuredCount = 0, postCount = 0, categoryCount = 0, locale = 'es' } = Astro.props;
const copy = {
  es: {
    title: ['Pensamientos', 'técnicos', 'sin humo'],
    subtitle: 'Experiencia real en desarrollo fullstack, automatización con IA y arquitectura de software. Sin teoría vacía, solo lo que funciona en producción.',
    articles: 'artículos',
    categories: 'categorías',
    topics: 'temas',
    updated: 'Actualizado',
  },
  en: {
    title: ['Technical', 'thinking', 'no fluff'],
    subtitle: 'Real experience in fullstack development, AI automation, and software architecture. No empty theory, only what works in production.',
    articles: 'articles',
    categories: 'categories',
    topics: 'topics',
    updated: 'Updated',
  },
}[locale];

const month = new Date().toLocaleDateString(localeConfig[locale].dateLocale, { month: 'long', year: 'numeric' });
---

<section class="blog-hero" data-blog-hero>
  <!-- Background ambient -->
  <div class="hero-bg" aria-hidden="true">
    <div class="bg-glow bg-glow-red"></div>
    <div class="bg-glow bg-glow-gold"></div>
    <div class="bg-grid"></div>
  </div>

  <div class="hero-content">
    <!-- Top badge -->
    <div class="hero-badge" data-hero-badge>
      <span class="badge-dot"></span>
      <span class="badge-text font-mono">Blog · TecnoDespegue</span>
    </div>

    <!-- Headline -->
    <h1 class="hero-title font-display" data-hero-title>
      <span class="title-line" data-title-line>
        <span class="title-word">{copy.title[0]}</span>
      </span>
      <span class="title-line" data-title-line>
        <span class="title-word title-accent">{copy.title[1]}</span>
        <span class="title-word title-muted">{copy.title[2]}</span>
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-sub" data-hero-sub>
      {copy.subtitle}
    </p>

    <!-- Stats bar -->
    <div class="hero-stats" data-hero-stats>
      <div class="stat-item">
        <span class="stat-num font-display">{postCount}</span>
        <span class="stat-label">{copy.articles}</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num font-display text-shine">{categoryCount}</span>
        <span class="stat-label">{copy.categories}</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item stat-item-stack">
        <span class="stat-num font-display">4+</span>
        <span class="stat-label">{copy.topics}</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item stat-item-update">
        <span class="stat-label">{copy.updated}</span>
        <span class="stat-month">{month}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .blog-hero {
    position: relative;
    padding: 7rem 1.5rem 3rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .blog-hero {
      padding: 8rem 2rem 4rem;
    }
  }

  /* Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .bg-glow-red {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(237, 29, 36, 0.12) 0%, transparent 70%);
    top: -10%;
    right: -5%;
  }

  .bg-glow-gold {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(248, 180, 0, 0.08) 0%, transparent 70%);
    bottom: -20%;
    left: 10%;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin: 0 auto;
    text-align: center;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(237, 29, 36, 0.3);
    border-radius: 999px;
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(16px);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-marvel-red);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(237, 29, 36, 0.8);
    animation: badge-pulse 2s ease-in-out infinite;
  }

  @keyframes badge-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .badge-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Title */
  .hero-title {
    font-weight: 900;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
    max-width: 50rem;
  }

  .title-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    margin-bottom: 0.05em;
  }

  .title-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
  }

  .title-accent {
    background: linear-gradient(135deg, #FFD75A 0%, #ED1D24 50%, #B14EFF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(237, 29, 36, 0.4));
  }

  .title-muted {
    color: rgba(255, 255, 255, 0.5);
  }

  /* Sub */
  .hero-sub {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
    max-width: 40rem;
    margin: 0 0 2.5rem;
    opacity: 0;
    transform: translateY(20px);
  }

  /* Stats */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    opacity: 0;
    transform: translateY(20px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-item-stack {
    flex-direction: column;
  }

  .stat-item-update {
    flex-direction: column;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    color: #FFFFFF;
  }

  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--font-mono);
  }

  .stat-month {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    text-transform: capitalize;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Animations */
  .blog-hero[data-animated="true"] [data-hero-badge],
  .blog-hero[data-animated="true"] [data-title-line] .title-word,
  .blog-hero[data-animated="true"] [data-hero-sub],
  .blog-hero[data-animated="true"] [data-hero-stats] {
    opacity: 1;
    transform: translateY(0);
  }

  .blog-hero[data-animated="true"] [data-title-line] .title-word {
    transition: opacity 0.6s, transform 0.8s;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLElement>('[data-blog-hero]');
  if (hero) {
    if (prefersReducedMotion) {
      hero.setAttribute('data-animated', 'true');
    } else {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.to('[data-hero-badge]', { opacity: 1, y: 0, duration: 0.6 }, 0.2);
      tl.to('[data-title-line] .title-word', {
        opacity: 1, y: 0, duration: 0.9, stagger: 0.08, ease: 'expo.out',
      }, 0.4);
      tl.to('[data-hero-sub]', { opacity: 1, y: 0, duration: 0.7 }, 0.9);
      tl.to('[data-hero-stats]', { opacity: 1, y: 0, duration: 0.7 }, 1.1);
    }
  }
</script>
