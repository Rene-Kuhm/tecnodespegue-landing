---
import Icon from './Icon.astro';
import { siteConfig } from '../config/site.config';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';
const copy = {
  es: {
    name: 'Nombre *',
    namePlaceholder: 'Juan Pérez',
    company: 'Empresa',
    companyPlaceholder: 'Tu Empresa SRL',
    project: 'Contanos sobre tu proyecto *',
    projectPlaceholder: 'Necesitamos automatizar nuestro proceso de...',
    budget: 'Presupuesto estimado',
    budgetPlaceholder: 'Seleccionar rango',
    submit: 'Enviar Consulta',
    guaranteed: 'Respuesta garantizada en menos de 24 horas',
    successTitle: '¡Mensaje Enviado!',
    successBody: 'Te contactaremos en las próximas 24 horas.',
    emailSubject: 'Nuevo contacto',
    labels: { name: 'Nombre', email: 'Email', company: 'Empresa', budget: 'Presupuesto', project: 'Proyecto' },
  },
  en: {
    name: 'Name *',
    namePlaceholder: 'John Smith',
    company: 'Company',
    companyPlaceholder: 'Your Company LLC',
    project: 'Tell us about your project *',
    projectPlaceholder: 'We need to automate our process for...',
    budget: 'Estimated budget',
    budgetPlaceholder: 'Select range',
    submit: 'Send Inquiry',
    guaranteed: 'Guaranteed response in less than 24 hours',
    successTitle: 'Message Sent!',
    successBody: 'We will contact you within the next 24 hours.',
    emailSubject: 'New contact',
    labels: { name: 'Name', email: 'Email', company: 'Company', budget: 'Budget', project: 'Project' },
  },
}[locale];

const formspreeEndpoint = siteConfig.formspree.endpoint;
const formCopy = {
  emailSubject: copy.emailSubject,
  labels: copy.labels,
};
---

<div class="max-w-2xl mx-auto bg-surface-container border border-white/10 rounded-card p-8 glass-effect">
  <form id="contact-form" class="space-y-6">
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <label for="name" class="block text-sm font-label text-on-surface-variant mb-2">
          {copy.name}
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full bg-surface-container-high border-b-2 border-outline-variant focus:border-primary px-4 py-3 text-on-surface outline-none transition-colors"
          placeholder={copy.namePlaceholder}
        />
      </div>
      
      <div>
        <label for="email" class="block text-sm font-label text-on-surface-variant mb-2">
          Email *
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full bg-surface-container-high border-b-2 border-outline-variant focus:border-primary px-4 py-3 text-on-surface outline-none transition-colors"
          placeholder="juan@empresa.com"
        />
      </div>
    </div>
    
    <div>
      <label for="company" class="block text-sm font-label text-on-surface-variant mb-2">
        {copy.company}
      </label>
      <input
        type="text"
        id="company"
        name="company"
        class="w-full bg-surface-container-high border-b-2 border-outline-variant focus:border-primary px-4 py-3 text-on-surface outline-none transition-colors"
        placeholder={copy.companyPlaceholder}
      />
    </div>
    
    <div>
      <label for="project" class="block text-sm font-label text-on-surface-variant mb-2">
        {copy.project}
      </label>
      <textarea
        id="project"
        name="project"
        required
        rows="5"
        class="w-full bg-surface-container-high border-b-2 border-outline-variant focus:border-primary px-4 py-3 text-on-surface outline-none transition-colors resize-none"
        placeholder={copy.projectPlaceholder}
      ></textarea>
    </div>
    
    <div>
      <label for="budget" class="block text-sm font-label text-on-surface-variant mb-2">
        {copy.budget}
      </label>
      <select
        id="budget"
        name="budget"
        class="w-full bg-surface-container-high border-b-2 border-outline-variant focus:border-primary px-4 py-3 text-on-surface outline-none transition-colors"
      >
        <option value="">{copy.budgetPlaceholder}</option>
        <option value="5k-10k">USD 5K - 10K</option>
        <option value="10k-25k">USD 10K - 25K</option>
        <option value="25k-50k">USD 25K - 50K</option>
        <option value="50k+">USD 50K+</option>
      </select>
    </div>
    
    <button
      type="submit"
      class="btn-primary w-full flex items-center justify-center gap-2 group"
    >
      <span>{copy.submit}</span>
      <Icon name="arrow_forward" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
    </button>
    
    <p class="text-xs text-on-surface-variant text-center">
      {copy.guaranteed}
    </p>
  </form>
  
  <div id="form-success" class="hidden text-center py-8">
    <Icon name="check_circle" class="w-16 h-16 text-secondary mb-4 mx-auto block" />
    <h3 class="text-2xl font-headline font-bold text-on-surface mb-2">
      {copy.successTitle}
    </h3>
    <p class="text-on-surface-variant">
      {copy.successBody}
    </p>
  </div>
</div>

<script define:vars={{ formspreeEndpoint, formCopy }}>
  const form = document.getElementById('contact-form');
  const successMessage = document.getElementById('form-success');
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    
    try {
      // Submit to Formspree
      const response = await fetch(formspreeEndpoint, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });
      
      if (response.ok) {
        const tracker = window.tdTrackTikTok;
        const data = Object.fromEntries(formData.entries());
        tracker?.('Lead', {
          content_name: 'Formulario de contacto',
          content_id: 'contact-form',
          content_type: 'product',
          url: window.location.href
        }, {
          email: String(data.email || ''),
          external_id: String(data.email || '')
        });

        // Show success message
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      } else {
        // Fallback to mailto if Formspree fails
        const data = Object.fromEntries(formData.entries());
        const subject = `${formCopy.emailSubject}: ${data.name} - ${data.company}`;
        const body = `
${formCopy.labels.name}: ${data.name}
${formCopy.labels.email}: ${data.email}
${formCopy.labels.company}: ${data.company}
${formCopy.labels.budget}: ${data.budget}

${formCopy.labels.project}:
${data.project}
        `.trim();
        
        window.location.href = `mailto:renekuhm2@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      }
    } catch (error) {
      console.error('Form submission error:', error);
      // Fallback to mailto on error
      const data = Object.fromEntries(formData.entries());
      const subject = `${formCopy.emailSubject}: ${data.name} - ${data.company}`;
      const body = `
${formCopy.labels.name}: ${data.name}
${formCopy.labels.email}: ${data.email}
${formCopy.labels.company}: ${data.company}
${formCopy.labels.budget}: ${data.budget}

${formCopy.labels.project}:
${data.project}
      `.trim();
      
      window.location.href = `mailto:renekuhm2@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }
  });
</script>
