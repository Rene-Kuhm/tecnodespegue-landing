---
/**
 * LoadingScreen.astro
 * Pantalla de carga cinemática estilo Marvel opening.
 * - Texto "MARVEL STUDIOS" + barra de progreso
 * - Al completar, se levanta como una cortina con un wipe
 * - Respeta prefers-reduced-motion (skip inmediato)
 */
---

<div id="loading-screen" class="loading-curtain" data-loading-screen aria-hidden="false">
  <div class="loading-inner">
    <!-- Logo / brand -->
    <div class="loading-brand">
      <div class="loading-marvel-mark" data-loading-mark>
        <span class="loading-letter">T</span>
        <span class="loading-letter">D</span>
      </div>
      <div class="loading-tagline font-display" data-loading-tagline>TECNODESPEGUE</div>
    </div>

    <!-- Barra de progreso cinemática -->
    <div class="loading-bar-track" data-loading-bar-track>
      <div class="loading-bar-fill" data-loading-bar-fill></div>
      <div class="loading-bar-glow" data-loading-bar-glow></div>
    </div>

    <!-- Status text (mecánico) -->
    <div class="loading-status font-mono" data-loading-status>
      <span data-loading-status-text>Inicializando sistema</span>
      <span class="loading-percent" data-loading-percent>0%</span>
    </div>
  </div>

  <!-- Wipe final (curtain) -->
  <div class="loading-wipe" data-loading-wipe></div>
</div>

<style>
  #loading-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .loading-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    width: min(90%, 480px);
  }

  .loading-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .loading-marvel-mark {
    display: flex;
    gap: 0.5rem;
    perspective: 800px;
  }

  .loading-letter {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 0.85;
    color: var(--color-marvel-red);
    text-shadow:
      0 0 0 #000,
      3px 3px 0 #000,
      6px 6px 0 var(--color-marvel-red-deep),
      0 0 40px rgba(237, 29, 36, 0.4);
    opacity: 0;
    transform: translateY(40px) rotateX(40deg);
    transform-origin: center bottom;
    will-change: transform, opacity;
  }

  .loading-tagline {
    font-size: clamp(0.75rem, 2vw, 1rem);
    color: var(--color-marvel-gold);
    letter-spacing: 0.6em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    text-shadow: 0 0 20px rgba(248, 180, 0, 0.5);
    will-change: transform, opacity;
  }

  .loading-bar-track {
    position: relative;
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(237, 29, 36, 0.2);
  }

  .loading-bar-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg,
      var(--color-marvel-red) 0%,
      var(--color-marvel-gold) 50%,
      var(--color-marvel-red) 100%);
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
    box-shadow: 0 0 16px rgba(248, 180, 0, 0.6);
  }

  .loading-bar-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 80px;
    height: 100%;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.8) 50%,
      transparent 100%);
    transform: translateX(-100%);
    will-change: transform;
    mix-blend-mode: screen;
    filter: blur(2px);
  }

  .loading-status {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-size: 0.7rem;
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .loading-percent {
    color: var(--color-marvel-gold);
    font-weight: 700;
  }

  /* Wipe final - cortina que sube al completar */
  .loading-wipe {
    position: absolute;
    inset: 0;
    z-index: 5;
    background:
      linear-gradient(135deg, #0A0A0A 0%, #1C1C24 50%, #0A0A0A 100%);
    transform: translateY(100%);
    will-change: transform;
    box-shadow: 0 -8px 32px rgba(237, 29, 36, 0.3);
  }

  /* Cuando termina, se oculta el loading screen */
  #loading-screen.is-done {
    pointer-events: none;
  }

  #loading-screen.is-done .loading-wipe {
    transform: translateY(0);
  }

  #loading-screen.is-done .loading-inner {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  /* Reduced motion: skip total */
  @media (prefers-reduced-motion: reduce) {
    .loading-letter,
    .loading-tagline,
    .loading-bar-fill,
    .loading-bar-glow {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const STATUS_MESSAGES = [
    'Inicializando sistema',
    'Cargando núcleo cinemático',
    'Compilando shaders',
    'Sincronizando órbita',
    'Calibrando telar de partículas',
    'Activando interfaz',
    'Bienvenido al despegue',
  ];

  function runLoadingSequence(): Promise<void> {
    return new Promise((resolve) => {
      const screen = document.querySelector<HTMLElement>('[data-loading-screen]');
      if (!screen) {
        resolve();
        return;
      }

      const letters = screen.querySelectorAll<HTMLElement>('[data-loading-mark] .loading-letter');
      const tagline = screen.querySelector<HTMLElement>('[data-loading-tagline]');
      const barFill = screen.querySelector<HTMLElement>('[data-loading-bar-fill]');
      const barGlow = screen.querySelector<HTMLElement>('[data-loading-bar-glow]');
      const statusText = screen.querySelector<HTMLElement>('[data-loading-status-text]');
      const percentText = screen.querySelector<HTMLElement>('[data-loading-percent]');
      const wipe = screen.querySelector<HTMLElement>('[data-loading-wipe]');

      if (prefersReducedMotion) {
        // Reduced motion: skip todo, ocultar de una
        screen.style.display = 'none';
        document.documentElement.classList.add('is-loaded');
        resolve();
        return;
      }

      const tl = gsap.timeline({
        onComplete: () => {
          // Wipe final (cortina sube)
          gsap.to(wipe, {
            yPercent: -100,
            duration: 0.9,
            ease: 'expo.inOut',
            onComplete: () => {
              screen.classList.add('is-done');
              screen.setAttribute('aria-hidden', 'true');
              document.documentElement.classList.add('is-loaded');
              setTimeout(() => {
                screen.style.display = 'none';
              }, 100);
              resolve();
            },
          });
        },
      });

      // Letras caen
      tl.to(letters, {
        opacity: 1,
        y: 0,
        rotateX: 0,
        duration: 0.7,
        ease: 'expo.out',
        stagger: 0.12,
      });

      // Tagline
      tl.to(tagline, {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: 'power2.out',
      }, '-=0.3');

      // Barra de progreso: avanza a 100% durante 1.8s
      tl.to(barFill, {
        scaleX: 1,
        duration: 1.8,
        ease: 'power2.inOut',
        onUpdate: function () {
          const p = Math.round(this.progress() * 100);
          if (percentText) percentText.textContent = p + '%';
          if (statusText) {
            const msgIndex = Math.min(
              Math.floor(this.progress() * STATUS_MESSAGES.length),
              STATUS_MESSAGES.length - 1
            );
            statusText.textContent = STATUS_MESSAGES[msgIndex];
          }
        },
      }, '-=0.2');

      // Glow bar barriendo
      tl.fromTo(barGlow,
        { x: '-100%' },
        { x: '500%', duration: 1.6, ease: 'power2.inOut' },
        '<'
      );
    });
  }

  // Bloquear scroll mientras carga
  document.documentElement.classList.add('is-loading');
  document.body.style.overflow = 'hidden';

  function start() {
    runLoadingSequence().catch((err) => {
      console.error('Loading sequence error', err);
      const screen = document.querySelector<HTMLElement>('[data-loading-screen]');
      if (screen) screen.style.display = 'none';
      document.documentElement.classList.add('is-loaded');
    }).finally(() => {
      document.documentElement.classList.remove('is-loading');
      document.body.style.overflow = '';
    });
  }

  if (document.readyState === 'complete') {
    // Pequeño delay para que se vea el loading aunque la página esté cacheada
    setTimeout(start, 80);
  } else {
    window.addEventListener('load', () => setTimeout(start, 80), { once: true });
  }
</script>
