<div id="progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-primary via-secondary to-primary z-50 transition-all duration-150"></div>

<script>
  const progressBar = document.getElementById('progress-bar');
  let docHeight = 0;

  function updateProgressBar() {
    if (!progressBar) return;

    // Lazily compute the document scrollHeight only when a scroll event occurs.
    // This completely avoids forcing the browser to compute the entire initial layout 
    // synchronously during parsing, eliminating the startup reflow entirely.
    if (docHeight === 0) {
      docHeight = document.documentElement.scrollHeight - window.innerHeight;
    }

    if (docHeight <= 0) return;
    progressBar.style.width = `${(window.scrollY / docHeight) * 100}%`;
  }

  // Listen to passive scroll events
  window.addEventListener('scroll', updateProgressBar, { passive: true });

  // Reset docHeight on resize so that it gets lazily recomputed on the next scroll event
  window.addEventListener('resize', () => {
    docHeight = 0;
  }, { passive: true });
</script>
