---
const socials = [
  { name: "GitHub", href: "https://github.com/Rene-Kuhm", icon: "code" },
  { name: "Instagram", href: "https://instagram.com/renekuhm", icon: "photo_camera" },
  { name: "TikTok", href: "https://tiktok.com/@kuhmdev", icon: "play_circle" },
  { name: "YouTube", href: "https://youtube.com/@tecnodespegue", icon: "smart_display" },
  { name: "LinkedIn", href: "https://linkedin.com/in/renekuhm", icon: "work" },
];
---

<footer class="bg-black border-t border-zinc-800/50 py-16">
  <div class="max-w-7xl mx-auto px-8">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 mb-12">
      <div>
        <div class="text-lg font-bold text-primary uppercase tracking-widest font-headline mb-2">
          TecnoDespegue
        </div>
        <p class="text-zinc-500 text-sm max-w-xs">
          Desarrollo fullstack, automatizaciones con IA y soluciones a medida.
        </p>
      </div>
      
      <div class="flex flex-col gap-3">
        <span class="text-xs text-zinc-600 uppercase tracking-widest font-mono">Contacto</span>
        <a href="mailto:renekuhm2@gmail.com" class="text-zinc-400 hover:text-primary text-sm transition-colors">
          renekuhm2@gmail.com
        </a>
        <a href="https://wa.me/5492334409838" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-primary text-sm transition-colors">
          +54 9 2334 409838
        </a>
      </div>
      
      <div class="flex flex-col gap-3">
        <span class="text-xs text-zinc-600 uppercase tracking-widest font-mono">Redes</span>
        <div class="flex gap-4">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-md bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 hover:text-primary hover:border-primary/30 transition-all duration-300"
              aria-label={social.name}
              title={social.name}
            >
              <span class="material-symbols-outlined text-lg">{social.icon}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
    
    <div class="border-t border-zinc-800/50 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-zinc-600 text-xs font-body">
        © {new Date().getFullYear()} TecnoDespegue. Todos los derechos reservados.
      </div>
      <div class="text-zinc-700 text-xs font-mono">
        Eduardo Castilla, La Pampa, Argentina
      </div>
    </div>
  </div>
</footer>
