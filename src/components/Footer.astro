---

<footer class="footer-section" data-footer>
  <!-- Top divider cinemático -->
  <div class="footer-divider" aria-hidden="true">
    <div class="footer-divider-bar"></div>
    <div class="footer-divider-mark">◆ ◆ ◆</div>
    <div class="footer-divider-bar"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-8 py-16">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="footer-logo-mark" aria-hidden="true">
            <span class="footer-logo-mark-letter">T</span>
            <span class="footer-logo-mark-letter">D</span>
          </span>
          <span class="footer-logo-text font-display">TECNODESPEGUE</span>
        </div>
        <p class="footer-tagline">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Contacto -->
      <div class="footer-col">
        <span class="footer-col-label font-mono">{t.footer.contact.toUpperCase()}</span>
        <a href="mailto:renekuhm2@gmail.com" class="footer-link" data-tiktok-event="Contact" data-tiktok-label="Email footer">
          <Icon name="email" class="w-4 h-4" />
          <span>renekuhm2@gmail.com</span>
        </a>
        <a href="https://wa.me/5492334409838" target="_blank" rel="noopener noreferrer" class="footer-link" data-tiktok-event="Contact" data-tiktok-label="WhatsApp footer">
          <Icon name="chat" class="w-4 h-4" />
          <span>WhatsApp directo</span>
        </a>
      </div>

      <!-- Redes -->
      <div class="footer-col">
        <span class="footer-col-label font-mono">{t.footer.socials.toUpperCase()}</span>
        <div class="footer-socials">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social"
              aria-label={social.name}
              title={social.name}
              data-magnetic
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4"
                aria-hidden="true"
              >
                <path d={social.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <div class="footer-copy font-body">
        © {new Date().getFullYear()} TecnoDespegue. {t.footer.rights}
      </div>
      <div class="footer-meta">
        <span class="footer-location">
          <Icon name="place" class="w-3.5 h-3.5" />
          <span>{t.footer.location}</span>
        </span>
        <span class="footer-meta-divider" aria-hidden="true">·</span>
        <a href={localizedPath('/privacidad', locale)} class="footer-meta-link">{t.footer.privacy}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    position: relative;
    background: linear-gradient(180deg, var(--color-surface-1) 0%, #050505 100%);
    border-top: 1px solid rgba(248, 180, 0, 0.12);
  }

  /* Cinematic divider */
  .footer-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .footer-divider-bar {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--color-marvel-gold) 50%, transparent 100%);
    opacity: 0.5;
  }
  .footer-divider-mark {
    color: var(--color-marvel-gold);
    font-size: 0.625rem;
    letter-spacing: 0.5em;
    text-shadow: 0 0 12px rgba(248, 180, 0, 0.5);
  }

  /* Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin: 3rem 0;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 3rem;
    }
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }
  .footer-logo-mark {
    display: inline-flex;
    gap: 2px;
  }
  .footer-logo-mark-letter {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.75rem;
    line-height: 0.8;
    color: var(--color-marvel-red);
    text-shadow:
      1px 1px 0 #000,
      2px 2px 0 var(--color-marvel-red-deep),
      0 0 12px rgba(237, 29, 36, 0.3);
  }
  .footer-logo-text {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #FFFFFF;
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    max-width: 24rem;
    margin: 0;
  }
  .text-gold {
    color: var(--color-marvel-gold-bright);
    font-weight: 600;
  }

  /* Columns */
  .footer-col { display: flex; flex-direction: column; gap: 0.75rem; }
  .footer-col-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--color-marvel-gold);
    margin-bottom: 0.25rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .footer-link :global(svg) { color: var(--color-marvel-gold); }
  .footer-link:hover { color: #FFFFFF; }

  /* Socials */
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-surface-2);
    border: 1px solid rgba(248, 180, 0, 0.2);
    border-radius: 0.375rem;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: all 0.3s var(--ease-marvel);
  }
  .footer-social:hover {
    color: var(--color-marvel-gold-bright);
    border-color: var(--color-marvel-gold);
    background: rgba(248, 180, 0, 0.1);
    box-shadow: 0 0 16px rgba(248, 180, 0, 0.4);
    transform: translateY(-2px);
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--color-on-surface-dim);
  }

  .footer-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-on-surface-dim);
  }
  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .footer-location :global(svg) { color: var(--color-marvel-gold); }

  .footer-meta-divider { color: var(--color-marvel-gold); opacity: 0.5; }

  .footer-meta-link {
    color: var(--color-on-surface-dim);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-meta-link:hover { color: var(--color-marvel-gold-bright); }
</style>
