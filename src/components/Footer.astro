---

<footer class="bg-black border-t border-zinc-800/50 py-16">
  <div class="max-w-7xl mx-auto px-8">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 mb-12">
      <div>
        <div class="text-lg font-bold text-primary uppercase tracking-widest font-headline mb-2">
          TecnoDespegue
        </div>
        <p class="text-zinc-400 text-sm max-w-xs">
          Desarrollo fullstack, automatizaciones con IA y soluciones a medida.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <span class="text-xs text-zinc-400 uppercase tracking-widest font-mono">Contacto</span>
        <a href="mailto:renekuhm2@gmail.com" class="text-zinc-400 hover:text-primary text-sm transition-colors" data-tiktok-event="Contact" data-tiktok-label="Email footer">
          renekuhm2@gmail.com
        </a>
        <a href="https://wa.me/5492334409838" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-primary text-sm transition-colors inline-flex items-center gap-1" data-tiktok-event="Contact" data-tiktok-label="WhatsApp footer">
          <Icon name="chat" class="w-4 h-4" />
          WhatsApp directo
        </a>
      </div>

      <div class="flex flex-col gap-3">
        <span class="text-xs text-zinc-400 uppercase tracking-widest font-mono">Redes</span>
        <div class="flex gap-3">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-card bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 hover:text-primary hover:border-primary/30 hover:bg-zinc-800 transition-all duration-300"
              aria-label={social.name}
              title={social.name}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4"
                aria-hidden="true"
              >
                <path d={social.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="border-t border-zinc-800/50 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-zinc-400 text-xs font-body">
        © {new Date().getFullYear()} TecnoDespegue. Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-4 text-zinc-500 text-xs font-mono">
        <span>Eduardo Castex, La Pampa, Argentina</span>
        <a href="/privacidad" class="hover:text-primary transition-colors">
          Privacidad
        </a>
      </div>
    </div>
  </div>
</footer>
