---
/**
 * Footer.astro - Marvel Edition
 * Logo con sello, divider cinemático dorado, redes con glow, location chip
 */
import { useTranslations, localizedPath, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';
const t = useTranslations(locale);

const socials = [
  {
