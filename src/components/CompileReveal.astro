---
// src/components/CompileReveal.astro
export interface Props {
  children: any;
}
---

<div class="compile-reveal">
  <div class="compile-phase">> importando</div>
  <div class="reveal-content">
    <slot />
  </div>
</div>

<style>
.compile-reveal {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.compile-phase {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0.5rem 1rem;
  border-radius: 0.5rem;
  background-color: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.phase-import { color: rgb(16, 185, 129); }
.phase-compile { color: rgb(59, 130, 246); }
.phase-optimize { color: rgb(236, 72, 153); }
.phase-ready { color: rgb(34, 197, 94); }

.reveal-content {
  opacity: 0;
  transition: opacity 0.5s ease;
}

.reveal-content.visible {
  opacity: 1;
}
</style>

<script>
import { compilePhases } from '../scripts/compileReveal';

const reveal = document.querySelector('.compile-reveal');
if (reveal) {
  const phaseElement = reveal.querySelector('.compile-phase');
  const contentElement = reveal.querySelector('.reveal-content');
  
  if (phaseElement && contentElement) {
    // Run compile phases on the phase element
    compilePhases(phaseElement, [
      'IMPORTANDO módulos necesarios...',
      'COMPILANDO componentes visuales...',
      'OPTIMIZANDO rendimiento...',
      'LISTO para revelar contenido'
    ]).then(() => {
      // Show content after all phases complete
      contentElement.classList.add('visible');
      
      // Set up IntersectionObserver for fade-out
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) {
              entry.target.classList.add('fade-out');
            } else {
              entry.target.classList.remove('fade-out');
            }
          });
        },
        {
          rootMargin: '0px 0px -80% 0px'
        }
      );
      
      observer.observe(reveal);
    });
  }
}
</script>