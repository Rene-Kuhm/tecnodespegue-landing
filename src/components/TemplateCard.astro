---
/**
 * TemplateCard.astro
 * Card glassmorphism para mostrar un template
 * Con esquinas cómic animadas, badge de categoría, precio tachado
 */
import { formatDate } from '../utils/blog.ts';

const { template, idx = 0, variant = 'default' } = Astro.props;

const hasDiscount = template.data.compareAtPrice && template.data.compareAtPrice > template.data.price;
const discount = hasDiscount
  ? Math.round(((template.data.compareAtPrice - template.data.price) / template.data.compareAtPrice) * 100)
  : 0;

const categoryLabels: Record<string, string> = {
  landing: 'Landing',
  ecommerce: 'E-commerce',
  dashboard: 'Dashboard',
  blog: 'Blog',
  componentes: 'Componentes',
  marketing: 'Marketing',
  portfolio: 'Portfolio',
};

const licenseLabels: Record<string, string> = {
  personal: 'Personal',
  commercial: 'Commercial',
  extended: 'Extended',
};
---

<article
  class={`tpl-card tpl-card-${variant}`}
  data-tpl-card
  data-card-idx={idx}
  data-categories={template.data.category}
  data-license={template.data.license}
>
  <a href={`/templates/${template.id}/`} class="tpl-link">
    <!-- Cover / preview image area -->
    <div class="tpl-cover">
      {template.data.cover ? (
        <img
          src={template.data.cover}
          alt={template.data.title}
          class="tpl-cover-img"
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
        />
      ) : (
        <div class="tpl-cover-placeholder">
          <span class="tpl-cover-icon font-mono">{template.data.category.toUpperCase()}</span>
        </div>
      )}

      <!-- Overlay con badges -->
      <div class="tpl-badges">
        {template.data.featured && (
          <span class="tpl-badge tpl-badge-featured">
            <span class="tpl-badge-icon">★</span>
            Destacado
          </span>
        )}
        {hasDiscount && (
          <span class="tpl-badge tpl-badge-discount">-{discount}%</span>
        )}
      </div>

      <!-- Top category chip -->
      <div class="tpl-cat">
        <span class="tpl-cat-dot"></span>
        <span class="tpl-cat-text font-mono">{categoryLabels[template.data.category] || template.data.category}</span>
      </div>

      <!-- Hover overlay -->
      <div class="tpl-hover-overlay">
        <span class="tpl-hover-text">Ver template</span>
        <span class="tpl-hover-arrow">→</span>
      </div>
    </div>

    <!-- Body -->
    <div class="tpl-body">
      <!-- Top meta: license + version -->
      <div class="tpl-meta">
        <span class="tpl-meta-license font-mono">{licenseLabels[template.data.license]}</span>
        <span class="tpl-meta-sep">·</span>
        <span class="tpl-meta-version font-mono">v{template.data.version}</span>
      </div>

      <!-- Title -->
      <h3 class="tpl-title font-display">{template.data.title}</h3>

      <!-- Subtitle -->
      {template.data.subtitle && (
        <p class="tpl-subtitle">{template.data.subtitle}</p>
      )}

      <!-- Description -->
      <p class="tpl-desc">{template.data.description}</p>

      <!-- Stack -->
      {template.data.stack && template.data.stack.length > 0 && (
        <div class="tpl-stack">
          {template.data.stack.slice(0, 4).map(tech => (
            <span class="tpl-tech font-mono">{tech}</span>
          ))}
          {template.data.stack.length > 4 && (
            <span class="tpl-tech tpl-tech-more font-mono">+{template.data.stack.length - 4}</span>
          )}
        </div>
      )}

      <!-- Footer: price + CTA -->
      <div class="tpl-footer">
        <div class="tpl-price">
          {hasDiscount && (
            <span class="tpl-price-old font-mono">${template.data.compareAtPrice}</span>
          )}
          <span class="tpl-price-num font-display">${template.data.price}</span>
        </div>
        <div class="tpl-cta">
          <span class="tpl-cta-text">Comprar</span>
          <span class="tpl-cta-arrow">→</span>
        </div>
      </div>
    </div>

    <!-- Comic corners -->
    <div class="tpl-corner tpl-corner-tl" aria-hidden="true"></div>
    <div class="tpl-corner tpl-corner-tr" aria-hidden="true"></div>
    <div class="tpl-corner tpl-corner-bl" aria-hidden="true"></div>
    <div class="tpl-corner tpl-corner-br" aria-hidden="true"></div>
  </a>
</article>

<style>
  .tpl-card {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.875rem;
    overflow: hidden;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s, opacity 0.4s;
    opacity: 0;
    transform: translateY(30px);
  }

  .tpl-card.is-shown {
    opacity: 1;
    transform: translateY(0);
  }

  .tpl-card:hover {
    transform: translateY(-4px);
    border-color: rgba(237, 29, 36, 0.3);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(237, 29, 36, 0.1);
  }

  .tpl-card.is-hidden {
    display: none;
  }

  .tpl-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* Cover */
  .tpl-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, rgba(237, 29, 36, 0.05) 0%, rgba(0, 0, 0, 0.5) 50%, rgba(177, 78, 255, 0.05) 100%);
    overflow: hidden;
  }

  .tpl-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-marvel);
  }

  .tpl-card:hover .tpl-cover-img {
    transform: scale(1.05);
  }

  .tpl-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.15);
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 0.3em;
  }

  /* Badges overlay */
  .tpl-badges {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    z-index: 2;
  }

  .tpl-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: 0.25rem;
    backdrop-filter: blur(8px);
  }

  .tpl-badge-featured {
    background: rgba(248, 180, 0, 0.15);
    border: 1px solid rgba(248, 180, 0, 0.4);
    color: var(--color-marvel-gold);
  }

  .tpl-badge-icon {
    font-size: 0.75rem;
  }

  .tpl-badge-discount {
    background: rgba(237, 29, 36, 0.9);
    color: #FFFFFF;
    font-size: 0.7rem;
  }

  /* Top category chip */
  .tpl-cat {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.625rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.25rem;
    z-index: 2;
  }

  .tpl-cat-dot {
    width: 5px;
    height: 5px;
    background: var(--color-marvel-red);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(237, 29, 36, 0.6);
  }

  .tpl-cat-text {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
  }

  /* Hover overlay */
  .tpl-hover-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 3;
  }

  .tpl-card:hover .tpl-hover-overlay {
    opacity: 1;
  }

  .tpl-hover-text {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .tpl-hover-arrow {
    font-size: 1.5rem;
    color: var(--color-marvel-gold);
    transition: transform 0.2s;
  }

  .tpl-card:hover .tpl-hover-arrow {
    transform: translateX(4px);
  }

  /* Body */
  .tpl-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .tpl-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .tpl-meta-license {
    color: var(--color-marvel-gold);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tpl-meta-sep { color: rgba(255, 255, 255, 0.2); }

  .tpl-title {
    font-weight: 900;
    font-size: 1.25rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    margin: 0;
    transition: color 0.2s;
  }

  .tpl-card:hover .tpl-title {
    color: var(--color-marvel-gold-bright);
  }

  .tpl-subtitle {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    font-weight: 500;
  }

  .tpl-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stack */
  .tpl-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
  }

  .tpl-tech {
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.25rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.65rem;
  }

  .tpl-tech-more {
    color: var(--color-marvel-gold);
    border-color: rgba(248, 180, 0, 0.2);
  }

  /* Footer: price + cta */
  .tpl-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 0.5rem;
  }

  .tpl-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .tpl-price-old {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.3);
    text-decoration: line-through;
  }

  .tpl-price-num {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    color: #FFFFFF;
  }

  .tpl-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.875rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    transition: all 0.2s;
  }

  .tpl-cta-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .tpl-cta-arrow {
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.2s, transform 0.2s;
  }

  .tpl-card:hover .tpl-cta {
    background: #FFFFFF;
    border-color: #FFFFFF;
  }

  .tpl-card:hover .tpl-cta-text {
    color: #0a0a0a;
  }

  .tpl-card:hover .tpl-cta-arrow {
    color: #0a0a0a;
    transform: translateX(2px);
  }

  /* Comic corners */
  .tpl-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-marvel-red);
    opacity: 0;
    transition: opacity 0.3s, all 0.3s;
    z-index: 4;
    pointer-events: none;
  }

  .tpl-corner-tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .tpl-corner-tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .tpl-corner-bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .tpl-corner-br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  .tpl-card:hover .tpl-corner { opacity: 1; }
  .tpl-card:hover .tpl-corner-tl { top: -6px; left: -6px; }
  .tpl-card:hover .tpl-corner-tr { top: -6px; right: -6px; }
  .tpl-card:hover .tpl-corner-bl { bottom: -6px; left: -6px; }
  .tpl-card:hover .tpl-corner-br { bottom: -6px; right: -6px; }
</style>
