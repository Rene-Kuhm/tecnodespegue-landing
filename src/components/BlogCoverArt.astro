---
interface Props {
  category?: string;
  compact?: boolean;
}

const { category = 'TecnoDespegue', compact = false } = Astro.props;
---

<div class={`cover-art ${compact ? 'cover-art-compact' : ''}`} aria-hidden="true">
  <div class="cover-grid"></div>
  <div class="cover-glow cover-glow-red"></div>
  <div class="cover-glow cover-glow-gold"></div>
  <div class="cover-frame">
    <span class="cover-brand font-mono">TD TECNODESPEGUE</span>
    <span class="cover-square"></span>
    <span class="cover-rail cover-rail-red"></span>
    <span class="cover-rail cover-rail-gold"></span>
  </div>
  <span class="cover-category font-mono">{category}</span>
</div>

<style>
  .cover-art {
    position: relative;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 1200 / 630;
    min-height: inherit;
    overflow: hidden;
    background:
      radial-gradient(circle at 76% 28%, rgba(237, 29, 36, 0.32), transparent 11rem),
      radial-gradient(circle at 24% 78%, rgba(248, 180, 0, 0.16), transparent 13rem),
      linear-gradient(135deg, #170006 0%, #070707 46%, #11020b 100%);
  }

  .cover-art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 78%);
    opacity: 0.32;
  }

  .cover-grid {
    position: absolute;
    inset: 10% 8%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(90deg, transparent 0 47%, rgba(255, 255, 255, 0.08) 47% 47.3%, transparent 47.3%),
      linear-gradient(180deg, transparent 0 54%, rgba(248, 180, 0, 0.18) 54% 54.4%, transparent 54.4%);
    opacity: 0.42;
  }

  .cover-glow {
    position: absolute;
    width: 34%;
    aspect-ratio: 1;
    border-radius: 999px;
    filter: blur(28px);
    opacity: 0.72;
  }

  .cover-glow-red {
    right: 8%;
    top: 12%;
    background: rgba(237, 29, 36, 0.34);
  }

  .cover-glow-gold {
    left: 12%;
    bottom: 7%;
    background: rgba(248, 180, 0, 0.16);
  }

  .cover-frame {
    position: absolute;
    left: 8%;
    top: 12%;
    width: 34%;
    max-width: 18rem;
    min-width: 9rem;
    aspect-ratio: 1;
  }

  .cover-brand {
    position: absolute;
    left: 0;
    top: 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(0.45rem, 1vw, 0.72rem);
    font-weight: 900;
    letter-spacing: 0.18em;
  }

  .cover-square {
    position: absolute;
    left: 19%;
    top: 24%;
    width: 54%;
    aspect-ratio: 1;
    border: clamp(0.38rem, 1.1vw, 0.7rem) solid var(--color-marvel-red);
    box-shadow:
      0.62rem 0.62rem 0 var(--color-marvel-gold),
      0 0 0 1px rgba(255, 255, 255, 0.05) inset;
  }

  .cover-rail {
    position: absolute;
    left: 0;
    height: clamp(0.38rem, 1vw, 0.66rem);
  }

  .cover-rail-red {
    bottom: 6%;
    width: 82%;
    background: linear-gradient(90deg, var(--color-marvel-red), rgba(237, 29, 36, 0.18));
  }

  .cover-rail-gold {
    bottom: 0;
    width: 54%;
    background: var(--color-marvel-gold);
  }

  .cover-category {
    position: absolute;
    left: clamp(0.75rem, 2.4vw, 1.25rem);
    bottom: clamp(0.75rem, 2.4vw, 1.25rem);
    z-index: 2;
    max-width: calc(100% - 1.5rem);
    padding: 0.32rem 0.58rem;
    border: 1px solid rgba(248, 180, 0, 0.32);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.62);
    color: var(--color-marvel-gold);
    font-size: clamp(0.54rem, 1.2vw, 0.68rem);
    font-weight: 900;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cover-art-compact .cover-frame {
    left: 9%;
    top: 13%;
    width: 32%;
    min-width: 7rem;
  }
</style>
