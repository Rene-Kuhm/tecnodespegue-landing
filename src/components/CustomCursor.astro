---
---

<div id="custom-cursor" class="hidden lg:block" aria-hidden="true"></div>
<div id="custom-cursor-dot" class="hidden lg:block" aria-hidden="true"></div>

<style>
  @media (min-width: 1024px) and (pointer: fine) {
    :global(html),
    :global(body),
    :global(a),
    :global(button),
    :global(input),
    :global(textarea),
    :global(select),
    :global(.card),
    :global(.tech-badge) {
      cursor: none;
    }
  }

  #custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    border: 2px solid rgba(193, 255, 254, 0.3);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transition: width 0.2s ease-out, height 0.2s ease-out, border-color 0.2s ease-out, background 0.2s ease-out;
    will-change: transform;
  }

  #custom-cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    background: #c1fffe;
    border-radius: 50%;
    pointer-events: none;
    z-index: 10000;
    will-change: transform;
  }

  #custom-cursor.hover {
    width: 60px;
    height: 60px;
    border-color: rgba(193, 255, 254, 0.6);
    background: rgba(193, 255, 254, 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    #custom-cursor,
    #custom-cursor-dot {
      display: none !important;
    }
    :global(html),
    :global(body),
    :global(a),
    :global(button) {
      cursor: auto !important;
    }
  }
</style>

<script>
  const supportsFinePointer = window.matchMedia('(pointer: fine)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (supportsFinePointer && !prefersReducedMotion) {
    let cursorX = 0, cursorY = 0;
    let dotX = 0, dotY = 0;
    let cursor: HTMLElement | null = null;
    let dot: HTMLElement | null = null;

    document.addEventListener('mousemove', (e) => {
      cursorX = e.clientX;
      cursorY = e.clientY;
    });

    function animateCursor() {
      if (cursor && dot) {
        dotX += (cursorX - dotX) * 0.3;
        dotY += (cursorY - dotY) * 0.3;
        cursor.style.transform = `translate(${cursorX - 20}px, ${cursorY - 20}px)`;
        dot.style.transform = `translate(${dotX - 4}px, ${dotY - 4}px)`;
      }
      requestAnimationFrame(animateCursor);
    }

    document.addEventListener('DOMContentLoaded', () => {
      cursor = document.getElementById('custom-cursor');
      dot = document.getElementById('custom-cursor-dot');
      animateCursor();

      const hoverElements = document.querySelectorAll('a, button, .card, .tech-badge');
      hoverElements.forEach((el) => {
        el.addEventListener('mouseenter', () => cursor?.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor?.classList.remove('hover'));
      });
    });

    document.addEventListener('mouseleave', () => {
      if (cursor) cursor.style.opacity = '0';
      if (dot) dot.style.opacity = '0';
    });

    document.addEventListener('mouseenter', () => {
      if (cursor) cursor.style.opacity = '1';
      if (dot) dot.style.opacity = '1';
    });
  }
</script>
