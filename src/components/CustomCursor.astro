---
---

<div id="custom-cursor" class="hidden lg:block" aria-hidden="true"></div>
<div id="custom-cursor-dot" class="hidden lg:block" aria-hidden="true"></div>

<style>
  @media (min-width: 1024px) and (pointer: fine) {
    :global(html),
    :global(body),
    :global(a),
    :global(button),
    :global(input),
    :global(textarea),
    :global(select),
    :global(.card),
    :global(.tech-badge) {
      cursor: none;
    }
  }

  #custom-cursor {
    position: fixed;
    width: 40px;
    height: 40px;
    border: 2px solid rgba(193, 255, 254, 0.3);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transition: width 0.2s ease-out, height 0.2s ease-out, border-color 0.2s ease-out, background 0.2s ease-out;
    transform: translate(-50%, -50%);
    will-change: transform, left, top;
  }

  #custom-cursor-dot {
    position: fixed;
    width: 8px;
    height: 8px;
    background: #c1fffe;
    border-radius: 50%;
    pointer-events: none;
    z-index: 10000;
    transform: translate(-50%, -50%);
    will-change: left, top;
  }

  #custom-cursor.hover {
    width: 60px;
    height: 60px;
    border-color: rgba(193, 255, 254, 0.6);
    background: rgba(193, 255, 254, 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    #custom-cursor,
    #custom-cursor-dot {
      display: none !important;
    }
    :global(html),
    :global(body),
    :global(a),
    :global(button) {
      cursor: auto !important;
    }
  }
</style>

<script>
  const supportsFinePointer = window.matchMedia('(pointer: fine)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (supportsFinePointer && !prefersReducedMotion) {
    let cursorX = 0, cursorY = 0;
    let dotX = 0, dotY = 0;

    document.addEventListener('mousemove', (e) => {
      cursorX = e.clientX;
      cursorY = e.clientY;
    });

    function animateCursor() {
      const cursor = document.getElementById('custom-cursor');
      const dot = document.getElementById('custom-cursor-dot');

      if (cursor && dot) {
        dotX += (cursorX - dotX) * 0.3;
        dotY += (cursorY - dotY) * 0.3;

        cursor.style.left = `${cursorX}px`;
        cursor.style.top = `${cursorY}px`;

        dot.style.left = `${dotX}px`;
        dot.style.top = `${dotY}px`;
      }

      requestAnimationFrame(animateCursor);
    }

    document.addEventListener('DOMContentLoaded', () => {
      animateCursor();

      const cursor = document.getElementById('custom-cursor');
      const hoverElements = document.querySelectorAll('a, button, .card, .tech-badge');

      hoverElements.forEach((el) => {
        el.addEventListener('mouseenter', () => cursor?.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor?.classList.remove('hover'));
      });
    });

    document.addEventListener('mouseleave', () => {
      const cursor = document.getElementById('custom-cursor');
      const dot = document.getElementById('custom-cursor-dot');
      if (cursor) cursor.style.opacity = '0';
      if (dot) dot.style.opacity = '0';
    });

    document.addEventListener('mouseenter', () => {
      const cursor = document.getElementById('custom-cursor');
      const dot = document.getElementById('custom-cursor-dot');
      if (cursor) cursor.style.opacity = '1';
      if (dot) dot.style.opacity = '1';
    });
  }
</script>
