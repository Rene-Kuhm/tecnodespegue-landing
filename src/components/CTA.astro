---
/**
 * CTA.astro - Versión Marvel
 * Headline gigante con underline cinemático dorado,
 * formulario con border bevel, trust signals como chips Marvel
 */

import ContactForm from './ContactForm.astro';
import Icon from './Icon.astro';
import GlowOrbs from './GlowOrbs.astro';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'es';
const copy = {
  es: {
    kicker: 'CONTACTO · FINAL',
    title: ['¿Listo para', 'despegar?'],
    lead: 'Contanos qué proceso manual o sistema fragmentado está frenando a tu equipo. En una consulta técnica evaluamos si conviene automatizar, integrar o construir software interno.',
    primary: 'Agendá tu Consulta Gratis',
    whatsapp: 'WhatsApp Directo',
    trust: ['Respuesta personal', 'Consulta Sin Costo', 'NDA Disponible'],
  },
  en: {
    kicker: 'CONTACT · FINAL',
    title: ['Ready to', 'launch?'],
    lead: 'Tell us which manual process or fragmented system is slowing your team down. In a technical consultation, we assess whether to automate, integrate, or build internal software.',
    primary: 'Book a Free Consultation',
    whatsapp: 'Direct WhatsApp',
    trust: ['Personal response', 'Free Consultation', 'NDA Available'],
  },
}[locale];
---

<section class="cta-section py-32 relative overflow-hidden" id="contacto" data-cta>
  <!-- Glow orbs (atmospheric depth) -->
  <GlowOrbs intensity={0.8} />
  <!-- Background decorativo -->
  <div class="cta-bg" aria-hidden="true">
    <div class="cta-glow cta-glow-1"></div>
    <div class="cta-glow cta-glow-2"></div>
    <div class="cta-grid" aria-hidden="true"></div>
    <div class="cta-vignette" aria-hidden="true"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 md:px-8 relative z-10">

    <header class="cta-header">
      <div class="cta-header-text">
        <span class="kicker">
          <span class="kicker-dot"></span>
          <span class="kicker-text font-mono">{copy.kicker}</span>
        </span>
        <h2 class="cta-title font-display">
          <span class="cta-title-line">{copy.title[0]}</span>
          <span class="cta-title-line cta-title-accent">
            <span class="cta-underline-wrap">
              <span class="cta-underline-text">{copy.title[1]}</span>
              <span class="cta-underline-bar" aria-hidden="true"></span>
            </span>
          </span>
        </h2>
        <p class="cta-lead">
          {copy.lead}
        </p>
      </div>

    </header>

    <!-- Botones principales -->
    <div class="cta-buttons">
      <a href="#form" class="btn-primary cta-btn cta-btn-primary" data-magnetic data-tiktok-event="ClickButton" data-tiktok-label="Agendar consulta gratis">
        <Icon name="calendar_month" class="w-4 h-4" />
        <span>{copy.primary}</span>
      </a>
      <a href="https://wa.me/5492334409838?text=Hola,%20quiero%20consultar%20sobre%20un%20proyecto%20de%20desarrollo" target="_blank" rel="noopener noreferrer" class="btn-secondary cta-btn" data-magnetic data-tiktok-event="Contact" data-tiktok-label="WhatsApp directo" data-whatsapp-analytics data-locale={locale}>
        <Icon name="chat" class="w-4 h-4" />
        <span>{copy.whatsapp}</span>
      </a>
    </div>

    <!-- Form -->
    <div id="form" class="cta-form-wrap">
      <ContactForm locale={locale} />
    </div>

    <!-- Trust signals -->
    <div class="cta-trust">
      <div class="cta-trust-item">
        <Icon name="verified" class="w-4 h-4" />
        <span>{copy.trust[0]}</span>
      </div>
      <div class="cta-trust-divider" aria-hidden="true"></div>
      <div class="cta-trust-item">
        <Icon name="code" class="w-4 h-4" />
        <span>{copy.trust[1]}</span>
      </div>
      <div class="cta-trust-divider" aria-hidden="true"></div>
      <div class="cta-trust-item">
        <Icon name="support_agent" class="w-4 h-4" />
        <span>{copy.trust[2]}</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-whatsapp-analytics]').forEach((link) => {
    link.addEventListener('click', () => {
      window.plausible?.('WhatsApp Click', { props: {
        locale: link.dataset.locale || 'unknown',
        placement: 'contact',
      }});
    });
  });
</script>

<style>
  .cta-section {
    background: linear-gradient(180deg, transparent 0%, rgba(237, 29, 36, 0.04) 100%);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }
  .cta-glow-1 {
    width: 500px;
    height: 500px;
    background: var(--color-marvel-red);
    top: 10%;
    left: 10%;
  }
  .cta-glow-2 {
    width: 400px;
    height: 400px;
    background: var(--color-marvel-gold);
    bottom: 10%;
    right: 10%;
    opacity: 0.25;
  }

  .cta-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(248, 180, 0, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248, 180, 0, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
  }

  .cta-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(0, 0, 0, 0.6) 100%);
  }

  /* Header */
  .cta-header {
    text-align: center;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-marvel-red);
    box-shadow: 0 0 12px var(--color-marvel-red-glow);
    animation: energy-pulse 2s ease-in-out infinite;
  }
  .kicker-text {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-marvel-gold);
  }

  .cta-title {
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }
  .cta-title-line { display: block; }
  .cta-title-accent { font-style: italic; }

  /* Underline cinemático */
  .cta-underline-wrap { position: relative; display: inline-block; }
  .cta-underline-text { position: relative; z-index: 2; }
  .cta-underline-bar {
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    bottom: 0.05em;
    height: 0.18em;
    background: linear-gradient(90deg, var(--color-marvel-red) 0%, var(--color-marvel-gold) 100%);
    transform-origin: left center;
    z-index: 1;
    box-shadow: 0 0 32px rgba(237, 29, 36, 0.4);
  }

  .cta-lead {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
  .cta-strong { color: #FFFFFF; font-weight: 700; }

  /* Buttons */
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .cta-btn { font-size: 0.9rem; }

  /* Form wrap */
  .cta-form-wrap { position: relative; }

  /* Trust signals */
  .cta-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cta-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }
  .cta-trust-item :global(svg) { color: var(--color-marvel-gold); }

  .cta-trust-divider {
    width: 4px;
    height: 4px;
    background: var(--color-marvel-gold);
    border-radius: 50%;
    opacity: 0.5;
  }
</style>
